################################################################################
# test_west_neutrals: EIRENE-style D2 neutral-transport batch on WEST axi.
#
# Mode A (EIRENE semantics) via `fix chem/adas ... mode neutral`:
#   - Puff a fixed batch of D2 from the inner-lower divertor source surface
#     (S3X-EIRENE location: R=2.189 m, Z=-0.693 m, wall.surf id=405).
#   - Track the D/D2 neutrals through volumetric ionization, charge exchange,
#     and dissociation until consumed; IONIZED PARTICLES ARE DELETED rather
#     than re-labelled to D+ -- so no kinetic D+ ever exist, Boris never runs,
#     and the sheath/E-field pusher is out of the picture entirely.
#   - Surface recycling (D+ -> D_FC, D -> D_thermal) re-emits neutrals that
#     hit the vessel or divertor, mirroring EIRENE's wall model.
#   - `stop_on_exhaust yes` ends the run when the D+D2 population reaches 0.
#
# Plasma: SOLEDGE3X 3 MW (same file used by the S3XE/WEST_MULTISPEC reference
# case). Plasma is frozen per call (static yes), consistent with EIRENE being
# called once by the fluid solver with a fixed (Te, ne, Ti, vpar) map.
#
# Purpose: OpenEdge equivalent of the S3X-EIRENE vacuum-cleaner benchmark,
# suitable for direct comparison of ionization / CX / dissociation source
# maps (dump columns f_fchem[*]) and per-species moments (f_fmom[*]) that
# are the EIRENE -> Gkeyll/SOLPS coupling handoff.
################################################################################

seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort no
global              fnum 1e12

# WEST R-Z domain
create_box          1.82 3.2 -1.0 1.0 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

# ---- Species ----
# D+ is still declared because surf_react recycle references it as a possible
# incoming species (D+ -> D, Franck-Condon). In Mode A no kinetic D+ is ever
# created volumetrically -- the species slot is effectively unused at runtime.
species             input/neutral.species D2 D D+
mixture             neutrals D2  frac 1.0
mixture             neutrals D   frac 0.0
mixture             neutrals D+  frac 0.0

# Puff mixture for fix emit/surf/puff -- pure D2 @ 300 K (vessel wall temp).
mixture             puff_mix D2  frac 1.0 nrho 1e18 temp 300.0

# ---- Surfaces (WEST vessel + core) ----
read_surf           input/wall.surf group wall particle check
surf_collide        wallColl diffuse 500.0 1.0
surf_react          wallRecycle recycle input/wall.recycle
surf_modify         wall collide wallColl react wallRecycle

# Puff surface = single wall element (id=405). Matches the S3X-EIRENE source
# location (tri 22252 side 2 in the SOLEDGE3X mesh, R=2.189, Z=-0.693).
group               gpuff surf id == 405

read_surf           input/core.surf invert group core particle check
surf_collide        coreColl vanish
surf_modify         core collide coreColl react none

# Static refinement near wall regions (strike points & limiter)
region              rdiv_lo block 1.82 3.2 -0.94 -0.40 -INF INF
region              rdiv_up block 1.82 3.2  0.40  0.80 -INF INF
adapt_grid          all refine surf all 0.001 maxlevel 3 cells 2 2 1 region rdiv_lo all iterate 3
adapt_grid          all refine surf all 0.001 maxlevel 3 cells 2 2 1 region rdiv_up all iterate 3
balance_grid        rcb cell

# ---- Plasma background (WEST SOLEDGE3X 3 MW) ----
fix                 pd plasma/data file input/plasma.h5 static yes

# Activate per-particle plasma cache via fix plasma/data. Needed by
# fix chem/adas to read Te/ne per particle. In Mode A there is no Boris
# or sheath consumer of B, but the pcache (commit 7541f66) skips writes
# for fields no consumer requests, so the B / Ex-z / grad slots are
# automatically elided -- only Te/Ne (and Ti/vpar for CX resampling) are
# actually populated. Negligible extra cost.
global              bfield_compute pd

# ---- Chemistry: Mode A (EIRENE) ----
# `mode neutral`        : IONIZATION deletes the neutral (no kinetic D+ spawn).
# `source_species D D2` : population to monitor for stop_on_exhaust.
# `stop_on_exhaust yes` : halt the run when all D and D2 have been consumed.
# `units batch_fix F R` : per-cell tally is weighted to absolute physical SI
#                         rates; N_batch is READ from the emit fix's own
#                         cumulative-emit counter each chem step, so even if
#                         stop_at_np on the puff fix over/undershoots by a
#                         few particles, the scaling stays exact. Each event
#                         contributes w / vol[i] = (R/N) / vol[i] to the
#                         per-cell source rate, giving:
#                           cols 1-4   -> particle source [m^-3 s^-1]
#                           cols 5-8   -> momentum x      [kg m^-2 s^-2]
#                           cols 9-16  -> momentum y, z   [kg m^-2 s^-2]
#                           cols 17-20 -> energy source   [W/m^3]
# R_puff = 4.84e20 atoms/s is the S3X-EIRENE WEST_MULTISPEC source rate.
# dump[f_fchem[1..20]] is then directly the S3X-EIRENE-style per-cell source
# map that SOLEDGE3X consumes each coupling iteration.
fix fchem chem/adas 1 1 input/neutral.reactions adas_dir ../../database/adas &
    mode neutral source_species D D2 &
    stop_on_exhaust yes exhaust_threshold 5000 &
    units batch_fix fpuff 4.84e20

# ---- D2 puff at S3XE location ----
# Ramp: n=200 particles/step until Np >= 100k. Latches after first trip --
# once silenced, the fix never re-emits even if Np decays later. Total
# physical puff rate seen during ramp is n * fnum / dt = 2e21 atoms/s,
# which is in the right order of magnitude vs S3XE (4.84e20 atoms/s) and
# can be tuned via `n`.
fix fpuff emit/surf/puff puff_mix gpuff n 200 normal yes perspecies no &
    stop_at_np 100000

# ---- Diagnostics ----
# Per-species number densities (D2, D, D+). D+ column will stay 0 in Mode A.
compute cden grid all species nrho
fix    fden ave/grid all 1 100 1000 c_cden[*] ave one

# Per-surface hit counters on the core. `surf_collide coreColl vanish` is a
# silent absorber (not counted in Surf reactions), so this is how we tell
# whether neutrals are actually leaking to the core vs ionizing before they
# get there. Prints cumulative per-surf hit counts in the dump.
compute ccore surf core neutrals n ke
fix    fcore ave/surf all 1 100 1000 c_ccore[*] ave one

# Live scalar sum of core vanishes for stats (cumulative over the core group).
compute ccore_n_tot reduce sum c_ccore[1]

# Per-species moments of f_n (Gkeyll/SOLPS coupling handoff).
# Columns per species: n [m^-3], u [m/s], v [m/s], w [m/s], T [K].
# Three species (D2, D, D+) => 15 columns total; D+ moments are zero in Mode A.
compute cmom grid all species nrho u v w temp
fix    fmom ave/grid all 1 100 1000 c_cmom[*] ave one

# ---- Load balance for the puff cluster (must come AFTER all fix ave/grid) ----
# Runtime adaptive refinement + particle-count rebalancing follows the
# test_west_axi recipe (commit 55b8830): keeps the emitter and its dense
# cluster well-partitioned so no single rank hogs the work. `rcb part` is
# better than `rcb time` for point-source cases because the work is tightly
# tied to particle count rather than per-particle CPU cost.
fix fadapt adapt 200 all refine particle 500 0 maxlevel 5 cells 2 2 1
fix fbal   balance 100 1.05 rcb part

timestep            1e-07
stats               10
stats_style         step cpu np c_ccore_n_tot

# ---- Dump layout for output/grid.west ----
#   cols 1-3    : id xc yc
#   cols 4-6    : f_fden[*]  = D2, D, D+ number densities [m^-3]
#   cols 7-26   : f_fchem[*] = 20-col source RATE tally (EIRENE-style,
#                               `units batch`): 4 reactions x 5 quantities:
#                  7-10    particle source (ion, rec, CX, dis)     [m^-3 s^-1]
#                  11-14   momentum source x                       [kg m^-2 s^-2]
#                  15-18   momentum source y                       [kg m^-2 s^-2]
#                  19-22   momentum source z                       [kg m^-2 s^-2]
#                  23-26   energy source                           [W/m^3]
#   col  27     : vol                                              [m^3]  (axisym: 2*pi*R*dA)
#   cols 28-42  : f_fmom[*] = per-species {n, u, v, w, T} x {D2, D, D+}  (15 cols)
dump    dgrid grid all 1000 output/grid.west id xc yc f_fden[*] f_fchem[*] vol f_fmom[*]
dump_modify dgrid first yes

# Single-phase run: puff ramps up, latches at 100k, then the batch ionizes /
# recycles / leaks away until stop_on_exhaust fires. Safety cap is set high
# enough that the run really drains (previous 50k-step cap left ~320 alive).
# Total-run Np-integrated is what normalizes the per-cell rate tally for the
# Gkeyll handoff, so it's important to fully drain before reading results.
run                 300000

#EOF
