################################################################################
# test_west_neutrals: D/D2/D+ neutral transport on real WEST axi geometry
# Plasma: SOLEDGE3X 3 MW (same file used by S3XE/WEST_MULTISPEC reference)
# Purpose: OpenEdge equivalent of the S3X-EIRENE vacuum-cleaner benchmark
################################################################################

seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort no
global              fnum 1e12

# WEST R-Z domain
create_box          1.82 3.2 -1.0 1.0 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

# ---- Species ----
species             input/neutral.species D2 D D+
mixture             neutrals D2  frac 1.0
mixture             neutrals D   frac 0.0
mixture             neutrals D+  frac 0.0

# ---- Surfaces (WEST vessel + core) ----
read_surf           input/wall.surf group wall particle check
surf_collide        wallColl diffuse 500.0 1.0
surf_react          wallRecycle recycle input/wall.recycle
surf_modify         wall collide wallColl react wallRecycle

read_surf           input/core.surf invert group core particle check
surf_collide        coreColl vanish
surf_modify         core collide coreColl react none

# Static refinement near wall regions (strike points & limiter)
region              rdiv_lo block 1.82 3.2 -0.94 -0.40 -INF INF
region              rdiv_up block 1.82 3.2  0.40  0.80 -INF INF
adapt_grid          all refine surf all 0.001 maxlevel 3 cells 2 2 1 region rdiv_lo all iterate 3
adapt_grid          all refine surf all 0.001 maxlevel 3 cells 2 2 1 region rdiv_up all iterate 3
balance_grid        rcb cell

# ---- Plasma background (WEST SOLEDGE3X 3 MW) ----
fix                 pd plasma/data file input/plasma.h5 static yes

# B-field from per-particle plasma cache
global              bfield_compute pd

# ---- Boris pusher for D+ ions ----
global              boris_subcycles 5

# ---- Chemistry: ionization + recombination + CX + D2 dissociation ----
# Uses per-particle plasma cache (Te/ne/Ti/vpar) from fix plasma/data
fix fchem chem/adas 1 1 input/neutral.reactions adas_dir ../../database/adas

# ---- Initial particles: D2 puff at S3XE/WEST_MULTISPEC source location ----
# S3X-EIRENE puff: triangle 22252, side 2 -> R = 2.1887 m, Z = -0.6925 m
# (inner lower divertor, corresponds to wall.surf segment 405).
# Seed 10,000 D2 in a small region just above that wall segment (inside vessel).
global              nrho 1e18 temp 300
region              puff_s3x block 2.16 2.22 -0.68 -0.64 -INF INF
create_particles    neutrals n 10000 region puff_s3x

# ---- Diagnostics ----
# Per-species number density (legacy):
compute cden grid all species nrho
fix    fden ave/grid all 1 100 1000 c_cden[*] ave running

# Per-species MOMENTS of f_n (Gkeyll coupling handoff).
# Columns per species: n [m^-3], u [m/s], v [m/s], w [m/s], T [K].
# Three species (D2, D, D+) => 15 columns total.  (D+ moments included
# even though Gkeyll would consume only the neutral species; useful for
# diagnostic.)
compute cmom grid all species n u v w temp
fix    fmom ave/grid all 1 100 1000 c_cmom[*] ave running

timestep            1e-07
stats               500
stats_style         step cpu np

# Phase A: warmup run (let particles transport & reactions equilibrate)
run                 2000

# Phase B: production + dump grid fields.
# Dump layout:
#   cols 1-3:   id xc yc
#   cols 4-6:   f_fden[*]   = D2, D, D+ number densities (3 cols)
#   cols 7-26:  f_fchem[*]  = 20-col source tally:
#                 7-10   counts (ion, rec, CX, dis)
#                 11-14  sum(m*vx) per reaction  [kg m/s]
#                 15-18  sum(m*vy)
#                 19-22  sum(m*vz)
#                 23-26  sum(0.5 m |v|^2)         [J]
#   cols 27-41: f_fmom[*]   = per-species moments {n, u, v, w, T}
#                 5 quantities x 3 species = 15 cols
#                 27-29 n(D2), n(D), n(D+)
#                 30-32 u(D2), u(D), u(D+)     ... and so on
dump    dgrid grid all 1000 output/grid.west id xc yc f_fden[*] f_fchem[*] f_fmom[*]
dump_modify dgrid first yes
run                 5000

#EOF
