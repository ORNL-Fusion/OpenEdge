################################################################################
# CPC Benchmark: Impurity transport with PMI surface reactions
#
# Reproduces the published benchmark case (Younkin et al., CPC 264, 2021):
#   - D plasma:  Ti = Te = 20 eV, ni = ne = 1e19 m^-3
#   - B field:   2 T in x-direction
#   - Geometry:  angled W plane at 30 deg + bounding walls (1280 triangles)
#   - Surface:   W material, R = 0.5, Y = 0.1, Ebind = 11.75 eV
#   - Source:    nP = 10000 W neutrals at (0,0,10um), 6 eV in x + 6 eV in z
#   - Sheath:    Borodkina spatial model (Chodura + Debye)
#   - Ionization: electron-impact via ADAS rates for W (Z=74)
#   - Collisions: Nanbu Coulomb with D+ background
#   - Background: parallel flow -2000 m/s
#   - Diagnostic: PMI impact CSV log, gross deposition, particle tracks
#
# Analytic particle balance (steady-state, infinite reflections):
#   grossDeposition = nP * (1 - R) / (1 - (Y + R))
#                   = 10000 * 0.5 / (1 - 0.6) = 12500
################################################################################

# ---- Physical parameters ----
variable        Te      equal 20.0              # electron temperature [eV]
variable        Ti      equal 20.0              # ion temperature [eV]
variable        Tkelvin equal ${Te}*11605.0     # temperature [K]
variable        ne      equal 1.0e19            # electron density [m^-3]
variable        ni      equal 1.0e19            # ion density [m^-3]
variable        Bx      equal 2.0               # magnetic field [T]
variable        Ebind   equal 11.75             # W surface binding energy [eV]
variable        RN      equal 0.5               # reflection coefficient
variable        RE      equal 0.8               # energy reflection fraction
variable        Y       equal 0.1               # sputtering yield
variable        nP      equal 10000             # number of source particles
variable        nEmit   equal ${nP}             # emitted particles per insertion step
variable        Vpar    equal -2000.0           # background parallel flow [m/s]
variable        fnumSrc equal 1.0               # real/sim particle ratio for source
variable        srcx    equal 0.0               # surface-emission region center x [m]
variable        srcy    equal 0.0               # surface-emission region center y [m]
variable        srcz    equal 0.0               # surface-emission region center z [m]
variable        srcR    equal 3.0e-3            # surface-emission region radius [m]

# ---- Simulation setup ----
seed                    12345
dimension               3
units                   si

# Boundary: reflective (geometry is watertight, particles stay inside)
boundary                o o o 
global                  gridcut 0.0 comm/sort yes
global                  fnum ${fnumSrc}

# Domain must enclose the GITR geometry
# Bounding box: X [-0.015, 0.015], Y [-0.015, 0.015], Z [-0.0087, 0.03]
# Add small margin
create_box              -0.016 0.016 -0.016 0.016 -0.01 0.031
#create_grid             10 10 14
create_grid             20 20 28

balance_grid            rcb cell

# ---- Species and mixtures ----
species                 plasma.species W W+ W2+ W3+ W4+ W5+ W6+
mixture                 allW W W+ W2+ W3+ W4+ W5+ W6+
mixture                 allW W    frac 1.0
mixture                 allW W+   frac 0.0
mixture                 allW W2+  frac 0.0
mixture                 allW W3+  frac 0.0
mixture                 allW W4+  frac 0.0
mixture                 allW W5+  frac 0.0
mixture                 allW W6+  frac 0.0
#mixture                 allW vstream 2508.4899 0.0 2508.4899 temp 0.0

# ---- Surface geometry ----
# Converted from GITR point-plane 3D format -> ASCII STL -> SPARTA surf
read_surf               input/gitr_geometry.surf invert

# ---- Surface collision + PMI reaction ----
# Diffuse wall at room temperature (velreset=1 from PMI overrides translational)
surf_collide            diffW diffuse ${Tkelvin} 1.0

# PMI surface reaction: constant mode with CPC benchmark values
surf_react              pmiW pmi constant reactions_pmi.surf ${RN} ${RE} ${Y} ${Ebind} &
                        log yes file output/pmi_impacts.csv
                    

            
# Apply collision model and reaction to all surfaces
surf_modify             all collide diffW react pmiW

# Localized source patch on the surface near (srcx,srcy,srcz)
region                  src_emit sphere ${srcx} ${srcy} ${srcz} ${srcR}
group                   src_emit surf region src_emit one

# ---- Plasma fields (constant, uniform) ----
compute                 cplasma plasma/fields all constant &
                        magnetic_field ${Bx} 0.0 0.0 &
                        electric_field 0 0 0 &
                        temp_e ${Te} temp_i ${Ti} &
                        dens_e ${ne} dens_i ${ni} &
                        parrflow ${Vpar} &
                        bx by bz ex ey ez temp_e temp_i dens_i dens_e parrflow

# ---- Magnetic field (uniform 2 T in x) ----
fix                     bfield bfield/grid c_cplasma[1] c_cplasma[2] c_cplasma[3]
global                  bfield grid bfield 0

# ---- Electric field (background = 0, sheath adds per-particle) ----
#fix                     efield efield/grid c_cplasma[4] c_cplasma[5] c_cplasma[6]
#global                  efield grid efield 0

# ---- Spatial sheath (Borodkina default) ----
# Chodura + Debye profile, D+ background sets sheath scales
compute                 cgeom sheath/geometry/grid all all dist nx ny nz surfidx
global                  sheath geom_compute cgeom plasma_compute cplasma &
                        mD_amu 2.0 kick no

# ---- Boris pusher ----
# Subcycles for sheath resolution; per-subcycle surface guard prevents leakage
global                  boris_subcycles 10

# ---- Nanbu Coulomb collisions with D+ background ----
# Background: D+ (A=2.014, Z=1)
# Sources: Ti=col8, Ni=col9, Vpar=col11, Bx=col1, By=col2, Bz=col3
fix                     nanbu coll/nanbu 1 plasma c_cplasma[7] c_cplasma[10] &
                        background 2.014 1.0 &
                        c_cplasma[8] c_cplasma[9] c_cplasma[11] &
                        c_cplasma[1] c_cplasma[2] c_cplasma[3]

# ---- Ionization / Recombination (ADAS) ----
fix                     chem chem/adas 1 74 plasma.adas adas_dir ../../database/adas

# ---- Load initial particle source ----
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
read_particles particles.dat 0
# ---- Diagnostics ----
shell                   mkdir -p output

# Surface reaction tallies (gross erosion/deposition)
compute                 creact react/surf all pmiW
fix                     fsurf ave/surf all 1 100 1000 c_creact[*]
dump                    dsurf surf all 1000 output/surf_react.dat id f_fsurf[*]

# Per-mixture/all-species incident flux and moments (for areal-density postproc)
compute                 2b surf all all nflux_incident mflux etot press ke shx shy shz px py pz
fix                     f_all ave/surf all 1 100 100 c_2b[*] ave running
dump                    d_all surf all 1000 output/tmp.all.surf.cpc id v1x v1y v1z v2x v2y v2z v3x v3y v3z area f_f_all[*]
dump_modify             d_all first yes

# Particle state dump for tracks
#dump                    dpart particle all 10 output/particles id type x y z vx vy vz
#dump_modify             dpart first yes

# Grid density
compute                 cgrid grid all allW nrho
fix                     fgrid ave/grid all 1 100 1000 c_cgrid[*] ave running
dump                    dgrid grid all 1000 output/grid_density id xc yc zc f_fgrid[*]

# ---- Time integration ----
timestep                1.0e-10
stats                   100
stats_style             step cpu np


# dt=1e-10 s, total 1e7 steps = 1 ms physical time
run                     9999999
