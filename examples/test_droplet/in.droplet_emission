# Droplet emission + transport case
# mode 1: gravity + evaporation + drag (coulomb) + OML charging + E-field

variable mode index 1

variable dt    equal 1e-05
variable time  equal 10
variable N     equal floor(${time}/${dt})
variable Ndump equal floor($N/1000)

variable temp_droplet equal 773.15
variable temp_emit    equal 1e19
variable nemit        equal 1000
variable droplet_inner index InstabilityInner
variable droplet_outer index InstabilityOuter
variable md   equal 3.495021827118645e-05
variable Rho  equal 534.0
variable rd   equal (3.0*${md}/(4.0*PI*${Rho}))^(1.0/3.0)

variable temp_emit    equal 1e19
variable nemit        equal 1000
seed                12345
global              temp ${temp_emit}

timestep            ${dt}
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no

create_box          2.0 6.0 -4.0 3.8 -0.05 0.05
create_grid         500 500 1
balance_grid        rcb cell

global fnum 0.0000001

species             droplet.species I O
mixture             LigamentSourceInner I frac 1.0 nrho 1
mixture             LigamentSourceOuter O frac 1.0 nrho 1
variable            pmass particle mass

read_surf           wall.surf group surfID particle check
surf_collide scx vanish log yes file collide_vanish_hits.csv
surf_modify  surfID collide scx react none

group               divertor_outer surf id <> 139 150
group               divertor_inner surf id <> 111 115

# thermal emission from global temp (no magVelocity/incidentAngle → cosine-law Maxwellian)
fix                 droplet_emission_outer emit/surf LigamentSourceOuter divertor_outer n ${nemit} perspecies no
fix                 droplet_emission_inner emit/surf LigamentSourceInner divertor_inner n ${nemit} perspecies no

read_surf           core.surf invert group surfID2 particle check
surf_modify         surfID2 collide scx react none

# particle trajectory dump
dump dtraj1 particle LigamentSourceOuter ${Ndump} case.outer id type x y z vx vy vz v_pmass temp radius
dump dtraj2 particle LigamentSourceInner ${Ndump} case.inner id type x y z vx vy vz v_pmass temp radius

dump dtraj23 particle all 1 case.all id type x y z vx vy vz

# plasma fields
compute cnear plasma/fields all file ../test_evaporation/input/plasma.h5 &
    ../test_evaporation/input/bfield.h5 &
    bx by bz temp_e dens_e temp_i dens_i parrflow er et ez

# evaporation
fix fevap_I evaporation 1 LigamentSourceInner mass ${md} radius ${rd} temp ${temp_droplet} &
    heatflux/file ../test_evaporation/input/heatflux.fix.h5
fix fevap_O evaporation 1 LigamentSourceOuter mass ${md} radius ${rd} temp ${temp_droplet} &
    heatflux/file ../test_evaporation/input/heatflux.fix.h5

# --- Per-cell Li mass loss (for SOLPS coupling) ---
# f_fevap_I[1] = dm_kg  (kg/cell/step, inner droplets, sum over both half-kicks)
# f_fevap_I[2] = dn_atoms (atoms/cell/step, inner droplets)
# ave/grid: Nevery=1, Nrepeat=Ndump, Nfreq=Ndump → time-mean over one dump interval.
#fix fml_I ave/grid all 1 ${Ndump} ${Ndump} f_fevap_I[1] f_fevap_I[2]
#fix fml_O ave/grid all 1 ${Ndump} ${Ndump} f_fevap_O[1] f_fevap_O[2]

# Dump grid: id xc yc + mean dm_kg and dn_atoms for inner + outer
# Post-processing: source_rate [atoms/m³/s] = f_fml_I[2] / (dt * cell_vol)
#dump d_ml grid all ${Ndump} mass_loss.txt id xc yc &
#    f_fml_I[1] f_fml_I[2] f_fml_O[1] f_fml_O[2]

# coulomb-enhanced drag + gravity
# c_cnear columns: [1]=Bx [2]=By [3]=Bz [4]=Te [5]=Ne [6]=Ti [7]=Ni [8]=Vpar [9]=Er [10]=Et [11]=Ez
#fix fdrag drag 1 2.0 1 &
#    plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] &
#    bfield c_cnear[1] c_cnear[3] c_cnear[2] &
#    gravity 0 -9.8 0 &
#    model coulomb coulomb/chi 0.2 coulomb/delta 1.0 coulomb/lnlambda 20.0 &
 #   mass ${md} radius ${rd} temp ${temp_droplet}

# Drag + gravity + cylindrical geometric terms (DUSTT-style axisymmetric)
# 'cylindrical yes' adds centrifugal (v_φ²/R) and angular-momentum (-v_φ*v_R/R)
# half-kicks so toroidal drag translates to real outward radial force.
fix fdrag drag 1 2.0 1 &
    plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] &
    bfield c_cnear[1] c_cnear[3] c_cnear[2] &
    gravity 0 -9.8 0 &
    model epstein &
    mass ${md} radius ${rd} temp ${temp_droplet} &
    cylindrical yes
    
# OML charging
fix fcharge droplet/charge 1 plasma &
    temp_e c_cnear[4] temp_i c_cnear[6] &
    dens_e c_cnear[5] dens_i c_cnear[7] &
    radius ${rd} mass ${md} temp ${temp_droplet} &
    ion_mass_amu 2.0 thermionic no

# plasma electric field
fix    eS efield/grid c_cnear[9] c_cnear[10] c_cnear[11]
global efield grid eS 0
global boris_subcycles 5

# ---- Surf hit count --------------------------------------------------------
# Use explicit mixture IDs (LigamentSourceInner / LigamentSourceOuter) rather

# fix ave/surf: Nevery=1, Nrepeat=10, Nfreq=Ndump, ave running
#   → sampled every step; "ave running" gives cumulative mean over all steps.
#   → value at step T = (total hits from step 1..T) / T  (a running average).
#   → values are fractional; to recover integer hit totals:
#        total_hits = last_block_value × last_block_timestep
#   → post-processing (matrix.py): reads the last block and multiplies by T.

# ---- Robust per-surface hit counts (works for sticking reactions) ---------
# c_hit_* = per-surf counts each step; ave/surf running outputs cumulative mean.
# Total hits at final timestep T are recovered as: value(T) * T.
compute c_hit_I surf all LigamentSourceInner n
compute c_hit_O surf all LigamentSourceOuter n
# sample every step (Nfreq=1), keep cumulative running mean
fix f_hit_I ave/surf all 1 1 1 c_c_hit_I[1] ave running
fix f_hit_O ave/surf all 1 1 1 c_c_hit_O[1] ave running
dump d_hit surf all ${Ndump} tmp.all.surf id f_f_hit_I f_f_hit_O




# ---------------------------------------------------------------------------


stats 1
run 1

unfix droplet_emission_outer
unfix droplet_emission_inner
#undump dtraj1
#undump dtraj2
undump dtraj23

variable npart equal np
variable Nd equal ${Ndump}*2
fix 31 halt ${Nd} v_npart <= 0

stats 100
run $N
