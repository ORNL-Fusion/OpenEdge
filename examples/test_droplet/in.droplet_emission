# Droplet emission + transport case
# Physics: gravity + evaporation + drag (epstein) + OML charging + E-field

variable dt    equal 1e-05
variable time  equal 10
variable N     equal floor(${time}/${dt})
variable Ndump equal 100

variable temp_droplet equal 773.15
variable temp_emit    equal 1.e20
variable nemit        equal 3

# --- droplet sizes (rho fixed) ---
variable Rho    equal 534.0

# Radii [m]
variable rd1    equal 1.5e-3
variable rd2    equal 2.5e-3
variable rd3    equal 3.5e-3

# Masses from rho: md = 4/3*pi*rho*r^3
variable md1    equal (4.0/3.0)*PI*${Rho}*${rd1}*${rd1}*${rd1}
variable md2    equal (4.0/3.0)*PI*${Rho}*${rd2}*${rd2}*${rd2}
variable md3    equal (4.0/3.0)*PI*${Rho}*${rd3}*${rd3}*${rd3}

seed                12345
timestep            ${dt}
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
global              temp ${temp_emit}
create_box          2.0 6.0 -4.0 3.8 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

global fnum 0.0000001

species droplet.species drop_1 drop_2 drop_3
mixture LigamentOuter_1 drop_1 frac 1.0 nrho 1
mixture LigamentOuter_2 drop_2 frac 1.0 nrho 1
mixture LigamentOuter_3 drop_3 frac 1.0 nrho 1

variable            pmass particle mass

read_surf           wall.surf group surfID particle check
surf_collide        wallColModel  diffuse ${temp_droplet} 1.0
surf_react          wallReact global 1. .0
surf_modify         surfID collide wallColModel react wallReact

group               divertor_outer surf id <> 139 150

read_particles source 1

read_surf           core.surf invert group surfID2 particle check
surf_modify         surfID2 collide wallColModel react wallReact

# particle trajectory dump
dump dtraj_drop1 particle all 1 case.outer id type x y z vx vy vz v_pmass temp radius

# plasma fields
compute cnear plasma/fields all file ../test_evaporation/input/plasma.h5 &
    ../test_evaporation/input/bfield.h5 &
    bx by bz temp_e dens_e temp_i dens_i parrflow er et ez

# evaporation
fix fevap_1 evaporation 1 LigamentOuter_1 mass ${md1} radius ${rd1} temp ${temp_droplet} &
    heatflux/file ../test_evaporation/input/heatflux.fix.h5
fix fevap_2 evaporation 1 LigamentOuter_2 mass ${md2} radius ${rd2} temp ${temp_droplet} &
    heatflux/file ../test_evaporation/input/heatflux.fix.h5
fix fevap_3 evaporation 1 LigamentOuter_3 mass ${md3} radius ${rd3} temp ${temp_droplet} &
    heatflux/file ../test_evaporation/input/heatflux.fix.h5

# drag + gravity + cylindrical geometric terms
fix fdrag1 drag 1 2.0 1 &
    plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] &
    bfield c_cnear[1] c_cnear[3] c_cnear[2] &
    gravity 0 -9.8 0 &
    model epstein &
    mass ${md1} radius ${rd1} temp ${temp_droplet} &
    cylindrical yes
fix fdrag2 drag 1 2.0 1 &
    plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] &
    bfield c_cnear[1] c_cnear[3] c_cnear[2] &
    gravity 0 -9.8 0 &
    model epstein &
    mass ${md2} radius ${rd2} temp ${temp_droplet} &
    cylindrical yes
fix fdrag3 drag 1 2.0 1 &
    plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] &
    bfield c_cnear[1] c_cnear[3] c_cnear[2] &
    gravity 0 -9.8 0 &
    model epstein &
    mass ${md3} radius ${rd3} temp ${temp_droplet} &
    cylindrical yes

# OML charging
fix fcharge1 droplet/charge 1 plasma &
    temp_e c_cnear[4] temp_i c_cnear[6] &
    dens_e c_cnear[5] dens_i c_cnear[7] &
    radius ${rd1} mass ${md1} temp ${temp_droplet} &
    ion_mass_amu 2.0 thermionic no
fix fcharge2 droplet/charge 1 plasma &
    temp_e c_cnear[4] temp_i c_cnear[6] &
    dens_e c_cnear[5] dens_i c_cnear[7] &
    radius ${rd2} mass ${md2} temp ${temp_droplet} &
    ion_mass_amu 2.0 thermionic no
fix fcharge3 droplet/charge 1 plasma &
    temp_e c_cnear[4] temp_i c_cnear[6] &
    dens_e c_cnear[5] dens_i c_cnear[7] &
    radius ${rd3} mass ${md3} temp ${temp_droplet} &
    ion_mass_amu 2.0 thermionic no

# plasma electric field
fix    eS efield/grid c_cnear[9] c_cnear[10] c_cnear[11]
global efield grid eS 0
global boris_subcycles 5

# per-cell mass loss tracking
fix fml_1 ave/grid all 1 ${Ndump} ${Ndump} f_fevap_1[1] f_fevap_1[2]
fix fml_2 ave/grid all 1 ${Ndump} ${Ndump} f_fevap_2[1] f_fevap_2[2]
fix fml_3 ave/grid all 1 ${Ndump} ${Ndump} f_fevap_3[1] f_fevap_3[2]

dump d_ml grid all ${Ndump} mass_loss_3sizes.txt id xc yc &
    f_fml_1[1] f_fml_1[2] &
    f_fml_2[1] f_fml_2[2] &
    f_fml_3[1] f_fml_3[2]

# emit then release
stats 1
run 1

variable npart equal np
variable Nd equal ${Ndump}*2
fix 31 halt ${Nd} v_npart <= 0

stats ${Ndump}
run $N
