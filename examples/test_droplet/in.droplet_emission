# Droplet emission + transport case (SPARTA-native axisymmetric)
# Axi slot mapping: x = Z (axial), y = R (radial, >= 0), z = phi

variable dt    equal 1e-05
variable time  equal 10
variable N     equal floor(${time}/${dt})
variable Ndump equal 100

variable temp_droplet equal 773.15

variable Rho    equal 534.0
variable rd1    equal 1.5e-3
variable rd2    equal 2.5e-3
variable rd3    equal 3.5e-3
# md = 4/3 * pi * rho * r^3
variable md1    equal (4.0/3.0)*PI*${Rho}*${rd1}*${rd1}*${rd1}
variable md2    equal (4.0/3.0)*PI*${Rho}*${rd2}*${rd2}*${rd2}
variable md3    equal (4.0/3.0)*PI*${Rho}*${rd3}*${rd3}*${rd3}

seed                12345
timestep            ${dt}
dimension           2
boundary            o ao p
global              gridcut 0.0 comm/sort no
create_box          -3.8 3.8 0 5.7 -0.05 0.05
create_grid         40 30 1
balance_grid        rcb cell

global fnum 0.0000001

species droplet.species drop_1 drop_2 drop_3
mixture drops_1 drop_1 frac 1.0
mixture drops_2 drop_2 frac 1.0
mixture drops_3 drop_3 frac 1.0

variable pmass particle mass

read_surf           wall.surf invert group surfID particle check
surf_collide        wallColModel  diffuse ${temp_droplet} 1.0
surf_react          wallReact global 1. .0
surf_modify         surfID collide wallColModel react wallReact

fix    pd plasma/data file plasma.h5 static yes

read_particles source 1

dump dtraj particle all ${Ndump} case.outer id type x y z vx vy vz v_pmass temp radius

fix fevap_1 evaporation 1 drops_1 plasma_data pd mass ${md1} radius ${rd1} temp ${temp_droplet}
fix fevap_2 evaporation 1 drops_2 plasma_data pd mass ${md2} radius ${rd2} temp ${temp_droplet}
fix fevap_3 evaporation 1 drops_3 plasma_data pd mass ${md3} radius ${rd3} temp ${temp_droplet}

fix fdrag   drag 1 2.0 1 plasma_data pd gravity 0 -9.8 0 model epstein
fix fcharge droplet/charge 1 plasma_data pd ion_mass_amu 2.0 thermionic no

global bfield_compute pd
global boris_subcycles 5

stats 1
run 1

variable npart equal np
variable Nd equal ${Ndump}*2
fix 31 halt ${Nd} v_npart <= 0

stats ${Ndump}
run $N
