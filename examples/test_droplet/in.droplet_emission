# Droplet emission + transport case (SPARTA-native axisymmetric)
# Axi slot mapping: x = Z (axial), y = R (radial, >= 0), z = phi

variable dt    equal 1e-05
variable time  equal 10
variable N     equal floor(${time}/${dt})
variable Ndump equal 100

variable temp_droplet equal 773.15

seed                12345
timestep            ${dt}
dimension           2
boundary            o ao p
global              gridcut 0.0 comm/sort no
create_box          -3.8 3.8 0 5.7 -0.05 0.05
create_grid         40 30 1
balance_grid        rcb cell

# Per-cell radial weighting: large-R cells get larger weight so each cell
# holds approximately the same particle count regardless of R. Reduces
# stats noise for axisymmetric runs. Must come AFTER create_grid.
global              weight cell radius

global fnum 0.0000001

species droplet.species drop_1 drop_2 drop_3
mixture drops_1 drop_1 frac 1.0
mixture drops_2 drop_2 frac 1.0
mixture drops_3 drop_3 frac 1.0

read_surf           wall.surf invert group surfID particle check
surf_collide        wallColModel  diffuse ${temp_droplet} 1.0
surf_react          wallReact global 1. .0
surf_modify         surfID collide wallColModel react wallReact

fix    pd background file plasma.h5 static yes

read_particles source 1

dump dtraj particle all ${Ndump} output/case.outer id type x y z vx vy vz temp radius

fix fevap_1 droplet/evaporate 1 drops_1 background pd heatflux/scale 2.0 rocket_eta 0.5
fix fevap_2 droplet/evaporate 1 drops_2 background pd heatflux/scale 2.0 rocket_eta 0.5
fix fevap_3 droplet/evaporate 1 drops_3 background pd heatflux/scale 2.0 rocket_eta 0.5

fix fdrag   droplet/drag 1 2.0 1 background pd gravity 0 -9.8 0 model epstein
fix fcharge droplet/charge 1 background pd ion_mass_amu 2.0 thermionic no

global pusher plasma pd
global pusher subcycles 5

stats 1
run 1

variable npart equal np
variable Nd equal ${Ndump}*2
fix 31 halt ${Nd} v_npart <= 0

stats ${Ndump}
run ${N}
