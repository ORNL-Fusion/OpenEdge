SPARTA-OPENEDGE (24 Sep 2025)
Running on 128 MPI task(s)
# RFPIE: He+ sputtering of a DC/RF-biased tungsten target and W0..W4+ transport

# Domain
seed                104729
dimension           3
global              gridcut 0.0 comm/sort no
boundary            o o o

create_box          -0.0301 0.0301 -0.0301 0.0301 -0.0002 0.0600
Created orthogonal box = (-0.0301 -0.0301 -0.0002) to (0.0301 0.0301 0.06)
variable            nx index 64
variable            ny index 64
variable            nz index 96
create_grid         ${nx} ${ny} ${nz}
create_grid         128 ${ny} ${nz}
create_grid         128 128 ${nz}
create_grid         128 128 192
WARNING: Could not acquire nearby ghost cells b/c grid partition is not clumped (/global/homes/d/diawa/OpenEdge/src/grid.cpp:473)
Created 3145728 child grid cells
  CPU time = 0.00900378 secs
  create/ghost percent = 64.572 35.428
balance_grid        rcb cell
Balance grid migrated 3121152 cells
  CPU time = 0.138069 secs
  reassign/sort/migrate/ghost percent = 44.7326 1.41977 26.0637 27.784

# Species and geometry
global              fnum 1.0e10
global              surfmax 5000
species             input/atoms.species W W+ W2+ W3+ W4+
mixture             wSource W frac 1.0
mixture             wDiag W W+ W2+ W3+ W4+ group SELF

variable            targetfile index input/target.surf
read_surf           ${targetfile} custom sheath float 3                     group tungsten particle check
read_surf           input/target.surf custom sheath float 3                     group tungsten particle check
  478 triangles
  -0.01143 0.01143 xlo xhi
  -0.01143 0.01143 ylo yhi
  0 0.001905 zlo zhi
  0.00118332 min triangle edge length
  7.48089e-08 min triangle area
  4900 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  3132008 8820 4900 = cells outside/inside/overlapping surfs
  4900 = surf cells with 1,2,etc splits
  0.000217387 0.000217387 = cell-wise and global flow volume
  CPU time = 0.147357 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 3.523 8.11106 1.95958 62.0294 24.377 20.238 0.00466419
  surf2grid time = 0.0914045 secs
  map/comm1/comm2/comm3/comm4/split percent = 61.8008 2.72397 6.01268 1.91653 8.15663 8.34386
variable            geomgroups index input/geometry_groups.inc
include             ${geomgroups}
include             input/geometry_groups.inc
# generated by scripts/build_geometry.py
group target_body surf id 1:178
0 = initial surface count in group target_body
178 = final surface count in group target_body
group target surf id 179:478
0 = initial surface count in group target
300 = final surface count in group target

surf_collide        absorb vanish
surf_modify         target_body collide absorb
surf_modify         target collide absorb

# Plasma and source
variable            plasmafile index input/plasma_he.h5
fix                 pd background file ${plasmafile} static yes bz 0.1
fix                 pd background file input/plasma_he_zramp.h5 static yes bz 0.1

variable            rffreq index 1.356e7
variable            phase_samples index 64
variable            pmi_static index yes
compute             cpmi surface/physical/sputter target background pd                     target W projectiles He mass_amu 4.002602                     static ${pmi_static} sheath_waveform sheath ${rffreq} ${phase_samples}                     erosion_flux
compute             cpmi surface/physical/sputter target background pd                     target W projectiles He mass_amu 4.002602                     static yes sheath_waveform sheath ${rffreq} ${phase_samples}                     erosion_flux
compute             cpmi surface/physical/sputter target background pd                     target W projectiles He mass_amu 4.002602                     static yes sheath_waveform sheath 1.356e7 ${phase_samples}                     erosion_flux
compute             cpmi surface/physical/sputter target background pd                     target W projectiles He mass_amu 4.002602                     static yes sheath_waveform sheath 1.356e7 64                     erosion_flux

fix                 pw particle/weight
variable            popnmax index 200
if "${popnmax} > 0" then "fix fpop population/control 200 ${popnmax}"
fix fpop population/control 200 ${popnmax}
fix fpop population/control 200 5000
variable            diagevery index 1000
variable            diagsample index 10
variable            diagnrepeat index 100
compute             cWdens grid/weighted all wDiag nrho_w
fix                 fWdens ave/grid all ${diagsample} ${diagnrepeat} ${diagevery}                     c_cWdens[*] ave one
fix                 fWdens ave/grid all 10 ${diagnrepeat} ${diagevery}                     c_cWdens[*] ave one
fix                 fWdens ave/grid all 10 100 ${diagevery}                     c_cWdens[*] ave one
fix                 fWdens ave/grid all 10 100 2000                     c_cWdens[*] ave one
variable            nlaunch index 100
if "${nlaunch} > 0" then "fix femit surface/emit/source wSource target cpmi perspecies no nlaunch_total ${nlaunch} model thompson 8.68 emax 80 nevery 1"
fix femit surface/emit/source wSource target cpmi perspecies no nlaunch_total ${nlaunch} model thompson 8.68 emax 80 nevery 1
fix femit surface/emit/source wSource target cpmi perspecies no nlaunch_total 5000 model thompson 8.68 emax 80 nevery 1

# Transport
fix                 fchem volume/chem/adas 1 W auto
variable            balpartevery index 200
variable            baltimeevery index 1000
fix                 fbal balance ${balpartevery} 1.1 rcb part emptyweight auto
fix                 fbal balance 200 1.1 rcb part emptyweight auto

include             input/in.forces
# Geometry provider for the target-local thin sheath boundary.
compute             cgeom nearest_surf/grid all target dist surfid nx ny nz

# "boundary" is a sub-grid potential sheet.  The floating sheath plus the
# instantaneous target bias is paid once by an outbound W ion; ions without
# enough wall-normal energy reflect back to the target (prompt redeposition).
global              pusher plasma pd mode boris                     subcycles 2 bad_dt_check yes bad_dt_limit 0.5                     sheath boundary geom cgeom mD_amu 4.002602 dmax 5.0e-4                     waveform sheath ${rffreq} dump no
global              pusher plasma pd mode boris                     subcycles 2 bad_dt_check yes bad_dt_limit 0.5                     sheath boundary geom cgeom mD_amu 4.002602 dmax 5.0e-4                     waveform sheath 1.356e7 dump no

variable            Dperp index 0.1
fix                 fcd cross_field_diffusion 1 background pd D_perp ${Dperp}
fix                 fcd cross_field_diffusion 1 background pd D_perp 0.1
fix                 fcoul coulomb/background 1 background pd 4.002602 1.0
fix                 fth force/thermal 1 background pd ion_thermal yes elec_thermal yes

variable            dt index 2.0e-8
timestep            ${dt}
timestep            2.0e-8
stats               1000
stats_style         step cpu np nscoll nsreact

# Diagnostics
variable            runsteps index 10000
variable            balswitch index 1000
variable            mainsteps equal v_runsteps-v_balswitch
variable            outdir index output
shell               mkdir ${outdir}
shell               mkdir output
print               "dt_s=${dt} run_steps=${runsteps} nx=${nx} ny=${ny} nz=${nz} nlaunch=${nlaunch} diagevery=${diagevery}"                     file ${outdir}/run_settings.txt screen no
print               "dt_s=${dt} run_steps=${runsteps} nx=${nx} ny=${ny} nz=${nz} nlaunch=${nlaunch} diagevery=${diagevery}"                     file output/run_settings.txt screen no
variable            stateevery index 1000
variable            dumpevery index 5000
dump                dstate particle all ${stateevery} ${outdir}/rfpie_w.*.dump                     id type x y z vx vy vz p_pweight
dump                dstate particle all 10000 ${outdir}/rfpie_w.*.dump                     id type x y z vx vy vz p_pweight
dump                dstate particle all 10000 output/rfpie_w.*.dump                     id type x y z vx vy vz p_pweight
dump                dWgrid grid all ${diagevery} ${outdir}/rfpie_w_density.*.dump                     id xc yc zc vol f_fWdens[*]
dump                dWgrid grid all 2000 ${outdir}/rfpie_w_density.*.dump                     id xc yc zc vol f_fWdens[*]
dump                dWgrid grid all 2000 output/rfpie_w_density.*.dump                     id xc yc zc vol f_fWdens[*]
dump                dsurf surf target ${dumpevery} ${outdir}/target.*.dump                     id c_cpmi
dump                dsurf surf target 10000 ${outdir}/target.*.dump                     id c_cpmi
dump                dsurf surf target 10000 output/target.*.dump                     id c_cpmi

# Run
run                 0 post no
