# ST40 Li powder dropper: shot 14449 source in a SOLPS-13589 background.

# Default: 0.5 s demonstration. Override with `-var nsteps 2500000` for 5 s.
variable dt       index 2.0e-6
variable nsteps   index 250000
variable ndump    index 25000
variable nemit    index 200
variable outdir   index output

shell mkdir ${outdir}

include input/setup.inc
include input/physics.inc
include input/diagnostics.inc

run ${nsteps}
