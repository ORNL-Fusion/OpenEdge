# ST40 Li powder dropper: shot 14449 source in a SOLPS-13589 background.
variable    dt        equal 2.0e-6
# demo length: 0.5 s of shot time — grains fall in and the Li plume
# establishes. The full 14449 source history needs nsteps 2500000 (5 s).
variable    nsteps    equal 250000
variable    ndump     equal 25000
variable    nemit     equal 200
variable    balswitch index 1500000
variable    outdir    index output

shell       mkdir ${outdir}

# Domain
seed        12345
dimension   2
boundary    o ao p
global      gridcut 0.0 comm/sort no
global      fnum 1.0e14
timestep    ${dt}

create_box  -1.0 1.0  0.0 1.05  -0.05 0.05
create_grid 130 72 1
balance_grid rcb cell
global      weight cell radius

# Species
species     input/grains.species droplet
species     input/atoms.species Li Li+ Li2+ Li3+
mixture     droplet droplet frac 1.0
mixture     livapor Li      frac 1.0
mixture     allLi Li Li+ Li2+ Li3+ group SELF

# Geometry
read_surf   input/st40_wall_axi.surf group wall particle check
read_surf   input/st40_core.surf group core
group dropper surf id <> 16 17

surf_collide wallc diffuse 300.0 1.0
surf_react   liwall surface/pwi input/li.recycle twall 300 &
             adens_surf adens rzone 1e19
surf_modify  wall collide wallc react liwall
surf_collide corec diffuse 300.0 1.0
surf_react   licore surface/pwi input/li.recycle twall 300 &
             adens_surf adensc rzone 1e19
surf_modify  core collide corec react licore

adapt_grid  all refine surf wall 0.001 maxlevel 3 cells 2 2 1
balance_grid rcb cell

# Plasma and transport
fix pd      background file input/plasma_st40_solps.h5 static yes
global      phi_track yes

compute     cgeom nearest_surf/grid all wall dist surfid nx ny nz
global      pusher plasma pd mode gca gca_switch 2.5 &
            gca_integrator rk4 subcycles 1 &
            bad_dt_check yes bad_dt_limit 0.5 &
            gc_wall flux skip droplet &
            sheath boundary geom cgeom mD_amu 2.0

variable    Dperp index 0.1
fix fcd     cross_field_diffusion 1 background pd D_perp ${Dperp}
fix fcoul   coulomb/background 1 background pd 2.0 1.0
fix fth     force/thermal 1 background pd ion_thermal yes elec_thermal yes

# Powder source
include     input/srate.deck

fix fdrop   particulate/emit droplet dropper nevery ${nemit} n v_srate nweight ${nweight} &
            perspecies no normal no vmin 1.0 vmax 1.5 cone 15 dir 0 -1 0 planar yes
fix fcharge particulate/charge 1 background pd ion_mass_amu 2.0 thermionic no mixture droplet material Li
fix fdrag   particulate/drag   1 2.0 1 background pd gravity 0 -9.8 0 &
            model dustt2005 coulomb/self yes material Li mixture droplet
fix fevap   particulate/thermal 1 droplet background pd &
            heatflux/scale 1.0 rocket_eta 0.0 emit_into livapor &
            heating oml ion_mass_amu 2.0 material Li
fix fchem   volume/chem/adas 1 Li input/li.reactions output summary
fix fbal    balance 200 1.1 rcb part

# Diagnostics
dump dpart  particle all ${ndump} ${outdir}/state id type x y z vx vy vz &
            p_phi_unwrap

fix     fpw particle/weight
compute cli grid/weighted all allLi nrho_w
fix     fli ave/grid all 10 1000 10000 c_cli[1] c_cli[2] c_cli[3] c_cli[4] ave one
dump    dgrid grid all 10000 ${outdir}/li_dens id xc yc f_fli[1] f_fli[2] f_fli[3] f_fli[4]

dump    dwall surf wall 10000 ${outdir}/wall_adens id &
        s_adens[1] s_adens[2] s_adens[3] s_adens[4] s_adens[5] s_adens_dep
dump    dcore surf core 10000 ${outdir}/core_dep id &
        s_adensc[1] s_adensc[2] s_adensc[3] s_adensc[4] s_adensc[5] s_adensc_dep

compute cnt count droplet/default allLi/Li allLi/Li+ allLi/Li2+ allLi/Li3+

stats       ${ndump}
stats_style step cpu np nscoll nsreact c_cnt[1] c_cnt[2] c_cnt[3] c_cnt[4] c_cnt[5]

# Run
run         ${balswitch}
unfix       fbal
fix fbal    balance 1000 1.1 rcb time
variable    nrest equal ${nsteps}-${balswitch}
run         ${nrest}
