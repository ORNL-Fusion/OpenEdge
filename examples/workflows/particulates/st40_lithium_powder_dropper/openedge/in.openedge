# ST40 Li powder dropper: shot 14449 source in the SOLPS-13589_2 background.
# Self-contained deck: domain, species, walls, background, physics, diagnostics.

# Run from this directory (writes output/ and log.openedge) and analyse:
#   mpirun -np 4 ~/build_oe/src/spa_mac_mpi -in in.openedge
#   /Users/42d/venvs/openedge-env/bin/python scripts/build_13589_2_li_notebook.py
# EOS: scripts/sync_eos.sh push; sbatch scripts/launch_eos.slurm; scripts/sync_eos.sh pull <run>
# Defaults: 0.4 s = 200 ms powder flight + 20 ms ramp + 9 steady 20 ms windows.
# The run only produces the SOLPS sources: Li is removed at ionization
# (chem_mode neutral) and Sp/Qe are dumped per 20 ms window. `-var chem_mode
# kinetic` keeps Li+ as tracked particles instead (standalone checks only).
variable dt        index 2.0e-6
variable nsteps    index 200000
variable ndump     index 25000
variable nemit     index 200
variable outdir    index output
variable chem_mode index neutral
# Statistics knobs: fnum = real atoms per Li macroparticle (lower = more Li
# particles, cost ~1/fnum); nweight = real grains per macro-grain (set below);
# nstats = stats interval for the inventory traces.
variable fnum      index 2.0e11
variable nstats    index 5000

shell mkdir ${outdir}

# ---- domain -----------------------------------------------------------------
seed        12345
dimension   2
boundary    o ao p
global      gridcut 0.0 comm/sort no
global      fnum ${fnum}
timestep    ${dt}

create_box  -1.0 1.0  0.0 1.05  -0.05 0.05
create_grid 260 144 1
balance_grid rcb cell
# no `global weight cell radius`: it clones/deletes particles crossing cells
# of different R, which randomly removed ~half of the grains in flight.

# ---- species ----------------------------------------------------------------
species     input/grains.species droplet
species     input/atoms.species Li Li+
mixture     droplet droplet frac 1.0
mixture     livapor Li frac 1.0

# ---- walls: vessel and core contour absorb everything (grains and Li) -------
# Dropper = wall lines 16-17. The core contour is the numerical sink at the
# inner SOLPS boundary (the core hole is vacuum in plasma.h5).
read_surf   input/st40_wall_axi.surf group wall particle check
read_surf   input/st40_core.surf group core
group       dropper surf id <> 16 17

surf_collide absorb vanish
surf_modify  wall collide absorb
surf_modify  core collide absorb

adapt_grid   all refine surf wall 0.001 maxlevel 3 cells 2 2 1
balance_grid rcb cell

# ---- background: scripts/build_background_13589_2.sh (from ../solps) --------
# native SOLPS cells + exponential wall-gap extension + total heat flux
fix         pd background file input/plasma_13589.h5 static yes
global      phi_track yes

# ---- plasma transport -------------------------------------------------------
compute cgeom nearest_surf/grid all wall dist surfid nx ny nz
global  pusher plasma pd mode gca gca_switch 2.5 &
        gca_integrator rk4 subcycles 1 &
        bad_dt_check yes bad_dt_limit 0.5 &
        gc_wall flux skip droplet &
        sheath boundary geom cgeom mD_amu 2.0

# Li+ transport, kinetic mode only (in neutral mode SOLPS transports Li+)
if "${chem_mode} == kinetic" then &
   "fix fcd   cross_field_diffusion 1 background pd D_perp 0.1" &
   "fix fcoul coulomb/background 1 background pd 2.0 1.0" &
   "fix fth   force/thermal 1 background pd ion_thermal yes elec_thermal yes ion_mass_amu 2.0"

# ---- powder injection, grain physics, Li chemistry -------------------------
# Constant feed: ngrain macro-grains every nemit steps, each worth nweight real
# 50 um grains (2.43e16 atoms). Defaults give 50 x 1 x 2.43e16 / 400 us =
# 3.0e21 atoms/s, about the shot-14449 pulse mean.
# For the measured S(t) instead: uncomment the include and use `n v_srate`.
variable ngrain  index 50
variable nweight index 1
#include input/srate.deck                 # measured S(t), generated by scripts/make_srate.py

fix fdrop particulate/emit droplet dropper nevery ${nemit} n ${ngrain} &
          nweight ${nweight} perspecies no normal no vmin 1.0 vmax 1.5 &
          cone 15 dir 0 -1 0 planar yes
# charge every 10 steps: 50 um grains reach OML equilibrium in < 1 ns and move
# ~2 um per step, and the OML root solve (erf) was 2/3 of the compute time.
fix fcharge particulate/charge 10 background pd model dustt2005 ion_mass_amu 2.0 &
            thermionic no mixture droplet material Li
fix fdrag particulate/drag 1 2.0 1 background pd gravity 0 -9.8 0 &
          model dustt2005 coulomb/self yes material Li mixture droplet
fix fevap particulate/thermal 1 droplet background pd model dustt2005 &
          heatflux/scale 1.0 &
          rocket_eta 0.0 emit_into livapor heating oml ion_mass_amu 2.0 &
          material Li
fix fchem volume/chem/adas 1 Li input/li.reactions mode ${chem_mode} &
          source_species Li units rate output summary

fix fbal balance 1000 1.1 rcb part

# ---- diagnostics ------------------------------------------------------------
dump dpart particle all ${ndump} ${outdir}/state id type x y z vx vy vz &
           p_phi_unwrap

# 20 ms window-averaged number densities: grains (weighted by nweight), Li
fix     fpw particle/weight
mixture liplot droplet Li group SELF
compute cli grid/weighted all liplot nrho_w
fix     fli ave/grid all 10 1000 10000 c_cli[1] c_cli[2] ave one
dump    dgrid grid all 10000 ${outdir}/li_dens id xc yc f_fli[1] f_fli[2]

# SOLPS coupling sources (fix volume/chem/adas summary): f_fchem[1] = Sp
# particle source [/m^3/s], f_fchem[5] = Qe electron-energy source [W/m^3].
# 20 ms window averages, one source_SpSe file per window (b2.sources.profile chain).
fix     fsrc ave/grid all 10 1000 10000 f_fchem[*] ave one
dump    dsrc grid all 10000 ${outdir}/source_SpSe.* id xc yc vol f_fsrc[1] f_fsrc[5]
compute cSp_tot reduce sum f_fchem[1]
compute cSe_tot reduce sum f_fchem[5]

compute cnt count liplot/droplet liplot/Li
stats ${nstats}
stats_style step cpu np nscoll nsreact c_cnt[1] c_cnt[2] c_cSp_tot c_cSe_tot

run ${nsteps}
