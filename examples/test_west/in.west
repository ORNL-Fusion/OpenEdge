################################################################################
# WEST axisymmetric baseline (OpenEdge current syntax)
# - Uses compute plasma/fields (file mode)
# - Keeps only core field loading + field fixes for particle push
# - Removes legacy/unsupported chemistry/emission/background pieces for now
################################################################################

seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort yes

# R-Z box
create_box          1.82 3.2 -1.0 1.0 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

# Species list used by WEST workflows
species input/plasma.species W+
mixture tungstenSource W+ frac 1.0
read_particles       source.west 0

# Orbit-only test: no wall/core surfaces

read_surf           input/wall.txt group 1 particle check
surf_collide        DIFFUSEID vanish
surf_modify         1 collide DIFFUSEID react none


############################################- core surface and model -#####################################

read_surf           input/core.txt invert group CORE particle check
surf_collide        DIFFUSECore diffuse 1000 1
surf_modify         CORE collide DIFFUSECore react none


# Plasma + magnetic field from SOLPS/HDF5 using current compute style
# c_cwest[1:3] = bx,by,bz ; c_cwest[4] = epar
# c_cwest[5] = dens_e ; c_cwest[6:7] = grad_te_r,grad_te_z
compute cwest plasma/fields all file input/plasma.h5 input/bfield.h5 bx by bz epar dens_e grad_te_r grad_te_z

# Apply fields (static in time -> Nfreq=0)
fix bB bfield/grid c_cwest[1] c_cwest[2] c_cwest[3]
global bfield grid bB 0
global efield none


# Diagnostics: particle dump at end of simulation only
shell mkdir -p output
dump dpart particle all 1000 output/state.west id type x y z vx vy vz
dump_modify dpart first no
#dump depar grid all 1 output/epar.west.grid id xc yc c_cwest[4] c_cwest[5] c_cwest[6] c_cwest[7]
#dump_modify depar first yes


compute cgam incident/flux 1 file input/plasma.h5 nflux_incident nflux_normal nflux_species 1 nflux_species_normal 1
dump dgam surf 1 1 output/gamma.only id c_cgam[*]
dump_modify dgam first yes


variable npart equal np
global boris_subcycles 5

#fix 31 halt 1 v_npart <= 0

# One-particle B-only trajectory test
timestep            5.0e-08
stats              1 #1000
stats_style         step cpu np
run                 0
