seed                12345
dimension           2
boundary            o o p
global              gridcut 0.0 comm/sort no
global              fnum 5e4

create_box          1.80 3.25 -1.00 0.85 -0.05 0.05
create_grid         150 200 1
balance_grid        rcb cell

species input/plasma.species W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+
mixture             tungstenSource  W    frac 1.
mixture             tungstenSource  W+   frac 0.
mixture             tungstenSource  W2+  frac 0.
mixture             tungstenSource  W3+  frac 0.
mixture             tungstenSource  W4+  frac 0.
mixture             tungstenSource  W5+  frac 0.
mixture             tungstenSource  W6+  frac 0.
mixture             tungstenSource  W7+  frac 0.
mixture             tungstenSource  W8+  frac 0.
mixture             tungstenSource  W9+  frac 0.
mixture             tungstenSource  W10+ frac 0.

variable            TbindW equal 4.*11600.
variable            TwallK equal 773.15
variable            dt equal 1.0e-07
variable            nlaunchPerSurfW index 1
variable            sourceThreshW equal 0.
variable            Nwarm  index 2
variable            Nphase index 1000
variable            Nrep   equal ${Nphase}/100
variable            Ndump  index 10000
variable            tag    index A
mixture             tungstenSource temp ${TbindW}

read_surf           input/wall.surf group wall particle check
surf_collide        wallColl diffuse ${TbindW} 1.0
surf_react          wallPWI surface/pwi input/wall.recycle twall ${TwallK}
surf_modify         wall collide wallColl react wallPWI

region              rdiv_lo block 1.90 3.20 -1.00 -0.45 -INF INF
region              rdiv_up block 1.90 3.20  0.35  0.85 -INF INF
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_lo all iterate 5
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_up all iterate 5
balance_grid        rcb cell

fix                 pd background file input/plasma.h5 static yes
fix                 fcore reflect/psi background pd psi_norm 1.0 action reflect
global              pcache_nevery 20

# Point-based B-field for GCA (queried at particle position, not cell center).
compute             pfields plasma/fields all background pd br bt bz

compute             cgeom nearest_surf/grid all wall dist surfid nx ny nz
# Hybrid Boris/GCA: lower gca_switch makes GCA aggressive — for heavy W
# in WEST SOL (rho_L ~ um, L_B ~ m), gca_switch=0.1 => GCA used everywhere
# rho_L < 10*L_B (effectively all the time, except near-uniform-B patches).
global              pusher plasma pfields mode hybrid gca_switch 0.1 &
                    subcycles 1 bad_dt_check yes bad_dt_limit 0.5 dump no &
                    sheath kick geom cgeom mD_amu 2.0

fix fchem volume/chem/adas 1 W auto rate_cache cell

#fix ftf force/thermal 10 background pd &
#                    ion_thermal yes &
#                    elec_thermal yes

#fix fcd cross_field_diffusion 100 background pd D_perp 0.3

compute cpmiO surface/physical/sputter wall background pd &
                    target W projectiles O &
                    mass_amu 2.01410177811 static yes &
                    erosion_flux

fix pw particle/weight

fix femit surface/emit/source tungstenSource wall cpmiO perspecies no &
                    nlaunch ${nlaunchPerSurfW} source_thresh ${sourceThreshW} &
                    model thompson 4.4

mixture allW W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+ &
             group wsum
compute cwtot grid/weighted all allW nrho_w

compute cpmiO_rate surface/physical/sputter wall background pd &
                    target W projectiles O &
                    mass_amu 2.01410177811 static yes &
                    erosion_rate
compute csrc    reduce sum c_cpmiO_rate
compute cwtmean reduce ave c_cwtot[1]
compute cwtmax  reduce max c_cwtot[1]

compute cwspec  grid/weighted all species nrho_w
compute cw0     reduce sum c_cwspec[1]
compute cw1     reduce sum c_cwspec[2]
compute cw2     reduce sum c_cwspec[3]
compute cw3     reduce sum c_cwspec[4]
compute cw4     reduce sum c_cwspec[5]
compute cw5     reduce sum c_cwspec[6]
compute cw6     reduce sum c_cwspec[7]
compute cw7     reduce sum c_cwspec[8]
compute cw8     reduce sum c_cwspec[9]
compute cw9     reduce sum c_cwspec[10]
compute cw10    reduce sum c_cwspec[11]

timestep            ${dt}
stats               10
stats_style         step np &
                    c_cw0 c_cw1 c_cw2 c_cw3 c_cw4 c_cw5 &
                    c_cw6 c_cw7 c_cw8 c_cw9 c_cw10

fix     fwgrid ave/grid all 100 ${Nrep} ${Nphase} &
                    c_cwtot[1] c_cwspec[1] c_cwspec[2] ave one
fix     fbal balance 100 1.05 rcb part

run              ${Nwarm}

#dump    dwgrid grid all ${Nphase} output/grid.dens.${tag}.west &
#                    id xc yc xlo ylo xhi yhi &
#                    f_fwgrid[1] f_fwgrid[2] f_fwgrid[3]
dump    dpart particle all ${Nphase} output/state.${tag}.west.final &
                    id type x y z vx vy vz
#dump_modify dpart first no
#dump    dwflux surf all ${Ndump} output/wall.flux.${tag}.west &
#                    id v1x v1y v2x v2y c_cpmiO_rate
#dump_modify dwflux first no

run           ${Nphase}
