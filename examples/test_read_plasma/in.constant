seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort no

create_box          1.82 3.2 -1.0 1.0 -0.05 0.05
create_grid         240 200 1
balance_grid        rcb cell

compute cnear plasma/fields all constant dens_e 1.0e18 dens_i 1.0e18 temp_e 10.0 temp_i 10.0 magnetic_field 0.0 0.0 1.0 dens_e

shell mkdir -p output
dump dgrid grid all 1 output/plasma_grid.constant.ne id xc yc c_cnear
dump_modify dgrid first yes

stats               1
stats_style         step cpu np
timestep            1.0e-8
run                 1
