################################################################################
# DIII-D 3D wedge: C impurity transport with erosion, ionization, sheath
#
# Physics:
#   - D+ plasma background from SOLPS (plasma.h5 + bfield.h5)
#   - D-on-C sputtering via BCA yield table (1_on_6.h5)
#   - C ionization/recombination via ADAS (Z=6)
#   - Sheath kick model (Bohm sheath potential)
#   - Boris pusher with subcycling
#   - Nanbu Coulomb collisions with D+ background
#   - Braginskii ion + electron thermal forces
#   - Anomalous cross-field diffusion + gradient-driven pinch
#   - Ambipolar parallel E-field
#   - Toroidal periodic BCs on phi-face caps
################################################################################

seed                12345
dimension           3
boundary            o o o
global              gridcut -1.0 comm/sort yes surfmax 10000
global              fnum 1e12

create_box          -1.0 3.0  -1.0 2.0  -2.0 2.0
create_grid         100 100 100
balance_grid        rcb cell




# ---- Species and mixtures ----
species input/data/c.species C C+ C2+ C3+ C4+ C5+ C6+

mixture             carbonSource C       frac 1.0
mixture             carbonSource C+      frac 0.0
mixture             carbonSource C2+     frac 0.0
mixture             carbonSource C3+     frac 0.0
mixture             carbonSource C4+     frac 0.0
mixture             carbonSource C5+     frac 0.0
mixture             carbonSource C6+     frac 0.0
variable            TbindC equal 7.37*11600.
variable            TemitC equal 0.025*v_TbindC
mixture             carbonSource temp ${TemitC}

# ---- Surface geometry ----
read_surf           input/geometry/d3d_refined_wedge_capped.surf particle check

group               wall surf id 1:7360
group               caps surf id 7361:9196

# Plasma-wetted wall subset for sputtering emission
# (generated by input/scripts/generate_emit_groups.py)
include             input/generated/emit_wall_groups.sparta

surf_collide        WALL vanish
surf_collide        PERIODIC toroidal 30.0

surf_modify         wall collide WALL react none
surf_modify         caps collide PERIODIC react none


# ===========================================================================
# 1) Plasma/B-field compute on grid
# ===========================================================================
# c_pfields columns:
#   [1]=bx [2]=by [3]=bz [4]=epar
#   [5]=temp_e [6]=dens_e [7]=temp_i [8]=dens_i [9]=parrflow
#   [10]=grad_te_r [11]=grad_te_z [12]=grad_ti_r [13]=grad_ti_z
#   [14]=ex [15]=ey [16]=ez
#   [17]=grad_ne_r [18]=grad_ne_z
compute             pfields plasma/fields all file input/data/plasma.h5 input/data/bfield.h5 &
                    bx by bz epar temp_e dens_e temp_i dens_i parrflow &
                    grad_te_r grad_te_z grad_ti_r grad_ti_z ex ey ez &
                    grad_ne_r grad_ne_z
fix fpfields ave/grid all 1 1 1 c_pfields[*] ave one
dump dplasma grid all 1 output/plasma_grid id xc yc zc f_fpfields[5]
run 1

