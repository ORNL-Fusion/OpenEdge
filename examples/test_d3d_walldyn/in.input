################################################################################
# DIII-D 3D wedge: C impurity transport with erosion, ionization, sheath
#
# Physics:
#   - D+ plasma background from SOLPS (plasma.h5 + bfield.h5)
#   - D-on-C sputtering via BCA yield table (1_on_6.h5)
#   - C ionization/recombination via ADAS (Z=6)
#   - Sheath kick model (Bohm sheath potential)
#   - Boris pusher with subcycling
#   - Nanbu Coulomb collisions with D+ background
#   - Braginskii ion + electron thermal forces
#   - Anomalous cross-field diffusion + gradient-driven pinch
#   - Ambipolar parallel E-field
#   - Toroidal periodic BCs on phi-face caps
################################################################################

seed                12345
dimension           3
boundary            o o o
global              gridcut -1.0 comm/sort yes surfmax 10000
global              fnum 1e12

create_box          -1.0 3.0  -1.0 2.0  -2.0 2.0
create_grid         40 40 40
balance_grid        rcb cell




# ---- Species and mixtures ----
species input/data/c.species C C+ C2+ C3+ C4+ C5+ C6+

mixture             carbonSource C       frac 1.0
mixture             carbonSource C+      frac 0.0
mixture             carbonSource C2+     frac 0.0
mixture             carbonSource C3+     frac 0.0
mixture             carbonSource C4+     frac 0.0
mixture             carbonSource C5+     frac 0.0
mixture             carbonSource C6+     frac 0.0
variable            TbindC equal 7.37*11600.
variable            TemitC equal 0.025*v_TbindC
mixture             carbonSource temp ${TemitC}

# ---- Surface geometry ----
read_surf           input/geometry/d3d_refined_wedge_capped.surf particle check

group               wall surf id 1:7360
group               caps surf id 7361:9196

# Plasma-wetted wall subset for sputtering emission
# (generated by input/scripts/generate_emit_groups.py)
include             input/generated/emit_wall_groups.sparta

surf_collide        WALL vanish
surf_collide        PERIODIC toroidal 30.0

surf_modify         wall collide WALL react none
surf_modify         caps collide PERIODIC react none

# Local static refinement near the lower divertor and early flight region.
# Start broad enough to actually capture the emitted trajectories, then tighten later.
region              rdiv_emit block 2.00 2.42 0.00 0.70 -1.35 -0.90
region              rdiv_fly  block 1.75 2.50 0.00 1.10 -1.25 -0.45

adapt_grid          all refine surf all 0.001 maxlevel 3 cells 2 2 2 region rdiv_emit all iterate 2
adapt_grid          all refine surf all 0.001 maxlevel 3 cells 2 2 2 region rdiv_fly  all iterate 2
balance_grid        rcb cell


# ===========================================================================
# 1) Plasma/B-field compute on grid
# ===========================================================================
# c_pfields columns:
#   [1]=bx [2]=by [3]=bz [4]=epar
#   [5]=temp_e [6]=dens_e [7]=temp_i [8]=dens_i [9]=parrflow
#   [10]=grad_te_r [11]=grad_te_z [12]=grad_ti_r [13]=grad_ti_z
#   [14]=ex [15]=ey [16]=ez
#   [17]=grad_ne_r [18]=grad_ne_z
compute             pfields plasma/fields all file input/data/plasma.h5 &
                    equilibrium input/data/g174310.03500_153.X4.equ &
                    bx by bz epar temp_e dens_e temp_i dens_i parrflow &
                    grad_te_r grad_te_z grad_ti_r grad_ti_z ex ey ez &
                    grad_ne_r grad_ne_z

# ===========================================================================
# 2) Boris pusher with B-field from equilibrium point queries
# ===========================================================================
global              bfield_compute pfields
global              boris_subcycles 5

# Ambipolar parallel E-field from electron pressure gradient
#fix                 fEpar efield/grid c_pfields[14] c_pfields[15] c_pfields[16]
#global              efield grid fEpar 0

# Sheath geometry and kick model
compute             cgeom sheath/geometry/grid all all dist nx ny nz surfidx
global              sheath geom_compute cgeom plasma_compute pfields &
                    mD_amu 2.0 pot_mult 2.5 kick yes

# ===========================================================================
# 3) ADAS ionization/recombination for Carbon (Z=6)
# ===========================================================================
fix                 chem chem/adas 1 6 input/data/plasma.adas adas_dir ../../database/adas

# ===========================================================================
# 4) Nanbu Coulomb collisions with D+ background
# ===========================================================================
#fix                 fnanbu coll/nanbu 1 plasma c_pfields[5] c_pfields[6] &
#                    nobinary &
#                    background 2.0 1.0 &
#                    c_pfields[7] c_pfields[8] c_pfields[9] &
#                    c_pfields[1] c_pfields[2] c_pfields[3]

# ===========================================================================
# 5) Braginskii thermal forces on impurity ions
# ===========================================================================
#fix                 ftf thermal_force 1 &
#                    bfield c_pfields[1] c_pfields[2] c_pfields[3] &
#                    ion_thermal c_pfields[12] c_pfields[13] coeff 2.6 &
#                    elec_thermal c_pfields[10] c_pfields[11] coeff 0.71

# ===========================================================================
# 6) Anomalous cross-field diffusion + gradient-driven pinch
# ===========================================================================
#fix                 fcd cross_diffusion 1 &
#                    bfield c_pfields[1] c_pfields[2] c_pfields[3] &
#                    D_perp 1.0 &
#                    gradient_pinch 2.0 c_pfields[6] c_pfields[17] c_pfields[18]

# ===========================================================================
# 7) Sputtering source (D-on-C, Bohm flux model)
# ===========================================================================
compute             cpmi pmi/surf/data emit_wall file input/data/plasma.h5 input/data/1_on_6.h5 &
                    bfield input/data/bfield.h5 boundary input/data/solps_boundary.dat &
                    projectile_slots 1 1 mass_amu 2.0 sputter_flux_total

# Per-particle weight infrastructure for weighted emission
#fix                 pw particle/weight

# Emit sputtered C from cpmi total sputter flux
fix                 femit emit/surf/pmi carbonSource emit_wall cpmi perspecies no normal yes &
                   nlaunch 1 flux_thresh 1e18

fix fcore reflect/psi 1 equ input/data/g174310.03500_153.X4.equ psi_norm 0.926 action absorb

#read_particles source 1

# ===========================================================================
# 8) Diagnostics
# ===========================================================================
shell               mkdir -p output

# Surface sputtering flux (emit_wall subset only)
#dump                dpmi surf emit_wall 500 output/pmi.d3d id c_cpmi

# Particle state dump
dump                dpart particle all 100 output/particles id type x y z vx vy vz p_pweight
#dump_modify         dpart first yes

# Weighted density (correct physical density with per-particle weights)
#compute             cwden grid/weighted all species nrho_w
#fix                 fwden ave/grid all 1 100 500 c_cwden[*] ave running
#dump                dwden grid all 500 output/density_weighted id xc yc zc f_fwden[*]

timestep            1.0e-09
stats               10
stats_style         step cpu np

run 1

unfix femit
run                 50000
