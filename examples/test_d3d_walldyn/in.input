################################################################################
# DIII-D 3D wedge: C impurity transport with erosion, ionization, sheath
#
# Physics:
#   - D+ plasma background from SOLPS (plasma.h5 + bfield.h5)
#   - D-on-C sputtering via BCA yield table (1_on_6.h5)
#   - C ionization/recombination via ADAS (Z=6)
#   - Borodkina spatial sheath model
#   - Boris pusher with subcycling
#   - Toroidal periodic BCs on phi-face caps
################################################################################

seed                12345
dimension           3
boundary            o o o
global              gridcut -1.0 comm/sort yes
global              fnum 1e10

log log.openedge
create_box          -1.0 3.0  -1.0 2.0  -5.0 5.0
create_grid         16 16 16
balance_grid        rcb cell

# ---- Species and mixtures ----
species input/c.species C C+ C2+ C3+ C4+ C5+ C6+

mixture             carbonSource C       frac 1.0
mixture             carbonSource C+      frac 0.0
mixture             carbonSource C2+     frac 0.0
mixture             carbonSource C3+     frac 0.0
mixture             carbonSource C4+     frac 0.0
mixture             carbonSource C5+     frac 0.0
mixture             carbonSource C6+     frac 0.0
variable            TbindC equal 7.37*11600.
mixture             carbonSource temp ${TbindC}

# ---- Surface geometry ----
read_surf           input/d3d_case_wedge_capped.surf particle check

group               wall surf id 1:136
group               caps surf id 137:268

surf_collide        WALL vanish
surf_collide        PERIODIC toroidal 30.0

surf_modify         wall collide WALL react none
surf_modify         caps collide PERIODIC react none

# ---- Plasma fields on grid ----
compute             pfields plasma/fields all file input/plasma.h5 input/bfield.h5 &
                    bx by bz temp_e dens_e temp_i dens_i parrflow

# ---- Magnetic field from plasma compute ----
fix                 bB bfield/grid c_pfields[1] c_pfields[2] c_pfields[3]
global              bfield grid bB 0
global              efield none

# ---- Boris pusher ----
global              boris_subcycles 5

# ---- Sheath (Borodkina per-particle kick) ----
compute             cgeom sheath/geometry/grid all all dist nx ny nz surfidx
global              sheath geom_compute cgeom plasma_compute pfields &
                    mD_amu 2.0 kick yes

# ---- ADAS ionization/recombination for Carbon (Z=6) ----
fix                 chem chem/adas 1 6 input/plasma.adas adas_dir ../../database/adas

# ---- Sputtering source ----
compute             cpmi pmi/surf/data wall file input/plasma.h5 input/1_on_6.h5 &
                    bfield input/bfield.h5 projectile_slots 1 1 mass_amu 2.0 sputter_flux_total

fix                 femit emit/surf/pmi carbonSource wall cpmi perspecies no normal yes

# ---- Diagnostics ----
shell               mkdir -p output

dump                dpmi surf wall 100 output/pmi.d3d id c_cpmi
dump                dpart particle all 100 output/particles id type x y z vx vy vz

timestep            1.0e-9
stats               10
stats_style         step cpu np

run                 1000
