################################################################################
# --- Plasma parameters (SI units) ---------------------------------------------
################################################################################
variable realDensity  equal 1e19             # [1/m^3] background plasma density
variable fnum         equal 1e15             # scaling factor for density normalization
variable T            equal 12.0*11604.505   # temperature = 12 eV (in Kelvin-equivalent)

################################################################################
# --- Simulation domain and global setup ---------------------------------------
################################################################################
seed                 1245
dimension            3
boundary             p p p                   # periodic boundaries
global               gridcut 0.0 comm/sort no
global               boris_subcycles 1 boris_bad_dt_check yes boris_bad_dt_limit 0.05

# 3D cubic box (just needs to contain the orbit)
create_box           -20 20 -40 40  -20 20
create_grid          10 10 10
balance_grid         rcb part

# normalized density and number scaling
global               nrho ${realDensity} fnum ${fnum}


################################################################################
# --- Impurity / test particle species -----------------------------------------
################################################################################
species              plasma.species H
mixture              Hmix H frac 1

read_particles    source 0

###############################################################################
# --- Magnetic and electric fields: uniform Bz, sinusoidal Ex(t), SI ----------
###############################################################################
# B = B0 * zhat,  Ex(t) = E0 * sin(omega * t)

variable qe     equal 1.602176634e-19     # [C]
variable mi     equal 1.67262192369e-27   # [kg] proton mass

variable B0     equal 1.0                 # [T]
variable E0     equal 50.0                # [V/m]
variable omegac equal v_qe*v_B0/v_mi      # [rad/s]
variable omega  equal 0.05*v_omegac       # [rad/s], slower than gyro


# time variable (must match timestep below)
variable dt     equal 0.02/v_omegac       # [s], gives |q/m|*|B|*dt ~= 0.02
variable t      equal step*${dt}

# global Ex(t) = E0 * sin(omega * t)
variable Ex_global equal "v_E0*sin(v_omega*v_t)"


# particle-style fields
variable Bx particle "0.0"
variable By particle "0.0"
variable Bz particle "v_B0"

variable Ex particle "v_Ex_global"
variable Ey particle "0.0"
variable Ez particle "0.0"

# register with OpenEdge
fix       1 efield/particle Ex Ey Ez
fix       2 bfield/particle Bx By Bz

global    efield particle 1 0    # fix ID 1, update every step
global    bfield particle 2 0    # fix ID 2, update every step

###############################################################################
# --- Time stepping and diagnostics -------------------------------------------
###############################################################################
# one period of Ex: T = 2*pi/omega
# with omega=0.05*omegac and dt=0.02/omegac -> ~6283 steps per period
# run ~10 periods


variable numStep  equal 62832
variable dumpFreq equal 50

timestep  ${dt}
dump      10 particle all ${dumpFreq} state id type x y z vx vy vz
stats    ${dumpFreq}
stats_style step cpu np

run     ${numStep}

# -----------------------------------------------------------------------------
# End of file
# -----------------------------------------------------------------------------
