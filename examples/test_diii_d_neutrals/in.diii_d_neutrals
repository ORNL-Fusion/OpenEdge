################################################################################
# A5c: DIII-D neutrals test case for OpenEdge vs SOLPS-EIRENE comparison.
#
# Plasma: DIII-D case run_lore2023_reference (converged SOLPS D-only).
#         Converted to OpenEdge via tools/converters/convert_solps_plasma.py.
# Wall:   68-line boundary extracted from SOLPS mesh.extra
#         (tools/converters/create_surf_from_solps.py).
#
# Scope (first pass -- puff-only, no recycling):
#   - Mode A (EIRENE semantics) volumetric physics:
#       * D2 dissociation (Janev/HYDHEL H.2 2.2.5)
#       * D ionization (ADAS SCD, deletes)
#       * D + D+ charge exchange (ADAS CCD)
#   - D2 puff from single wall element (line id 2, near lower-outer divertor
#     strike, R=1.46, Z=-1.25). Puff rate matched qualitatively to SOLPS
#     user-puff 2.5e21/s. Actual location of SOLPS stratum-6 is not yet
#     resolved from the b2ag.dat indexing; using this divertor location is a
#     reasonable proxy for recycling-dominated neutral source.
#   - Absorbing walls (surf_collide vanish). NO wall recycling in this
#     first pass -- the broader SOLPS recycling-driven ionization map is
#     follow-up work (requires either Mode B kinetic D+ or emission tied to
#     background ion flux).
#
# Comparison (compare_to_eirene.py):
#   OpenEdge f_frate[1] (ionization-source rate, m^-3 s^-1) vs
#   EIRENE S_iz extracted from balance.nc (eirene_truth.h5). Expect match in
#   shape near the puff, divergence elsewhere (EIRENE includes recycling
#   from all 7 strata).
################################################################################

seed                12345
dimension           2
boundary            o o p
global              gridcut 0.0 comm/sort no
global              fnum 1e13

create_box          0.95 2.4 -1.4 1.4 -0.05 0.05
create_grid         200 400 1
balance_grid        rcb cell

# ---- Species (D2, D, D+). D+ only declared (never spawned in Mode A) ----
species             input/neutral.species D2 D D+
mixture             puff_mix D2 frac 1.0 nrho 1e18 temp 300.0

# ---- Wall: absorbing. Puff source = single wall element. ----
read_surf           input/wall.surf group wall particle check
surf_collide        wallColl vanish
surf_modify         wall collide wallColl react none
# Tag one wall line (id=2, R=1.46 Z=-1.25, lower-outer divertor) as puff source
group               gpuff surf id == 2

# ---- Plasma background (static; EIRENE-equivalent frozen plasma) ----
fix                 pd plasma/data file input/plasma.h5 static yes
global              bfield_compute pd

# ---- Grid refinement near the wall (helps partition + surf checks) ----
region              rdiv_lo block 1.0 2.4 -1.4 -0.8 -INF INF
region              rdiv_up block 1.0 2.4  0.7  1.4 -INF INF
adapt_grid          all refine surf all 0.005 maxlevel 3 cells 2 2 1 region rdiv_lo all iterate 3
adapt_grid          all refine surf all 0.005 maxlevel 3 cells 2 2 1 region rdiv_up all iterate 3
balance_grid        rcb cell

# ---- Volumetric chemistry: Mode A (EIRENE-style) ----
# Reactions: D->D+ (I), D+->D (R, ineffective in Mode A), CX (E), D2 diss (D)
fix fchem chem/adas 1 1 input/neutral.reactions adas_dir ../../database/adas &
    mode neutral source_species D D2 &
    stop_on_exhaust yes exhaust_threshold 2000 &
    units rate

# ---- D2 puff at chosen wall element ----
# n=200 per step until Np >= 50000 particles, then latches off. Puff rate
# in physical units: n * fnum / dt = 200 * 1e13 / 1e-8 = 2e23 /s
# (intentionally high vs SOLPS 2.5e21 to get good MC statistics before
#  exhaustion; the shape of the ionization map is what we compare).
fix fpuff emit/surf/puff puff_mix gpuff n 200 normal yes perspecies no &
    stop_at_np 50000

timestep            1e-8
stats               200
stats_style         step cpu np

# ---- Diagnostics ----
compute cden grid all species nrho
fix    fden ave/grid all 1 100 1000 c_cden[*] ave one
fix    frate ave/grid all 1 1000 1000 f_fchem[*] ave one

# ---- Runtime load balance + adaptive refinement (after ave/grid fixes) ----
fix fadapt adapt 200 all refine particle 500 0 maxlevel 5 cells 2 2 1
fix fbal   balance 100 1.05 rcb part

dump d1 grid all 5000 output/diii_d.grid id xc yc &
     f_fden[1] f_fden[2] &
     f_frate[1] f_frate[2] f_frate[3] f_frate[4]
dump_modify d1 pad 6

run                 30000
