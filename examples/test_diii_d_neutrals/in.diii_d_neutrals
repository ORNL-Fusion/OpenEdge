################################################################################
# DIII-D plasma-neutral interaction test.
# Wall recycling + volumetric chemistry on a DIII-D axi-symmetric geometry
# with a fixed SOLPS plasma background.  Writes per-cell {nD, nD2, Sp, Sm,
# Qe, Qi} so the source footprint is visible across the poloidal plane.
################################################################################

seed                12345
dimension           2
# Axi slot map: x = Z, y = R (axis at y = 0).
boundary            o ao p
global              gridcut 0.0 comm/sort no
global              fnum 5e15

create_box          -1.4 1.4 0.0 2.4 -0.05 0.05
create_grid         200 100 1
balance_grid        rcb cell

species             neutral.species D2 D D+
mixture             recmix D2 frac 0.95
mixture             recmix D  frac 0.05

# ---- Outer wall: diffuse reflection + TRIM-based surface reactions ----
read_surf           wall.surf invert group wall particle check
surf_collide        wallColl diffuse 23210.0 1.0
surf_react          wallPWI surface/pwi wall.recycle twall 23210.0
surf_modify         wall collide wallColl react wallPWI

# ---- Inner core absorb: psi_norm=0.95 contour from extract_psi_contour.py ----
read_surf           core.surf invert group core particle check
surf_collide        coreColl vanish
surf_modify         core collide coreColl

# ---- Static refinement near both divertors (max level 5) ----
region              rdiv_lo block -1.4 -0.8 1.0 2.4 -INF INF
region              rdiv_up block  0.7  1.4 1.0 2.4 -INF INF
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_lo all iterate 5
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_up all iterate 5
balance_grid        rcb cell

# ---- Plasma background + B-field ----
fix                 pd background file plasma.h5 static yes
global              pusher plasma pd
global              pcache_nevery 100

# ---- Volumetric chemistry (Mode A neutral transport) ----
# volume/chem/adas reads rates from database/processes.h5 (/volume/rates/)
# and the reaction list from database/adas/reactions/D.reactions.
# `output summary` emits 6 cols {Sp, Sm_xyz, Qe, Qi}.
fix fchem volume/chem/adas 10 D auto &
    mode neutral source_species D D2 &
    units rate &
    output summary

# ---- Wall recycling source ----
# Franck-Condon D at 2 eV; wall-thermalised D2 at 1500 K.
fix frec surface/emit/recycle recmix wall pd mass 2.0 R 0.99 &
    twall 23210.0 twall_species D 23210.0 D2 1500.0

# ---- Diagnostics (running averages for low MC noise) ----
# particle/weight + grid/weighted: nrho_w reads per-particle pweight so
# variable-weight decks (recycling, hot-surface emission) give correct
# density; reduces to plain nrho when every particle has weight 1.
fix pw particle/weight
compute cden grid/weighted all species nrho_w
fix    fden  ave/grid all 1 1000 1000 c_cden[*]  ave running
fix    frate ave/grid all 1 1000 1000 f_fchem[*] ave running
# fix fbal   balance 50 1.02 rcb part   # disabled for np>1 UAF bisect

# ---- Convergence monitors for stats output ----
compute rsp  reduce sum f_fchem[1]
compute rsmx reduce sum f_fchem[2]
compute rqe  reduce sum f_fchem[5]
compute rqi  reduce sum f_fchem[6]

# dt = 5 ns keeps CX-hot D below one cell per step in the strike-zone refinement.
timestep            5e-09
stats               500
stats_style         step cpu np c_rsp c_rsmx c_rqe c_rqi

# Dump schema: id xc yc xlo ylo xhi yhi
#              n_D2 n_D n_D+   Sp Sm_x Sm_y Sm_z Qe Qi
dump d1 grid all 1000 diii_d_neutrals.grid id xc yc &
     xlo ylo xhi yhi &
     f_fden[1] f_fden[2] f_fden[3] &
     f_frate[1] f_frate[2] f_frate[3] f_frate[4] &
     f_frate[5] f_frate[6]

run                 10000
