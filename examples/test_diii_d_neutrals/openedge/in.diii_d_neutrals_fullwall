################################################################################
# A5d: DIII-D neutrals with FULL-WALL recycling source, steady state.
#
# 1-to-1 with standalone EIRENE (SOLPS run_lore2023_reference): all 7 strata
# there become ONE emission group here — every wall segment emits D2 at a
# rate matched to SOLPS total dissociation 3.14e27 D2/s.
#
# Area-weighted (not yet flux-weighted): fix emit/surf distributes the
# group emission proportional to surface area across all 68 wall lines.
# Divertor targets (big area, high local plasma flux) dominate, which
# approximately matches the EIRENE stratum weighting.
#
# Returned-particle recycling: surf_react wall_pwi uses the same
# TRIM-backed model as test_west_neutrals (commit 553b934). Any particle
# reaching the wall neutralizes + reflects (from TRIM table) or gets
# absorbed + re-emitted as 95% D2 / 5% D at the wall temperature (400 K).
# R = 0.99 (1% pumped).
#
# Sizing (see scripts/NOTES_fnum.md):
#   fnum = 3e18       (~30-60k sim particles at steady state)
#   n    = 10 D2/step (across full wall group)
#   rate = n * fnum / dt = 3e27 D2/s  (matches SOLPS integral dissoc. source)
################################################################################

seed                12345
dimension           2
boundary            o o p
global              gridcut 0.0 comm/sort no
global              fnum 3e18

create_box          0.95 2.4 -1.4 1.4 -0.05 0.05
create_grid         100 200 1
balance_grid        rcb cell

species             ../input/neutral.species D2 D D+
mixture             puff_mix D2 frac 1.0 nrho 1e18 temp 300.0

# ---- Wall: TRIM-backed recycling for returning particles ----
read_surf           ../input/wall.surf group wall particle check
surf_collide        wallColl diffuse 400.0 1.0
surf_react          wallPWI wall_pwi ../input/wall.recycle &
                    trim_dir ../../../database/surface/trim &
                    twall 400.0
surf_modify         wall collide wallColl react wallPWI

# ---- Static refinement near both divertors (performance) ----
region              rdiv_lo block 1.0 2.4 -1.4 -0.8 -INF INF
region              rdiv_up block 1.0 2.4  0.7  1.4 -INF INF
adapt_grid          all refine surf all 0.005 maxlevel 3 cells 2 2 1 &
                    region rdiv_lo all iterate 3
adapt_grid          all refine surf all 0.005 maxlevel 3 cells 2 2 1 &
                    region rdiv_up all iterate 3
balance_grid        rcb cell

# ---- Plasma background ----
fix                 pd plasma/data file ../input/plasma.h5 static yes
global              bfield_compute pd

# ---- Volumetric chemistry (Mode A) ----
fix fchem chem/adas 1 1 ../input/neutral.reactions adas_dir ../../../database/adas &
    mode neutral source_species D D2 &
    units rate

# ---- D2 emission from the FULL wall (area-weighted) ----
fix fpuff emit/surf puff_mix wall n 10 normal yes perspecies no

# ---- Diagnostics (window-averaged over last 1000 steps) ----
compute cden grid all species nrho
fix    fden ave/grid all 1 1000 1000 c_cden[*] ave one
fix    frate ave/grid all 1 1000 1000 f_fchem[*] ave one

fix fbal   balance 500 1.1 rcb part

timestep            1e-8
stats               500
stats_style         step cpu np

dump d1 grid all 2000 ../output/diii_d_fullwall.grid id xc yc &
     f_fden[1] f_fden[2] &
     f_frate[1] f_frate[2] f_frate[3] f_frate[4]
dump_modify d1 pad 6

run                 10000
