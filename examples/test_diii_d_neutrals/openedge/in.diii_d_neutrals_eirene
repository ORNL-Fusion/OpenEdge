################################################################################
# A5d: DIII-D neutrals — EIRENE-faithful wall recycling.
#
# Uses fix emit/surf/recycle (Stage 1: thermal-only):
#   Per wall segment, queries (ne, Te, Ti) at the segment midpoint from
#   fix plasma/data. Computes Bohm flux Gamma = ne * cs * sin(alpha_B)
#   with cs = sqrt((Te+Ti)/m_ion), then emits mixture at rate
#     dot{N} = 0.5 * R * Gamma * area
#   (the 1/2 mass-balances D+ -> D2 recombination at the wall).
#   Mixture temp 400 K gives thermal Maxwellian-flux re-emission velocity.
#
# 1-to-1 with standalone EIRENE (eirene/fort.1.solps_ref): both codes
# drive recycling from the SAME plasma.h5, compute the SAME cs formula,
# use the SAME total recycling fraction R = 0.99. Stage 1 does NOT yet
# include TRIM fast-reflection (all recycled flux comes back thermal).
################################################################################

seed                12345
dimension           2
boundary            o o p
global              gridcut 0.0 comm/sort no
global              fnum 3e18

create_box          0.95 2.4 -1.4 1.4 -0.05 0.05
create_grid         100 200 1
balance_grid        rcb cell

species             ../input/neutral.species D2 D D+
# Recycling mixture: 95% D2 (molecular channel) + 5% D (atomic channel).
# SPARTA's `frac` applies to the single preceding species, so we set it in
# two separate mixture lines. Placeholder energy-averaged TRIM split
# (Stage 2 will make this dynamic from TRIM tables).
mixture             recmix D2 frac 0.95 temp 400.0
mixture             recmix D  frac 0.05

# ---- Wall: TRIM-backed return-path recycling ----
read_surf           ../input/wall.surf group wall particle check
surf_collide        wallColl diffuse 400.0 1.0
surf_react          wallPWI wall_pwi ../input/wall.recycle &
                    trim_dir ../../../database/surface/trim &
                    twall 400.0
surf_modify         wall collide wallColl react wallPWI

# ---- Static refinement near both divertors ----
region              rdiv_lo block 1.0 2.4 -1.4 -0.8 -INF INF
region              rdiv_up block 1.0 2.4  0.7  1.4 -INF INF
adapt_grid          all refine surf all 0.005 maxlevel 3 cells 2 2 1 &
                    region rdiv_lo all iterate 3
adapt_grid          all refine surf all 0.005 maxlevel 3 cells 2 2 1 &
                    region rdiv_up all iterate 3
balance_grid        rcb cell

# ---- Plasma background (same file EIRENE reads from via fort.13) ----
fix                 pd plasma/data file ../input/plasma.h5 static yes
global              bfield_compute pd

# ---- Volumetric chemistry (Mode A) ----
fix fchem chem/adas 1 1 ../input/neutral.reactions adas_dir ../../../database/adas &
    mode neutral source_species D D2 &
    units rate

# ---- EIRENE-faithful wall recycling source ----
fix frec emit/surf/recycle recmix wall pd mass 2.0 R 0.99 twall 400.0

# ---- Diagnostics ----
compute cden grid all species nrho
fix    fden ave/grid all 1 1000 1000 c_cden[*] ave one
fix    frate ave/grid all 1 1000 1000 f_fchem[*] ave one

fix fbal   balance 500 1.1 rcb part

timestep            1e-8
stats               200
stats_style         step cpu np

dump d1 grid all 2000 ../output/diii_d_eirene.grid id xc yc &
     f_fden[1] f_fden[2] &
     f_frate[1] f_frate[2] f_frate[3] f_frate[4]
dump_modify d1 pad 6

run                 10000
