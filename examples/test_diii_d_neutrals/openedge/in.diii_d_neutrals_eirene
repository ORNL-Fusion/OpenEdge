################################################################################
# A5d: DIII-D neutrals — EIRENE-faithful wall recycling.
#
# Uses fix emit/surf/recycle (Stage 1: thermal-only):
#   Per wall segment, queries (ne, Te, Ti) at the adjacent SOLPS plasma
#   cell (cached at init time via nearest-valid-cell lookup over the
#   plasma.h5 mesh — skips vacuum-filler triangles). Computes Bohm flux
#     Gamma = ne * cs * sin(alpha_B)    cs = sqrt((Te+Ti)/m_ion)
#   and emits mixture at rate
#     dot{N} = 0.5 * R * Gamma * area
#   (the 1/2 mass-balances D+ -> D2 recombination at the wall).
#   Emission velocity is Maxwellian flux at twall along inward normal.
#
# 1-to-1 with standalone EIRENE (eirene/fort.1.solps_ref): both codes
# drive recycling from the SAME plasma.h5, compute the SAME cs formula,
# use the SAME total recycling fraction R = 0.99. Stage 1 does NOT yet
# include TRIM fast-reflection (all recycled flux comes back thermal).
################################################################################

seed                12345
dimension           2
boundary            o o p
global              gridcut 0.0 comm/sort no
# With B2-face-area based Bohm flux, total rate ~5.5e24/s at
# sin(alpha)=1; effective ~5.5e23/s after the sin_alpha geometric factor.
# Target ~50 particles/step, ~50k at steady state (tau ~ 10 us):
#   fnum = rate * dt / n_per_step = 5.5e23 * 1e-8 / 50 ~ 1e14
global              fnum 1e14

create_box          0.95 2.4 -1.4 1.4 -0.05 0.05
create_grid         100 200 1
balance_grid        rcb cell

species             ../input/neutral.species D2 D D+
# Recycling mixture: 95% D2 (molecular channel) + 5% D (atomic channel).
# SPARTA's `frac` applies to the single preceding species, so we set it in
# two separate mixture lines. Placeholder energy-averaged TRIM split
# (Stage 2 will make this dynamic from TRIM tables).
# Recycled neutrals at Twall = 2 eV (23210 K) — matches the Franck-Condon
# thermal energy of D2 molecules and D atoms after wall processing.
mixture             recmix D2 frac 0.95 temp 23210.0
mixture             recmix D  frac 0.05

# ---- Wall: TRIM-backed return-path recycling ----
read_surf           ../input/wall.surf group wall particle check
surf_collide        wallColl diffuse 23210.0 1.0
surf_react          wallPWI wall_pwi ../input/wall.recycle &
                    trim_dir ../../../database/surface/trim &
                    twall 23210.0
surf_modify         wall collide wallColl react wallPWI

# ---- Static refinement near both divertors (CLAUDE.md perf recipe) ----
# maxlevel 5 + iterate 5: drive 5 levels of cell refinement around wall
# segments. This reduces surf-element count per cell and gives RCB enough
# granularity to subdivide the dense wall region across ranks.
region              rdiv_lo block 1.0 2.4 -1.4 -0.8 -INF INF
region              rdiv_up block 1.0 2.4  0.7  1.4 -INF INF
adapt_grid          all refine surf all 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_lo all iterate 5
adapt_grid          all refine surf all 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_up all iterate 5
balance_grid        rcb cell

# ---- Plasma background (same file EIRENE reads from via fort.13) ----
# Load the SOLPS equilibrium (.equ) so psi is available to fix reflect/psi.
fix                 pd plasma/data file ../input/plasma.h5 &
                    equilibrium ../input/dg.equ static yes
global              bfield_compute pd

# ---- EIRENE-style inner boundary: absorb neutrals crossing psi_norm<0.95 ----
# EIRENE's SOLPS-coupled inner radial surface acts as a core sink — neutrals
# crossing it are pumped (no core-side tracking). Apply the same BC here so
# OpenEdge's effective computational domain matches EIRENE's.
fix fcore reflect/psi plasma_data pd psi_norm 0.95 action absorb

# ---- Volumetric chemistry (Mode A) ----
fix fchem chem/adas 1 1 ../input/neutral.reactions adas_dir ../../../database/adas &
    mode neutral source_species D D2 &
    units rate

# ---- EIRENE-faithful wall recycling source ----
fix frec emit/surf/recycle recmix wall pd mass 2.0 R 0.99 twall 23210.0

# ---- Diagnostics ----
compute cden grid all species nrho
fix    fden ave/grid all 1 1000 1000 c_cden[*] ave one
fix    frate ave/grid all 1 1000 1000 f_fchem[*] ave one

# ---- Runtime adaptive refinement + load balance (CLAUDE.md perf recipe) ----
# MUST come after fix ave/grid (SPARTA ordering requirement).
# Refine cells that collect >500 particles to give RCB more granularity;
# run rcb-part balance every 500 steps. Together: 2-4x speedup on MPI.
# (rcb-time is avoided because it segfaults with idle ranks -- see memory.)
fix fadapt adapt 200 all refine particle 500 0 maxlevel 5 cells 2 2 1
fix fbal   balance 500 1.1 rcb part

timestep            1e-8
stats               200
stats_style         step cpu np

dump d1 grid all 2000 ../output/diii_d_eirene.grid id xc yc &
     f_fden[1] f_fden[2] &
     f_frate[1] f_frate[2] f_frate[3] f_frate[4]
dump_modify d1 pad 6

run                 30000
