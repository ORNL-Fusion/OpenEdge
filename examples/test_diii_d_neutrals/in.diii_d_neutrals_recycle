################################################################################
# A5c v3: DIII-D neutrals with divertor-distributed D2 puff.
#
# Simpler recycling proxy than v2 (which tried flux-weighted emit/surf/pmi
# and hit MPI issues). Here we puff D2 uniformly from the 17 lower-divertor
# wall lines (targets + baffles). Total puff rate set to qualitatively
# match SOLPS total ionization rate 4.66e27 /s (divided by 2 since each D2
# gives 2 D atoms upon dissociation).
#
# Expected result: the OpenEdge S_iz map should now show widespread
# ionization near the lower divertor and extending up the SOL -- closer to
# the EIRENE structure than the single-point-puff v1.
#
# Limitations still present:
#   - No spatial flux weighting (all 17 divertor lines emit at the same rate)
#   - No upper/inner wall emission
#   - No neutral-wall recycling via surf_react (absorbing walls again, so
#     D atoms that reach wall are lost -- simplification)
################################################################################

seed                12345
dimension           2
boundary            o o p
global              gridcut 0.0 comm/sort no
global              fnum 1e13

create_box          0.95 2.4 -1.4 1.4 -0.05 0.05
create_grid         200 400 1
balance_grid        rcb cell

species             input/neutral.species D2 D D+
mixture             puff_mix D2 frac 1.0 nrho 1e18 temp 300.0

# ---- Wall: absorbing ----
read_surf           input/wall.surf group wall particle check
surf_collide        wallColl vanish
surf_modify         wall collide wallColl react none

# ---- Define the lower divertor group (17 wall lines near the targets) ----
group div_lo surf id <= 7
group div_lo surf id >= 59

# ---- Plasma background ----
fix                 pd plasma/data file input/plasma.h5 static yes
global              bfield_compute pd

# ---- Volumetric chemistry (Mode A) ----
fix fchem chem/adas 1 1 input/neutral.reactions adas_dir ../../database/adas &
    mode neutral source_species D D2 &
    units rate

# ---- D2 puff from divertor (continuous, no exhaust) ----
# n=500 sim particles/step  x  17 div lines  =  8500 per step distributed
# across the group. Physical rate = 8500 * fnum / dt = 8500*1e13/1e-8
# = 8.5e24 D2/s (~ 1.7e25 D/s) ~ a fair fraction of SOLPS ionization
# total 4.66e27. Not matching exactly but gets the plume to be visible
# everywhere along the divertor.
fix fpuff emit/surf puff_mix div_lo n 100 normal yes perspecies no

# ---- Diagnostics ----
compute cden grid all species nrho
fix    fden ave/grid all 1 100 1000 c_cden[*] ave one
fix    frate ave/grid all 1 1000 1000 f_fchem[*] ave one

timestep            1e-8
stats               500
stats_style         step cpu np

dump d1 grid all 5000 output/diii_d_recycle.grid id xc yc &
     f_fden[1] f_fden[2] &
     f_frate[1] f_frate[2] f_frate[3] f_frate[4]
dump_modify d1 pad 6

run                 3000
