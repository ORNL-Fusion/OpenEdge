################################################################################
# A5c v4: DIII-D neutrals with divertor-distributed D2 puff, steady state.
#
# Puff D2 uniformly from the 17 lower-divertor wall lines. Total emission
# rate matched to SOLPS-EIRENE total dissociation source 3.14e27 D2/s
# (which equals ~half the total ionization 4.66e27 D/s, since each D2 gives
# 2 D). This is the closest continuous puff proxy to full recycling.
#
# Sizing (see NOTES_fnum.md):
#   fnum = 3e18        (targets ~30k sim particles alive at steady state,
#                       given divertor-geometry residence time ~1e-5 s)
#   n    = 10 D2/step  (total, distributed across div_lo group)
#   rate = n * fnum / dt = 10 * 3e18 / 1e-8 = 3e27 D2/s  (matches SOLPS)
#
# Grid: 100x200 base (20k cells) + runtime fadapt; coarser than v3 because
# with fnum=1e18 we only need ~30k sim particles and surf-check reduction
# matters more than cell resolution inside the plasma.
#
# Expected result (vs compare_to_eirene.png):
#   OpenEdge S_iz should now show widespread ionization near the lower
#   divertor + extending up into SOL, qualitatively matching EIRENE. Upper
#   and inner walls still dark (no emission there — still a limitation).
################################################################################

seed                12345
dimension           2
boundary            o o p
global              gridcut 0.0 comm/sort no
global              fnum 3e18

create_box          0.95 2.4 -1.4 1.4 -0.05 0.05
create_grid         100 200 1
balance_grid        rcb cell

species             input/neutral.species D2 D D+
mixture             puff_mix D2 frac 1.0 nrho 1e18 temp 300.0

# ---- Wall: absorbing ----
read_surf           input/wall.surf group wall particle check
surf_collide        wallColl vanish
surf_modify         wall collide wallColl react none

# ---- Define the lower divertor group (17 wall lines near the targets) ----
group div_lo surf id <= 7
group div_lo surf id >= 59

# ---- Static refinement near the lower divertor (performance) ----
region              rdiv_lo block 1.0 2.4 -1.4 -0.8 -INF INF
adapt_grid          all refine surf all 0.005 maxlevel 3 cells 2 2 1 &
                    region rdiv_lo all iterate 3
balance_grid        rcb cell

# ---- Plasma background ----
fix                 pd plasma/data file input/plasma.h5 static yes
global              bfield_compute pd

# ---- Volumetric chemistry (Mode A) ----
fix fchem chem/adas 1 1 input/neutral.reactions adas_dir ../../database/adas &
    mode neutral source_species D D2 &
    units rate

# ---- D2 puff from divertor (continuous, no exhaust) ----
fix fpuff emit/surf puff_mix div_lo n 10 normal yes perspecies no

# ---- Diagnostics (window-averaged over last 1000 steps) ----
compute cden grid all species nrho
fix    fden ave/grid all 1 1000 1000 c_cden[*] ave one
fix    frate ave/grid all 1 1000 1000 f_fchem[*] ave one

# ---- Runtime load balance ----
# (fadapt + rcb-time removed: caused rank-2 segfault at first balance step
#  when several ranks had zero particle work-time. Static adapt_grid at
#  setup + rcb-part every 500 steps is enough at this particle count.)
fix fbal   balance 500 1.1 rcb part

timestep            1e-8
stats               200
stats_style         step cpu np

dump d1 grid all 2000 output/diii_d_recycle.grid id xc yc &
     f_fden[1] f_fden[2] &
     f_frate[1] f_frate[2] f_frate[3] f_frate[4]
dump_modify d1 pad 6

run                 10000
