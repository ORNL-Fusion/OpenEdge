# ------------------------------------------------------------------------------
# OpenEdge/SPARTA Test: MPEX 45-degree single-particle hybrid Boris/GCA case
# Goal: generate a publication-ready trajectory showing pusher behavior toward
# the tilted target.
# ------------------------------------------------------------------------------

log output/log.mpex_45_gca.openedge

seed                 1245
dimension            3
boundary             o o o
global               gridcut 0.0 comm/sort no
global               fnum 1

create_box           0 0.1 0.0 0.1 0.0 0.2
create_grid          20 20 100
balance_grid         rcb part

species              input/plasma.species Ta Ta+ Ta2+ Ta3+ Ta4+ Ta5+
mixture              ions Ta4+ frac 1.0

read_particles       input/source.single 0

read_surf            surfaces/target_45deg_Te.txt custom temp float 0 group 1 particle check
surf_collide         targetCollideModel vanish log yes file output/target_vanish_gca_45.csv
surf_modify          1 collide targetCollideModel react none

read_surf            surfaces/skimmer_ring.txt group 2 particle check
surf_collide         skimmerCollideModel vanish
surf_modify          2 collide skimmerCollideModel react none


fix      pd background file input/plasma.h5 static yes
compute cgeom sheath/geometry/grid all 1 dist surfid nx ny nz

