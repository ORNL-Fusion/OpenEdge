log output/log.mpex_45_main.openedge

variable fnum         equal 1e8 #1e5
variable time         equal 0.1
variable dt           equal 1e-07 
variable N            equal floor(${time}/${dt})
variable Nfreq        equal floor(${N}/20)
variable dumpEvery    equal floor(${N}/20)

seed                 1245
dimension            3
boundary             o o o
global               gridcut 0.0 comm/style neigh comm/sort no
create_box           -0.002 0.102 -0.002 0.102 -0.002 0.202
create_grid          20 20 100
balance_grid         block * * *

global               fnum ${fnum}

species              input/plasma.species Ta Ta+ Ta2+ Ta3+ Ta4+ Ta5+
mixture              TantalumSource Ta   frac 0.00
mixture              TantalumSource Ta+  frac 0.00
mixture              TantalumSource Ta2+ frac 0.08
mixture              TantalumSource Ta3+ frac 0.62
mixture              TantalumSource Ta4+ frac 0.30
mixture              TantalumSource Ta5+ frac 0.00
mixture              TantalumSource vstream 0.0 0.0 1000.0

read_surf            surfaces/target_45deg_Te.txt custom temp float 0 group target particle check
surf_collide         tgt vanish log yes file output/target_vanish_45.csv
surf_modify          target collide tgt react none

read_surf            surfaces/skimmer_ring.txt group skimmer particle check
surf_collide         skm vanish
surf_modify          skimmer collide skm react none

read_surf            surfaces/source_plate.txt group source particle check transparent
surf_collide         srcPass transparent
surf_modify          source collide srcPass

include              surfaces/include_surf_ids_45
group                exposedTarget_45 surf id <> ${case_min} ${case_max}

group                wall surf subtract all source

fix      pd  background file input/plasma.h5 column_axis 0.05 0.05 static yes
compute  cpf plasma/fields all background pd br bt bz
#fix      pw  particle/weight
global   pusher mode hybrid plasma cpf subcycles 1 gca_switch 0.001 sheath off
#global   pusher mode boris plasma cpf subcycles 1 sheath off

fix      femit surface/emit/source TantalumSource source file input/ta_inlet.dat section ZLO model thompson 8.1

#dump     dstate particle all ${dumpEvery} output/state.45.dump id type x y z vx vy vz

compute  cRho grid all species nrho
fix      fRho ave/grid all 1 ${Nfreq} ${Nfreq} c_cRho[*] ave running
#dump     dRho grid all ${Nfreq} output/ta_density.45.grid id xc yc zc f_fRho[*]

#compute  cSurfAll surf exposedTarget_45 all nflux_incident mflux etot press ke shx shy shz px py pz
#fix      fSurfAll ave/surf exposedTarget_45 1 ${Nfreq} ${Nfreq} c_cSurfAll[*]
#dump     dSurfAll surf wall ${Nfreq} output/surface_diag.45.surf id v1x v1y v1z v2x v2y v2z v3x v3y v3z area f_fSurfAll[*]

variable npart equal np

timestep   ${dt}
stats_style step time cpu np
stats      100
run        1000

fix        31 halt ${Nfreq} v_npart <= 100
unfix      femit

stats      ${Nfreq}
#run        ${N}
