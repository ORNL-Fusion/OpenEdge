# ------------------------------------------------------------------------------
# OpenEdge/SPARTA Test: MPEX 45-degree sheath/grid case
# Goal: generate adaptive near-target grid and sheath field dumps for a
# publication-quality target-tilt slice.
# ------------------------------------------------------------------------------

log output/log.sheath_45deg.openedge

seed                 1245
dimension            3
boundary             o o o
global               gridcut 0 comm/sort no
create_box           0 0.1 0.0 0.1 0.0 0.2
create_grid          20 20 2200
balance_grid         rcb cell

species              input/plasma.species Ta Ta+ Ta2+ Ta3+ Ta4+ Ta5+
mixture              dummy Ta frac 1.0

read_surf            surfaces/target_45deg_Te.txt custom temp float 0 group 1 particle check
surf_collide         wallModel specular
surf_modify          all collide wallModel react none

include              surfaces/include_surf_ids_45
group                exposedTarget_45 surf id <> ${case_min} ${case_max}

fix      pd background file input/plasma.h5 static yes
compute  cplasma plasma/fields all background pd br bt bz dens_e dens_i temp_e temp_i parrflow
compute cgeom sheath/geometry/grid all exposedTarget_45 dist surfid nx ny nz

adapt_grid all refine value c_cgeom[1] 3.0e-3 0.0 thresh less more iterate 1 maxlevel 3 cells 1 1 2
balance_grid         rcb cell
uncompute cgeom
compute cgeom sheath/geometry/grid all exposedTarget_45 dist surfid nx ny nz

adapt_grid all refine value c_cgeom[1] 1.8e-3 0.0 thresh less more iterate 1 maxlevel 4 cells 1 2 2
balance_grid         rcb cell
uncompute cgeom
compute cgeom sheath/geometry/grid all exposedTarget_45 dist surfid nx ny nz

adapt_grid all refine value c_cgeom[1] 1.0e-3 0.0 thresh less more iterate 1 maxlevel 4 cells 1 2 2
balance_grid         rcb cell
uncompute cgeom
compute cgeom sheath/geometry/grid all exposedTarget_45 dist surfid nx ny nz

adapt_grid all refine value c_cgeom[1] 6.0e-4 0.0 thresh less more iterate 1 maxlevel 4 cells 1 2 2
balance_grid         rcb cell
uncompute cgeom
compute cgeom sheath/geometry/grid all exposedTarget_45 dist surfid nx ny nz

adapt_grid all refine value c_cgeom[1] 3.0e-4 0.0 thresh less more iterate 1 maxlevel 4 cells 1 2 2
balance_grid         rcb cell
uncompute cgeom
compute cgeom sheath/geometry/grid all exposedTarget_45 dist surfid nx ny nz

uncompute cgeom
compute cgeom sheath/geometry/grid all exposedTarget_45 dist surfid nx ny nz

compute csheath sheath/fields/grid all cplasma cgeom model stangeby pot_mult 0 dmax 3.0e-3 mach_min -10 mach_max 10 bdotn_max -1.0e-8 values ex ey ez esheath mach_par mach_n alpha active bdotn dist surfid lambdad rhoi phi_ds phi_cs

dump     dsh grid all 1 output/sheath_45deg.grid id xc yc zc c_cgeom[*] c_csheath[*] c_cplasma[*]

timestep 1e-9
stats    1
stats_style step cpu np
run      1

write_grid output/grid_45
