shell       mkdir output

seed        12345
dimension   2
boundary    o o p
global      gridcut 0.0 comm/sort no
global      fnum 1e+14
timestep    5e-05

create_box  3.1 3.5 -3.8 -3.1 -0.05 0.05
create_grid 100 100 1
balance_grid rcb cell

species     input/droplet.species droplet
mixture     droplet droplet frac 1.0 nrho 1.0e19 temp 300.0 vstream 0.0 0.0 0.0

read_surf   input/divertor_slab_strip.surf custom Tsurf_lm float 0 custom Gamma_D_lm float 0 &
            invert group slab particle check
group div_front surf id <> 1 199
group div_back  surf id <> 200 202

surf_collide vac specular
surf_modify  slab collide vac

# plasma background from SOLPS-derived plasma.h5
fix pd background file input/plasma.h5 static yes

# Alternate: solve Tsurf at runtime (use divertor_slab.surf for read_surf).
#fix flm_ol surface/state/lm div_front 1 solps_b2pl input/ld_tg_o.dat &
#           h0 5.0e-3 U0 8.0 Bs 5.0 alpha 43.0 width 1.67 Tin 350.0 static yes csv output/strip_ol.csv

compute cevap  surface/chemical/evaporation div_front tsurf Tsurf_lm sticking 1
compute cadat  surface/chemical/adatom      div_front tsurf Tsurf_lm dp_flux s_Gamma_D_lm
# total erosion + per-species (D=1, Ne+=2..Ne10+=11, Li+=12..Li3+=14).
# `projectile_slots 1 14` overrides the default lo=2 so D+ (slot 1) is
# included in the `all` expansion of sputter_flux_species.
compute cpmiLi surface/physical/sputter     div_front background pd &
               target Li projectiles D,Ne,Li us 1.0 iead auto static yes &
               projectile_slots 1 14 erosion_flux sputter_flux_species all

#fix femit_ev surface/emit/source droplet div_front cevap perspecies no normal yes nevery 100 model thermal_tsurf Tsurf_lm
#fix femit_ad surface/emit/source droplet div_front cadat perspecies no normal yes nevery 100 model thermal_tsurf Tsurf_lm
# Sputter emission (commented). cpmiLi[1] = erosion_flux total. Use Thompson
# energy with U_s=1.65 eV (Li surface binding) and over-cosine angular factor.
#fix femit_sp surface/emit/source droplet div_front c_cpmiLi[1] perspecies no normal yes nevery 100 model thompson 1.65 cos_n 1.5
fix fdrop droplet/emit droplet div_front nevery 1 n 10 perspecies no normal no vmin 0.1 vmax 20 angle cosine

# droplet forces — comment out any you don't want
fix fcharge droplet/charge   1 background pd ion_mass_amu 2.0 thermionic no mixture droplet
fix fdrag   droplet/drag     1 2.0 1 background pd model coulomb coulomb/lnlambda 10 &
                             gravity 0 -9.8 0 mixture droplet
fix fevap   droplet/evaporate 1 droplet background pd heatflux/scale 1.0 rocket_eta 0.5

# cumulative real Li atoms evaporated from all droplets (f_fevap scalar)
fix devap_tot ave/time 100 1 100 f_fevap file output/droplet_evap_total.csv

# per-step particle dump (droplet trajectories)
dump dpart particle all 10 output/dump.txt id type x y z vx vy vz radius temp

# cpmiLi columns: [1]=erosion_flux total, [2..15]=per-species in plasma-slot
# order (D+, Ne+..Ne10+, Li+..Li3+).
dump dsurf surf div_front 100 output/surf_flux.* &
     id v1x v1y v2x v2y c_cevap c_cadat c_cpmiLi[*] &
     s_Tsurf_lm s_Gamma_D_lm

stats       1
stats_style step np
run 2

stats_style step np

# stop emitting new droplets after the warm-up
unfix  fdrop

variable npart equal np
fix halt_drops halt 100 v_npart <= 0

stats       100
run         10000
