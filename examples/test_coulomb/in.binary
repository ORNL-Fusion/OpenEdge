################################################################################
# Nanbu Coulomb collision test: thermal equilibration
#
# D+ (hot, 5000 particles) and C3+ (cold, 5000 particles) ions are
# initialized at different temperatures (10 eV and 5 eV) and allowed
# to collide in a periodic box via binary Nanbu-Takizuka Coulomb scattering.
#
# Expected result: the two populations relax toward a common equilibrium
# temperature (~7.5 eV) on the Spitzer cross-species equipartition timescale.
#
# Physical density: N*fnum/V = 10000*1e7/1e-6 = 1e17 m^-3
# With T~7.5 eV, n~5e16 per species, lnL~13:  tau_eq ~ 90-100 us
# At dt=1e-8 s and 400000 steps (4000 us), several tau of thermalization is visible.
#
# Momentum is conserved exactly per pair; total kinetic energy
# is approximately conserved (small fluctuations from stochastic scatter).
#
# Usage:
#     mpirun -np 4 spa_mpi -in in.nanbu_thermalize
################################################################################

# ---- Physical parameters (Te/ne only, for the Coulomb log) ----
variable        Te      equal 10.0          # background electron temperature [eV]
variable        ne      equal 1.0e18        # background electron density [m^-3]

# ---- Simulation setup ----
seed            12345
dimension       3
units           si
boundary        p p p
global          gridcut 0.0 comm/sort yes
global          fnum 1.0e07
global          move no

shell           mkdir -p output

# Domain: 1 cm^3 cube
create_box      0.0 0.01 0.0 0.01 0.0 0.01
create_grid     5 5 5
balance_grid    rcb cell

# ---- Species and mixtures ----
species         plasma.species D+ C3+

# Hot and cold mixtures for two-population initialization
mixture         hot  D+ frac 1.0
mixture         hot  temp 116045.2         # 10 eV

mixture         cold C3+ frac 1.0
mixture         cold temp 58022.6          # 5 eV

# ---- Plasma data (Te, ne only -- no background partner for binary test) ----
fix             pd background constant &
                te ${Te} ne ${ne} &
                static yes

# ---- Nanbu Coulomb collisions (binary D+ <-> C3+, no background) ----
fix             nanbu coulomb/binary 1 background pd

# ---- Create two populations at different temperatures ----
create_particles hot  n 5000
create_particles cold n 5000

# ---- Diagnostics ----
# Per-species temperature: c_ctemp[1]=D+, c_ctemp[2]=C3+
compute         ctemp grid all species temp
compute         Tavg_1 reduce ave c_ctemp[1]
compute         Tavg_2 reduce ave c_ctemp[2]

# Particle tracks (sample every 1000 steps)
#dump            dpart particle all 10000 output/particles id type x y z vx vy vz

# ---- Time integration ----
timestep        1.0e-8
stats           5000
stats_style     step cpu np c_Tavg_1 c_Tavg_2

# ---- Run ----
run             1000
