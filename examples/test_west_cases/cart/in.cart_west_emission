# WEST Cartesian (planar) W: geometry-mode variant of ../axi for the axi-vs-
# cart comparison (identical physics; planar slabs vs 2piR rings; rz_axes axi).
# Short runs: -var nwarm 20000 -var ndiag 5000 -var sourceThreshW 1e5

variable            nlaunchPerSurfW index 1
variable            sourceThreshW index 1e6
variable            emitEvery equal 100
variable            nwarm index 500000
variable            ndiag index 50000
variable            navge equal v_ndiag/100
variable            nvito index 5000        # OVITO dump interval

seed                12345
dimension           2
boundary            o oo p                              # x=Z, y=R (PLANAR, no axis)
global              gridcut 0.0 comm/sort no
shell               mkdir -p state                      # state/ is git-ignored

create_box          -1.00 0.85 0.0 3.25 -0.05 0.05
create_grid         200 150 1
balance_grid        rcb cell

species input/plasma.species W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+
mixture             tungstenSource  W    frac 1.
mixture             tungstenSource  W+   frac 0.
mixture             tungstenSource  W2+  frac 0.
mixture             tungstenSource  W3+  frac 0.
mixture             tungstenSource  W4+  frac 0.
mixture             tungstenSource  W5+  frac 0.
mixture             tungstenSource  W6+  frac 0.
mixture             tungstenSource  W7+  frac 0.
mixture             tungstenSource  W8+  frac 0.
mixture             tungstenSource  W9+  frac 0.
mixture             tungstenSource  W10+ frac 0.

read_surf           input/wall_fine.surf invert group wall particle check
variable            TwallK  equal 773.15
variable            TbindW  equal 4.*11600.
surf_collide        wallColl diffuse ${TbindW} 1.0
surf_react          wallPWI surface/pwi input/wall.recycle twall ${TwallK}
surf_modify         wall collide wallColl react wallPWI

read_surf           input/core.surf group core particle check
surf_collide        coreColl vanish
surf_modify         core collide coreColl

region              rdiv_lo block -1.00 -0.45 1.90 3.20 -INF INF
region              rdiv_up block  0.35  0.85 1.90 3.20 -INF INF
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_lo all iterate 5
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_up all iterate 5
balance_grid        rcb cell

fix                 pd background file input/plasma.h5 static yes rz_axes axi
global              pcache_nevery 100

compute             cgeom nearest_surf/grid all wall dist surfid nx ny nz
global              pusher plasma pd mode boris &
                    subcycles 10 bad_dt_check yes bad_dt_limit 0.5 &
                    sheath boundary geom cgeom mD_amu 2.0 &
                    dump no

variable            Dperp index 0.1
fix                 fcd cross_field_diffusion 1 background pd D_perp ${Dperp}

fix                 fcoul coulomb/background 1 background pd 2.0 1.0

compute cpmiO surface/physical/sputter wall background pd &
                    target W projectiles O &
                    mass_amu 2.01410177811 static yes &
                    erosion_flux

fix pw particle/weight

fix femit surface/emit/source tungstenSource wall cpmiO perspecies no &
                    nlaunch ${nlaunchPerSurfW} source_thresh ${sourceThreshW} &
                    model thompson 4.4 nevery ${emitEvery}

fix fchem volume/chem/adas 1 W auto

variable            dt equal 5e-9
timestep            ${dt}
stats               500

mixture allW W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+ group wsum
compute cwn    grid/weighted all allW n_w
compute cwNtot reduce sum c_cwn[1]
compute cwsp   grid/weighted all species n_w
compute cwN0  reduce sum c_cwsp[1]
compute cwN1  reduce sum c_cwsp[2]
compute cwN2  reduce sum c_cwsp[3]
compute cwN3  reduce sum c_cwsp[4]
compute cwN4  reduce sum c_cwsp[5]
compute cwN5  reduce sum c_cwsp[6]
compute cwN6  reduce sum c_cwsp[7]
compute cwN7  reduce sum c_cwsp[8]
compute cwN8  reduce sum c_cwsp[9]
compute cwN9  reduce sum c_cwsp[10]
compute cwN10 reduce sum c_cwsp[11]
stats_style         step cpu np c_cwNtot &
                    c_cwN0 c_cwN1 c_cwN2 c_cwN3 c_cwN4 c_cwN5 &
                    c_cwN6 c_cwN7 c_cwN8 c_cwN9 c_cwN10

fix                 fadapt adapt 500 all refine particle 8 2 maxlevel 5
fix                 fbal balance 1000 1.1 rcb part

dump                dovito particle all ${nvito} state/ovito.D${Dperp}.dump &
                    id type x y z

run                 ${nwarm}
write_restart       state/warmup.D${Dperp}.restart

unfix               fadapt
reset_timestep      0

compute cwtot grid/weighted all allW nrho_w
fix     fwgrid ave/grid all ${navge} 100 ${ndiag} c_cwtot[1] ave one
dump    dwgrid grid all ${ndiag} state/grid.dens.west.D${Dperp} &
                    id xc yc xlo ylo xhi yhi f_fwgrid

mixture neutralW W group w0
compute cwneut grid/weighted all neutralW nrho_w
fix     fw0 ave/grid all ${navge} 100 ${ndiag} c_cwneut[1] ave one
dump    dw0 grid all ${ndiag} state/ndens0.west.D${Dperp} &
                    id xc yc c_cgeom[1] f_fw0

compute cero surface/physical/sputter wall background pd &
                    target W projectiles O &
                    mass_amu 2.01410177811 static yes &
                    erosion_flux erosion_rate
compute cdep surf/weighted wall allW nflux nflux_incident
fix     fdep ave/surf wall ${navge} 100 ${ndiag} c_cdep[1] c_cdep[2]
dump    dwflux surf wall ${ndiag} state/wall.flux.west.D${Dperp} &
                    id v1x v1y v2x v2y c_cero[1] c_cero[2] f_fdep[1] f_fdep[2]

compute closs surf/weighted core allW nflux
fix     floss ave/surf core ${navge} 100 ${ndiag} c_closs[1]
dump    dcore surf core ${ndiag} state/core.flux.west.D${Dperp} &
                    id v1x v1y v2x v2y f_floss

compute cimpact impact/energy wall allW 48 1.0 3000.0 log
fix     fimpact ave/time ${navge} 100 ${ndiag} c_cimpact mode vector ave one &
                    file state/impact.hist.west.D${Dperp}

dump 10 particle all 1000 state/state_cart id type x y z

run                 ${ndiag}
