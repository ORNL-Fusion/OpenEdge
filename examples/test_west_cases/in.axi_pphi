# Canonical toroidal angular momentum conservation test for the axi kick-drift
# mover. Uniform AXIAL B (B = B0 x-hat) -> ions gyrate in the (R, phi) plane.
# Invariant p_phi = m*R*v_phi + q*psi, psi = R*A_phi = B0*R^2/2. Axi slot map:
# x=Z(axial), y=R, z=phi so R=y, v_phi=vz. Pure Boris -> p_phi conserved per
# particle to integrator precision (secular drift ~1e-4 over ~1500 gyroperiods).

seed                12345
dimension           2
boundary            r ar p
global              gridcut 0.0 comm/sort no
global              fnum 1e10
create_box          -0.5 0.5 0.0 0.4 -0.05 0.05
create_grid         40 32 1
balance_grid        rcb part

species             plasma.species H+
mixture             ions H+ frac 1.0 temp 580225.0      # 50 eV
create_particles    ions n 500

variable B0         equal 0.05                          # [T], axial
variable Bx         particle "v_B0"
variable By         particle "0.0"
variable Bz         particle "0.0"
fix                 fB bfield/particle Bx By Bz
global              bfield particle fB 0
global              pusher subcycles 10 bad_dt_check yes bad_dt_limit 0.5

# per-particle R(=y) and v_phi(=vz) over time -> p_phi in post
dump                dpp particle all 200 pphi.dat id x y vx vz

timestep            1e-7
stats               2000
compute             T temp
stats_style         step cpu np c_T
run                 20000
