# Drag regression unit test — 4 cases with constant uniform fields (no HDF5 files)
#
# Case 1: Ni=0          → nuE=0    → pure gravity only
# Case 2: Bz_cyl=1 T    → drag in Z toward Vpar=1000 m/s (nuE≈87 s⁻¹)
# Case 3: Bt=1 T        → drag toroidal only → no drag in R or Z (no cylindrical)
# Case 4: Bt=1 T        → drag toroidal + cylindrical yes → centrifugal pushes R outward
#
# Key regression checks:
#   Case 3 vZ ≈ g/nuE = -0.11 m/s  (B-component swap bug regression)
#   Case 4 vR > 0  (centrifugal term pushes outward)
#   Case 4 vR >> Case 1 vR  (gravity-only has no outward push)
#
# Run:      spa_mpi -in in.drag_unit
# Validate: python validate_drag.py

variable case index 1 2 3 4

variable dt     equal 1e-6
variable N      equal 1000
variable Ndump  equal 1

variable temp_d equal 773.15
variable rd     equal 1.0e-6
variable md     equal 2.237e-15   # (4/3)*pi*(1e-6)^3 * 534 kg/m^3

seed             42
timestep         ${dt}
dimension        2
boundary         p p p
global           gridcut 0.0 comm/sort no
global           temp 1.0e20
create_box       2.0 6.0 -1.0 1.0 -0.05 0.05
create_grid      40 20 1
balance_grid     rcb cell

species          droplet.species Instability
mixture          src Instability frac 1.0 nrho 1
variable         pmass particle mass

read_particles   source_unit 0

dump dtraj particle all ${Ndump} case.unit.${case} id type x y z vx vy vz v_pmass temp radius

# ── Case-specific compute (constant mode, no HDF5 files) ─────────────────────
# Output column map (same as in.drag_compare):
#   [1]=bx  [2]=by  [3]=bz  [4]=Te  [5]=Ne  [6]=Ti  [7]=Ni  [8]=Vpar
#
# fix_drag call:  plasma c[4]  c[6]  c[7]  c[8]
#                         Te    Ti    Ni   Vpar
#                 bfield  c[1]  c[3]  c[2]
#                          Br    Bt    Bz_cyl
#
# magnetic_field keyword order: Br  Bt_toroidal  Bz_cylindrical
# In 2D the compute maps: bx=Br, by=Bz_cyl, bz=Bt_toroidal

# Case 1: Ni=0 → nuE=0 regardless of B → pure gravity
if "${case} == 1" then &
    "compute cnear plasma/fields all constant magnetic_field 0.0 0.0 0.0 temp_e 100.0 dens_e 0.0 temp_i 100.0 dens_i 0.0 parrflow 0.0 bx by bz temp_e dens_e temp_i dens_i parrflow"

# Case 2: Bz_cyl=1 T → by=1 → srcBz=c[2]=1 → upar[1]=Vpar*1=1000 m/s (drag in Z)
if "${case} == 2" then &
    "compute cnear plasma/fields all constant magnetic_field 0.0 0.0 1.0 temp_e 100.0 dens_e 1.0e20 temp_i 100.0 dens_i 1.0e20 parrflow 1000.0 bx by bz temp_e dens_e temp_i dens_i parrflow"

# Case 3: Bt=1 T (toroidal) → no cylindrical → no centrifugal → pure gravity in RZ
if "${case} == 3" then &
    "compute cnear plasma/fields all constant magnetic_field 0.0 1.0 0.0 temp_e 100.0 dens_e 1.0e20 temp_i 100.0 dens_i 1.0e20 parrflow 1000.0 bx by bz temp_e dens_e temp_i dens_i parrflow"

# Case 4: Bt=1 T (toroidal) + cylindrical yes → centrifugal v_φ²/R pushes R outward
if "${case} == 4" then &
    "compute cnear plasma/fields all constant magnetic_field 0.0 1.0 0.0 temp_e 100.0 dens_e 1.0e20 temp_i 100.0 dens_i 1.0e20 parrflow 1000.0 bx by bz temp_e dens_e temp_i dens_i parrflow"

# Drag + gravity — Cases 1-3: no cylindrical term
if "${case} == 1" then &
    "fix fdrag drag 1 2.0 1 plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] bfield c_cnear[1] c_cnear[3] c_cnear[2] gravity 0 -9.8 0 model epstein mass ${md} radius ${rd} temp ${temp_d}"
if "${case} == 2" then &
    "fix fdrag drag 1 2.0 1 plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] bfield c_cnear[1] c_cnear[3] c_cnear[2] gravity 0 -9.8 0 model epstein mass ${md} radius ${rd} temp ${temp_d}"
if "${case} == 3" then &
    "fix fdrag drag 1 2.0 1 plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] bfield c_cnear[1] c_cnear[3] c_cnear[2] gravity 0 -9.8 0 model epstein mass ${md} radius ${rd} temp ${temp_d}"

# Case 4: cylindrical yes enables centrifugal + angular-momentum terms
if "${case} == 4" then &
    "fix fdrag drag 1 2.0 1 plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] bfield c_cnear[1] c_cnear[3] c_cnear[2] gravity 0 -9.8 0 model epstein mass ${md} radius ${rd} temp ${temp_d} cylindrical yes"

stats    100
run      ${N}

clear
next case
jump in.drag_unit
