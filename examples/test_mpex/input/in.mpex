# ------------------------------------------------------------------------------
#  OpenEdge/SPARTA Test: MPEX case
# ------------------------------------------------------------------------------
#  Purpose:
#    MPEX challenge
#
#  Description:
#
# ------------------------------------------------------------------------------
log     output/log.openedge

variable           case index 0 45 85



log log.openedge.case.${case}

variable realDensity  equal 1e17
variable fnum         equal 1e09
variable time         equal 0.0005
variable dt           equal 5e-08
variable N            equal 10 #floor(${time}/${dt})
variable Nfreq        equal 1 #floor(${N}/100)

global nrho 1e16

################################################################################
# --- Simulation domain and global setup ---------------------------------------
################################################################################
seed                 1245
dimension            3
boundary             o o o
global               gridcut 0 comm/sort no
create_box           0 0.1 0. 0.1 0.0 0.2
create_grid          10 10 500
balance_grid         rcb cell

# normalized density and number scaling
global               fnum ${fnum}
species              input/plasma.species Ta Ta+ Ta2+ Ta3+ Ta4+ Ta5+ # Ta6+ Ta7+ Ta8+ Ta9+ Ta10+

mixture             TantalumSource  Ta   frac 0.0
mixture             TantalumSource  Ta+  frac 0.0
mixture             TantalumSource  Ta2+ frac 0.08
mixture             TantalumSource  Ta3+ frac 0.62
mixture             TantalumSource  Ta4+ frac 0.30
mixture             TantalumSource  Ta5+  frac 0.
#mixture             TantalumSource  Ta6+  frac 0.
#mixture             TantalumSource  Ta7+  frac 0.
#mixture             TantalumSource  Ta8+  frac 0.
#mixture             TantalumSource  Ta9+  frac 0.
#mixture             TantalumSource  Ta10+ frac 0.

# read in skimmer geometry file

# read in target geometry file
read_surf           surfaces/target_${case}deg_Te.txt custom temp float 0 group 1 particle check

surf_collide        targetCollideModel diffuse s_temp 0.1
surf_react          TaOnW mpex input/plasma.reactions
surf_modify         1 collide targetCollideModel react TaOnW

read_surf           surfaces/skimmer_ring.txt group 3 particle check
surf_collide        skimmerCollideModel vanish
surf_modify         3 collide skimmerCollideModel react none


# define electron density/temperature
variable r0  equal 0.02
variable ne0 equal 1e19
variable te0 equal 1.0
variable te1 equal 4.0

variable eps equal 1e-10

# cell centers
variable xc  grid 0.5*(cxlo+cxhi)
variable yc  grid 0.5*(cylo+cyhi)
variable zc  grid 0.5*(czlo+czhi)

# plasma column axis at box center
variable x0  equal 0.5*(xlo+xhi)
variable y0  equal 0.5*(ylo+yhi)

# radius measured from axis (x0,y0)
variable r   grid "sqrt((v_xc - v_x0)*(v_xc - v_x0) + (v_yc - v_y0)*(v_yc - v_y0) + v_eps)"

variable ne  grid "v_ne0*exp(-(v_r/v_r0)^12)"
variable te  grid "v_te0+v_te1*exp(-(v_r/v_r0)^12)"

# Magnetic field components

include surfaces/include_surf_ids_${case}
group exposedTarget_${case} surf id <> ${case_min} ${case_max}

compute cnear plasma/fields/file all input/plasma.h5 input/bfield.h5 ex ey ez # temp_e dens_e

# Tantalatum emission from ZLO face
fix            in emit/face/file TantalumSource zlo input/ta_inlet.dat ZLO 

# Register field fixes and make them global
variable Bx grid "0"
variable By grid "0"
variable Bz grid "0.5"


fix       2 bfield/grid Bx By Bz
global    bfield grid 2 0

fix       3 efield/grid c_cnear[1] c_cnear[2] c_cnear[3]
global    efield grid 3 0

fix 22 chem/adas 1 73 input/plasma.adas plasma te ne


################################################################################
# --- Diagnostics and execution ------------------------------------------------
################################################################################

compute 1 temp
compute 2 grid all TantalumSource temp
compute 3 reduce ave c_2[*]

# dump particles for the movie/paraview
dump      10 particle all ${Nfreq} output/state.${case} id type x y z vx vy vz


# dump density distribution to plot 1D spatial distribution
compute computeID grid all species nrho
fix     fixID ave/grid all 1 ${Nfreq} ${Nfreq} c_computeID[*] ave running
dump    dumpID  grid all ${N} output/tmp.grid.density.${case}  id xc yc zc f_fixID[*]

# dump total kinetic energy to monitor energy conservation
compute 4 ke/particle
compute 4a reduce ave c_4[*]
timestep  ${dt}
stats     ${Nfreq}
stats_style step time cpu c_1 c_3 c_4a np

# other diagnotics
# Energy and angle distribution at all surfaces: 


# ---- Computes: per mixture and all-species
compute 2b surf all all nflux_incident mflux etot press ke shx shy shz px py pz
fix     f_all ave/surf all 1 ${Nfreq} ${Nfreq} c_2b[*] ave running
dump    d_all  surf all ${N} output/tmp.all.surf.${case} id  v1x v1y v1z v2x v2y v2z v3x v3y v3z area f_f_all[*]


#run 2 pre yes post no

run    $N

clear
next case
jump input/in.mpex
