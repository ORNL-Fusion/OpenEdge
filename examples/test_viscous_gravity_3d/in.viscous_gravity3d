seed                12345
dimension           3
boundary            p p o
global              gridcut 0.0 comm/sort no

create_box          -1.0 1.0  -1.0 1.0  -5.0 5.0
create_grid         8 8 8
balance_grid        rcb cell

species             droplet.species Li
read_particles      source.1 0
variable pmass particle mass

# Constant plasma/B inputs for viscous drag
variable te grid "10"
variable ti grid "10"
variable ni grid "1.0e20"
variable vp grid "0"
variable Br grid "0"
variable Bt grid "0"
variable Bz grid "0"

# Drag + gravity in 3D Cartesian
fix fvis viscous 1 2.0 1 plasma te ti ni vp bfield Br Bt Bz gravity 0 0 -9.81

timestep            1.0e-3
stats               20
stats_style         step cpu np

dump d1 particle all 1 dump.viscous_gravity3d id type x y z vx vy vz v_pmass temp radius
run                 400
