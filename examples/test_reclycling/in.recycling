################################################################################
# D/D2/D+ neutral transport with surface recycling
# 2D axisymmetric WEST-like geometry
#
# Physics:
#   - D2 dissociation (Janev HYDHEL H.2 2.2.5)
#   - D ionization (ADAS SCD, Z=1)
#   - D+/D charge exchange (ADAS CCD, Z=1)
#   - Surface recycling: D+ -> D at 3 eV (Franck-Condon), cosine distribution
#   - Boris pusher for D+ ions
################################################################################

seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
global              fnum 1e12

create_box          2.0 6.0 -4.0 3.8 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

# ---- Species ----
species             neutral.species D2 D D+
mixture             neutrals D2  frac 1.0
mixture             neutrals D   frac 0.0
mixture             neutrals D+  frac 0.0

# ---- Surfaces ----
read_surf           wall.surf group wall particle check

# Recycling: D+ -> D at 3 eV, D/D2 reflect at thermal energy
surf_collide        wallColl diffuse 300.0 1.0
surf_react          wallRecycle recycle wall.recycle
surf_modify         wall collide wallColl react wallRecycle

read_surf           core.surf invert group core particle check
surf_collide        coreColl diffuse 300.0 1.0
surf_modify         core collide coreColl react none

# ---- Plasma background ----
compute cnear plasma/fields all file ../test_evaporation/input/plasma.h5 &
    equilibrium ../test_evaporation/input/g000001.00001_symm.X4.equ &
    bx by bz temp_e dens_e temp_i dens_i parrflow

# ---- Boris pusher ----
global              boris_subcycles 10
global              bfield_compute cnear

# ---- Chemistry ----
fix fchem chem/adas 1 1 neutral.reactions adas_dir ../../database/adas &
    plasma c_cnear[5] c_cnear[6]

# ---- Initial particles: D2 uniformly distributed ----
global              nrho 1e18 temp 300
create_particles    neutrals n 5000

# ---- Diagnostics ----
shell               mkdir -p output
compute 1 grid all species nrho
fix 1 ave/grid all 1 100 1000 c_1[*]
dump 1 grid all 1000 output/grid.recycling id xc yc f_1[*]
dump dpart particle all 1000 output/part.recycling id type x y z vx vy vz

timestep            1e-07
stats               100
stats_style         step cpu np

run                 10000
