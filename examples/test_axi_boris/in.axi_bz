# Axisymmetric Boris mover acceptance test: uniform AXIAL B.
#
# Closed 2D axisymmetric domain (x = Z axial, y = R radial, axis at y=0),
# 50 eV H+ ions, uniform B along the machine axis. Ions gyrate in the
# (R, phi) plane, which is exactly the motion the axisymmetric remap
# handles geometrically — the hardest case for the axi mover. The
# gyroradius (~2 cm) spans about two grid cells, so orbits cross curved
# cell faces constantly.
#
# Pass criteria after the run:
#   - "Axisymm bad moves" in the run summary is 0
#   - np in the stats output stays at its initial value (closed domain)
#   - temp stays flat (pure B does no work on the particles)

seed                12345
dimension           2
boundary            r ar p            # x specular; ylo axis, yhi specular
global              gridcut 0.0 comm/sort no
global              fnum 1e10

create_box          -0.5 0.5 0.0 0.4 -0.05 0.05
create_grid         40 32 1
balance_grid        rcb part

species             plasma.species H+
mixture             ions H+ frac 1.0 temp 580225.0     # 50 eV

create_particles    ions n 20000

# Uniform axial field: slot x is the axial (Z) component in axi layout.
variable B0         equal 0.05                          # [T]
variable Bx         particle "v_B0"
variable By         particle "0.0"
variable Bz         particle "0.0"
fix                 fB bfield/particle Bx By Bz
global              bfield particle fB 0

global              pusher subcycles 10 bad_dt_check yes bad_dt_limit 0.5

# H+ at 0.05 T: omega_c = 4.79e6 rad/s, so omega_c*dt = 0.48 per step,
# resolved by 10 subcycles (omega_c*dt_sub = 0.048). Subcycling is what
# made the pre-fix pusher return a curved endpoint in axi.
dump    dpart particle all 1000 state id type x y z vx vy vz

timestep            1e-7
stats               1000
compute             T temp
stats_style         step cpu np c_T
run                 20000
