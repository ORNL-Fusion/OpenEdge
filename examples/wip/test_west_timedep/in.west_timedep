# =============================================================================
# OpenEdge test case: WEST tokamak with time-dependent B-field
# Strike point sweeping via pre-computed equilibrium snapshots
# =============================================================================
#
# This test demonstrates time-dependent magnetic geometry for modeling
# strike point sweeping on the WEST lower divertor.
#
# Prerequisites:
#   1. Generate B-field snapshots using gen_bfield_sweep.py:
#
#      python ../../tools/converters/gen_bfield_sweep.py \
#          --equ input/equilibrium.equ \
#          --delta-r 0.0 0.02 0.04 0.02 0.0 -0.02 -0.04 -0.02 \
#          --times   0.0 0.5  1.0  1.5  2.0  2.5   3.0   3.5 \
#          --outdir input/bfield_sweep/
#
#   2. Place plasma.h5 (static background plasma) in input/
#
# The B-field sweep moves the inner/outer strike points by ±2-4 cm
# over a 4-second cycle, redistributing particle and heat fluxes
# across the divertor tiles.
# =============================================================================

seed               12345
dimension          2

# --- Domain: WEST poloidal cross-section (R, Z) ---
boundary           oo oo
create_box         1.8 3.2 -1.2 0.8
create_grid        70 100 1 level 2 * * 2 2 1

# --- Species ---
species            input/species.dat W
mixture            wall_imp W vstream 0.0 0.0 0.0

# --- Static background plasma from SOLEDGE3X ---
compute cplasma plasma/fields all file input/plasma.h5 \
        temp_e temp_i dens_e dens_i

# --- Time-dependent B-field ---
# Loads snapshots from bfield_times.txt manifest, updates every 100 steps,
# linearly interpolates between bracketing snapshots.
compute cBt bfield/timedep all file_list input/bfield_sweep/bfield_times.txt \
        nevery 100 interp linear

# --- Wire B-field into Boris pusher ---
# fix bfield/grid reads 3 columns from compute cBt: br, bt, bz
fix bB bfield/grid c_cBt[1] c_cBt[2] c_cBt[3]
global bfield grid bB 0

# --- Surfaces: WEST wall contour ---
# read_surf input/west_wall.surf

# --- Particle settings ---
global             nrho 1.0e18 fnum 1.0e10
timestep           1.0e-7

# --- Diagnostics ---
compute gtemp thermal/grid all temp
fix     ftemp ave/grid all 100 10 1000 c_gtemp[*]

# --- Output ---
dump dg grid all 1000 dump.west_timedep.*.grid id xc yc &
     c_cBt[1] c_cBt[2] c_cBt[3]

stats              100
stats_style        step cpu np

run                100000
