# GCA validation: hybrid Boris/GCA run
# Same setup as in.boris but with GCA enabled.
# Compare trajectory output to pure Boris reference.

seed                 1245
dimension            3
boundary             p p p
global               gridcut 0 comm/sort no

create_box           3.0 5.0 -1.0 1.0 -1.0 1.0
create_grid          40 40 40
balance_grid         rcb part

species              input/plasma.species H+
mixture              species H+ frac 1.0

global               fnum 1
read_particles       input/source.single 0

# Plasma/fields compute: plasma.h5 (B embedded) + equilibrium
compute pfields plasma/fields all file input/plasma.h5 &
        equilibrium g000001.00001_symm.X4.equ &
        bx by bz temp_e dens_e temp_i dens_i parrflow

# Do not use grid-cached B field; pusher queries B at particle position from pfields.
global bfield none
global efield none

# Boris fallback settings (used when GCA criterion not met)
global pusher subcycles 500
global pusher dump no
global pusher bad_dt_check yes
global pusher bad_dt_limit 0.5

# Enable hybrid GCA path (default switch=2.5).
global pusher mode hybrid plasma pfields gca_switch 2.5

variable dt         equal 1e-9
variable numStep    equal 5000
variable dumpFreq   equal 1 #floor(v_numStep/200)

dump dpart particle all ${dumpFreq} output/traj.gca id type x y z vx vy vz
dump_modify dpart first yes

timestep            ${dt}
stats               ${dumpFreq}
stats_style         step cpu np
run                 ${numStep}
