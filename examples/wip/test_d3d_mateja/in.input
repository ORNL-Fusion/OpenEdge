# DIII-D carbon/boron test (migrated to true SPARTA axisymmetric 2026-04-21)
# Files:
# - input/plasma.h5        (mesh-only, from convert_oedge_plasma.py;
#                           /equilibrium/* embedded — fix plasma/data reads it
#                           for psi-based BCs AND compute surface/physical/sputter now
#                           reconstructs br/bz/bt from it on the eq grid)
# - input/wall.surf        (axi: x=Z, y=R, z=0)
# - input/plasma.species
# - input/plasma.adas      (carbon ionization/recombination)
# - input/plasma_boron.adas
# - input/surf.reactions

# --- Grid ---
seed                123423
dimension           2
# True SPARTA axisymmetric: x=Z (axial), y=R (radial, must start at 0),
# z=toroidal (periodic dummy). With this layout, surf areas / cell volumes /
# nrho / surf flux are all true-3D quantities. No 2*pi*R post-correction.
boundary            o ao p
global              gridcut -1.0  comm/sort yes
# create_box: (x=Z range, y=R range, z=phi-slab)
create_box          -1.5 1.5 0.0 2.5 -0.05 0.05
create_grid         500 500 1
balance_grid        rcb cell

global fnum 1e16

# --- Species
species input/plasma.species C C+ C2+ C3+ C4+ C5+ C6+ B B+ B2+ B3+ B4+ B5+

# Carbon: neutrals emitted, all charge states tracked
mixture             carbonSource  C       frac 1.0
mixture             carbonSource  C+      frac 0.0
mixture             carbonSource  C2+     frac 0.0
mixture             carbonSource  C3+     frac 0.0
mixture             carbonSource  C4+     frac 0.0
mixture             carbonSource  C5+     frac 0.0
mixture             carbonSource  C6+     frac 0.0

# Boron: neutrals emitted, all charge states tracked
mixture             boronSource   B       frac 1.0
mixture             boronSource   B+      frac 0.0
mixture             boronSource   B2+     frac 0.0
mixture             boronSource   B3+     frac 0.0
mixture             boronSource   B4+     frac 0.0
mixture             boronSource   B5+     frac 0.0

# --- Wall
# The OEDGE converter wrote wall.surf with a walk order that gives SPARTA-
# computed normals pointing INTO the plasma. fix emit/surf/pmi (used below)
# emits along +normal, so normals must be inward -> do NOT use `invert`.
# (Only fix emit/surf/recycle would need `invert`; see
#  docs/fixes/emit_surf_recycle.md for the sign-convention table.)
read_surf           input/wall.surf group 1 particle check
surf_collide        wallColModel diffuse 11600 1.0
surf_react          wallPMI pmi file input/surf.reactions ../../database/surface/B_on_B.h5
surf_modify         1 collide wallColModel react wallPMI

# --- Plasma data (mesh-only plasma.h5 carries /equilibrium/* embedded;
#     no `equilibrium input/...equ` keyword needed at run time).
fix                 pd plasma/data file input/plasma.h5 static yes

#compute             #cwest plasma/fields all plasma_data pd &
                    #bx by bz epar temp_e dens_e temp_i dens_i parrflow &
                    #grad_te_r grad_te_z grad_ti_r grad_ti_z ex ey ez
compute             cgeom nearest_surf/grid all 1 dist surfid nx ny nz

# --- Mesh refinement near lower divertor (axi: Z<-0.9 region)
#region              rdiv_lo block -1.4 -0.9 1.0 2.2 -INF INF
#adapt_grid all refine surf all 0.001 maxlevel 5 cells 2 2 1 region rdiv_lo all iterate 3
balance_grid        rcb cell

# --- Core boundary: absorb at psi_norm = 1.0 (separatrix).
# Uses the embedded /equilibrium/* in plasma.h5 via the pd handle.
fix                 fcore reflect/psi plasma_data pd psi_norm 1.0 action absorb

# --- Fields + pusher
variable            exbg particle p_pc_ex
variable            eybg particle p_pc_ey
variable            ezbg particle p_pc_ez
fix                 fEbg efield/particle exbg eybg ezbg
global              efield particle fEbg 0
global              pusher mode boris plasma pd subcycles 10 &
                    sheath spatial geom cgeom mD_amu 2.0

# --- Chemistry (both carbon and boron ionization/recombination ladders)
fix                 fchem_C chem/adas 1 6 input/plasma.adas adas_dir ../../database/adas
fix                 fchem_B chem/adas 1 5 input/plasma_boron.adas adas_dir ../../database/adas

# --- Collisions
# Main background: D+, A=2.0, Z=1.0
#fix                 fnanbu coll/nanbu 1 plasma p_pc_te p_pc_ne &
                    nobinary &
                    background 2.0 1.0 &
                    p_pc_ti p_pc_ni p_pc_vpar &
                    p_pc_bx p_pc_by p_pc_bz

# --- Forces
# ion_thermal β_i and elec_thermal α_e are hardcoded to the defaults
# (2.6 and 0.71 respectively); no `coeff` keyword.
fix                 ftf thermal_force 1 &
                    bfield p_pc_bx p_pc_by p_pc_bz &
                    ion_thermal p_pc_grad_ti_r p_pc_grad_ti_z &
                    elec_thermal p_pc_grad_te_r p_pc_grad_te_z

fix                 fcd cross_diffusion 1 &
                    bfield p_pc_bx p_pc_by p_pc_bz &
                    D_perp 0.3

# --- Source groups (surf ids on the 68-segment wall.surf; same walk as
#     the old wall.txt, so ids 1..68 still map to the same segments).
group               divertor_inner surf id <> 55 60
group               divertor_outer surf id <> 5 5
group               nose_edge      surf id <> 68 68
group               crown          surf id <> 18 27


# --- Sputtering: D on C (analytic Eckstein, element-aware API)
# Picks up Eckstein entry D_on_C automatically via target/projectiles.
# Main-ion mass for sheath impact energy is D+ (2.014 amu).
compute cpmi surface/physical/sputter 1 plasma_data pd &
                    target C projectiles D mass_amu 2.01410177811 erosion_flux

fix                 pw particle/weight
#fix fpmi_C surface/emit/source carbonSource 1 cpmi perspecies no normal yes &
#                    nlaunch 5 flux_thresh 1e16
# using D on C eroded flux to emit boronSource
fix fpmi_B surface/emit/source boronSource divertor_outer cpmi perspecies no normal yes &
                    nlaunch 5000 flux_thresh 1e12

# --- Output
#dump                dpart particle all 10000 output/state.d3d id type x y z vx vy vz

# --- Run
timestep            5.0e-09
stats               1 #00
stats_style         step cpu np

run                 1
quit
# Everything below is dead when `quit` fires above. Remove `quit` to run
# the full sequence (stop sources, then ave-grid diagnostics for 50k steps).
#unfix fpmi_C
unfix fpmi_B

# --- Grid density diagnostics
# Weighted density (correct with per-particle weights from nlaunch)
compute             cwden grid/weighted all boronSource nrho_w
fix                 fwden ave/grid all 1 500 5000 c_cwden[*] ave running
# xc=Z, yc=R in axi mode.
dump                dwden grid all 5000 output/tmp.grid.density_weighted id xc yc f_fwden[*]

# Standard density (for comparison)
compute             cden grid all boronSource nrho
fix                 fden ave/grid all 1 500 5000 c_cden[*] ave running
dump                dden grid all 5000 output/tmp.grid.density id xc yc f_fden[*]

run                1 # 50000
