################################################################################
# WEST axisymmetric baseline (OpenEdge)
# Flow: compute plasma fields -> compute incident flux -> dump gamma
################################################################################

seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort yes

# R-Z domain
create_box          1.82 3.2 -1.0 1.0 -0.05 0.05
create_grid         200 200 1
balance_grid        rcb cell

# Species + particles
global              fnum 1e6

species input/plasma.species W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+

#
mixture             tungstenSource  W    frac 1.
mixture             tungstenSource  W+   frac 0.
mixture             tungstenSource  W2+  frac 0.
mixture             tungstenSource  W3+  frac 0.
mixture             tungstenSource  W4+  frac 0.
mixture             tungstenSource  W5+  frac 0.
mixture             tungstenSource  W6+  frac 0.
mixture             tungstenSource  W7+  frac 0.
mixture             tungstenSource  W8+  frac 0.
mixture             tungstenSource  W9+  frac 0.
mixture             tungstenSource  W10+ frac 0.

variable            TbindW equal 4.0*11600.
variable            TwallK equal 773.15
mixture             tungstenSource temp ${TbindW}

# Surfaces
read_surf           input/wall.txt group 1 particle check
surf_collide        wallColModel diffuse ${TwallK} 1.0
surf_react          wallPMI pmi file input/reactions_pmi_west.surf input/74_on_74_pmi.h5
surf_modify         1 collide wallColModel react wallPMI

# Static mesh adaptation around active source zones:
# lower divertor, upper divertor, limiter
region rdiv_lo block 2.0 3.2 -1.0 -0.35 -1 1
region rdiv_up block 2.0 3.2 0.35 1.0 -1 1
region rlim   block 1.82 2.35 -0.20 0.20 -1 1



# For style surf: refinement is blocked if child cell size would be < ssize.
# Base cell is ~0.017 m, so ssize=0.01 prevents any 2x refinement.
write_grid output/grid.pre_adapt
adapt_grid all refine surf all  0.001 maxlevel 5 cells 2 2 1 region rdiv_lo all iterate 3
adapt_grid all refine surf all  0.001 maxlevel 5 cells 2 2 1 region rdiv_up all iterate 3
adapt_grid all refine surf all  0.001 maxlevel 5 cells 2 2 1 region rlim   all iterate 3
write_grid output/grid.post_adapt

balance_grid rcb cell

# 1) Plasma/B-field compute on grid
# c_cwest: [1]=bx [2]=by [3]=bz [4]=epar [5]=temp_e [6]=dens_e
#          [7]=temp_i [8]=dens_i [9]=parrflow [10]=grad_te_r [11]=grad_te_z
#          [12]=grad_ti_r [13]=grad_ti_z [14]=ex [15]=ey [16]=ez
#          [17]=grad_ne_r [18]=grad_ne_z
compute cwest plasma/fields all file input/plasma.h5 input/bfield.h5 &
                    bx by bz epar temp_e dens_e temp_i dens_i parrflow &
                    grad_te_r grad_te_z grad_ti_r grad_ti_z ex ey ez &
                    grad_ne_r grad_ne_z


# 1b) Sheath geometry for the supported wall-kick sheath model
compute cgeom sheath/geometry/grid all 1 dist surfid nx ny nz

# Apply B field from compute (static map)
fix bB bfield/grid c_cwest[1] c_cwest[2] c_cwest[3]
global bfield grid bB 0
global sheath geom_compute cgeom plasma_compute cwest &
                    mD_amu 2.0 pot_mult 2.5 kick yes
# Ambipolar parallel E-field from electron pressure gradient
fix fEpar efield/grid c_cwest[14] c_cwest[15] c_cwest[16]
global efield grid fEpar 0
global boris_subcycles 5

# 1c) ADAS ionization/recombination using local Te/ne from cwest
variable te_local grid "c_cwest[5]"
variable ne_local grid "c_cwest[6]"
fix fchem chem/adas 1 74 input/plasma.adas adas_dir ../../database/adas plasma te_local ne_local

# 1d) Nanbu Coulomb collisions with plasma background only
# Background species is the main D+ plasma: A=2.0, Z=1.0
# `nobinary` disables particle-particle self-collisions and keeps only
# collisions against the prescribed background moments from cwest.
fix fnanbu coll/nanbu 1 plasma c_cwest[5] c_cwest[6] &
                    nobinary &
                    background 2.0 1.0 &
                    c_cwest[7] c_cwest[8] c_cwest[9] &
                    c_cwest[1] c_cwest[2] c_cwest[3]

# 1e) Braginskii thermal forces on impurity ions
# Ion thermal force:  F = 2.6 * Z^2 * e * grad_par(Ti) (Neu 1974)
# Elec thermal force: F = 0.71 * Z^2 * e * grad_par(Te) (Braginskii)
fix ftf thermal_force 1 &
                    bfield c_cwest[1] c_cwest[2] c_cwest[3] &
                    ion_thermal c_cwest[12] c_cwest[13] coeff 2.6 &
                    elec_thermal c_cwest[10] c_cwest[11] coeff 0.71

# 1f) Anomalous cross-field diffusion (D_perp = 1.0 m^2/s + gradient pinch)
fix fcd cross_diffusion 1 &
                    bfield c_cwest[1] c_cwest[2] c_cwest[3] &
                    D_perp 1.0 &
                    gradient_pinch 2.0 c_cwest[6] c_cwest[17] c_cwest[18]

# 2) Incident plasma flux on wall group 1
#compute cgam incident/plasma/flux 1 file input/plasma.h5 nflux_species all

# 3) PMI surf data from incident plasma flux + BCA sputtering
# slot mapping: 1=D, 2=O+, 3=O2+, ... 9=O8+ ; D excluded by projectile_slots 2..9
compute cpmi pmi/surf/data 1 file input/plasma.h5 ../../database/surface/O_on_W.h5 projectile_slots 2 9 mass_amu 16.0 sputter_flux_total

# 4) Per-particle weight infrastructure for weighted emission
fix pw particle/weight

# 5) Emit sputtered W from cpmi total sputter flux
#    nlaunch 5 = emit 5 particles per surface element per step (each with weight)
#    flux_thresh 1e10 = skip surfaces with sputtering flux below 1e10 m-2s-1
fix femit emit/surf/pmi tungstenSource 1 cpmi perspecies no normal yes &
                    nlaunch 5 flux_thresh 1e10

# 6) Dumps

# Particle state dump
dump dpart particle all 5000 output/state.west id type x y z vx vy vz p_pweight
dump_modify dpart first yes

# Weighted density (correct physical density with per-particle weights)
compute cwden grid/weighted all species nrho_w
fix     fwden ave/grid all 1 500 5000 c_cwden[*] ave running
dump    dwden grid all 5000 output/tmp.grid.density_weighted id xc yc f_fwden[*]

# Standard density (for comparison — uses fnum, not meaningful with nlaunch)
compute computeID grid all species nrho
fix     fixID ave/grid all 1 500 5000 c_computeID[*] ave running
dump    dumpID  grid all 5000 output/tmp.grid.density id xc yc f_fixID[*]

# Photon emissivity: WI line (ColRadPy PEC, cm^3/s default)
compute cPE photon_emissivity/grid all species &
        pec_file ../../database/pec/w_4009_pec.h5 plasma_compute cwest
fix     fPE ave/grid all 1 500 5000 c_cPE[*] ave running
dump    dPE grid all 5000 output/photon_emissivity id xc yc f_fPE[*]

# Short validation run
#fix 31 halt 1 v_npart <= 0
timestep            1.0e-09
stats               10
stats_style         step cpu np
run                 10000
unfix femit

