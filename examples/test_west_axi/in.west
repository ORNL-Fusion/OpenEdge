################################################################################
# WEST axisymmetric baseline (OpenEdge)
# Flow: compute plasma fields -> compute incident flux -> dump gamma
################################################################################

seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort no

# R-Z domain
create_box          1.82 3.2 -1.0 1.0 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

# Species + particles
# Keep only neutral W through W20+ for this case.
species input/plasma.species W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+ W11+ W12+ W13+ W14+ W15+ W16+ W17+ W18+ W19+ W20+
# H20
#
mixture             tungstenSource  W    frac 1.
mixture             tungstenSource  W+   frac 0.
mixture             tungstenSource  W2+  frac 0.
mixture             tungstenSource  W3+  frac 0.
mixture             tungstenSource  W4+  frac 0.
mixture             tungstenSource  W5+  frac 0.
mixture             tungstenSource  W6+  frac 0.
mixture             tungstenSource  W7+  frac 0.
mixture             tungstenSource  W8+  frac 0.
mixture             tungstenSource  W9+  frac 0.
mixture             tungstenSource  W10+ frac 0.
mixture             tungstenSource  W11+ frac 0.
mixture             tungstenSource  W12+ frac 0.
mixture             tungstenSource  W13+ frac 0.
mixture             tungstenSource  W14+ frac 0.
mixture             tungstenSource  W15+ frac 0.
mixture             tungstenSource  W16+ frac 0.
mixture             tungstenSource  W17+ frac 0.
mixture             tungstenSource  W18+ frac 0.
mixture             tungstenSource  W19+ frac 0.
mixture             tungstenSource  W20+ frac 0.

variable            TbindW equal 4.*11600.
variable            TwallK equal 773.15
variable            Tcore equal 150*11600.
variable            dt equal 5.0e-09
# index-style variables so the CLI -var can override them:
#   mpirun ... spa_mpi -var nlaunchTotalW 100 -var Nphase 200000 -var tag B -in in.west
variable            nlaunchTotalW index 10
variable            sourceThreshW equal 0. #1.0e-4
# Short-test defaults; override with -var Nwarm 10000 -var Nphase 30000 for
# production. Two-phase run structure is unchanged, just fewer steps.
variable            Nwarm  index 2000
variable            Nphase index 5000
# Ndump = dump + ave/grid window length. Nphase should be an integer
# multiple so the run ends exactly on a dump.
variable            Ndump  index 10000
# tag used in output filenames to separate scan runs
variable            tag    index A
mixture             tungstenSource temp ${TbindW}

# Surfaces vessel

read_surf input/wall.surf group 1 particle check
surf_collide        wallColModel diffuse ${TbindW} 1.0
surf_react          wallPMI pmi eckstein input/reactions_pmi_west_eckstein.surf &
                    trim_dir ../../database/surface/trim
surf_modify         1 collide wallColModel react wallPMI

read_surf input/core.surf invert group 2 particle check
surf_collide        coreModel vanish
surf_modify         2 collide coreModel react none

# Local static refinement near the divertor / limiter regions
# (where particles are emitted from the wall and cluster spatially).
# 2D split: cells 2 2 1; maxlevel 2 → up to 16x finer in refined zones.
region              rdiv_lo block 1.82 3.2 -0.94 -0.40 -INF INF
region              rdiv_up block 1.82 3.2  0.40  0.80 -INF INF
region              rlim  block 2.82 3.029  -0.50  0.5 -INF INF
adapt_grid          all refine surf all 0.001 maxlevel 5 cells 2 2 1 region rdiv_lo all iterate 5
adapt_grid          all refine surf all 0.001 maxlevel 5 cells 2 2 1 region rdiv_up all iterate 5
adapt_grid          all refine surf all 0.001 maxlevel 5 cells 2 2 1 region rlim all iterate 5

# write_grid mesh.txt 

balance_grid        rcb cell

# 1) Plasma data (read once, shared by all fixes/computes)
fix                 pd plasma/data file input/plasma.h5 static yes


# 1b) Sheath geometry for the supported wall-kick sheath model
compute cgeom sheath/geometry/grid all 1 dist surfid nx ny nz

# B-field direct from fix plasma/data point queries
global              bfield_compute pd
global              sheath geom_compute cgeom plasma_fix pd &
                    mD_amu 2.0 pot_mult 2.5 kick no #yes

# Ambipolar parallel E-field from per-particle plasma cache
#variable            exbg particle p_pc_ex
#variable            eybg particle p_pc_ey
#variable            ezbg particle p_pc_ez
#fix                 fEpar efield/particle exbg eybg ezbg
#global              efield particle fEpar 0
global              boris_subcycles 5

# Psi-based inner core boundary. Uses /psi, /psicore, /psisep from plasma.h5
# (via fix plasma/data pd). Default threshold = 0 means "particle on the
# core side of /psicore is absorbed". Replaces the old core.surf geometric
# inner boundary.
#fix                 frpsi reflect/psi plasma_data pd action absorb

# 1c) ADAS ionization / recombination for tungsten.
#   - arg[3] 'W' -> ADAS_Rates_74.h5 via element_to_z
#   - arg[4] 'auto' -> database/adas/reactions/W.reactions
# Reactions file lists W0+ -> W+ through W19+ -> W20+ and recombination.
# Extra charge-states beyond the species defined in `species` above are
# silently skipped (init diagnostic makes the skip explicit).
fix fchem chem/adas 100 W auto

# 1d) Braginskii thermal forces on impurity ions
# Ion thermal force:  F = 2.6 * Z^2 * e * grad_par(Ti) (Neu 1974)
# Elec thermal force: F = 0.71 * Z^2 * e * grad_par(Te) (Braginskii)
fix ftf thermal_force 100 plasma_data pd &
                    ion_thermal yes &
                    elec_thermal yes

# 1e) Nanbu Coulomb collisions with plasma background only
# Background species is the main D+ plasma: A=2.0, Z=1.0
# `nobinary` disables particle-particle self-collisions and keeps only
# collisions against the prescribed background moments from the `pd` cache.
fix fnanbu coll/nanbu 100 plasma_data pd &
                    nobinary &
                    background 2.0 1.0


# 1f) Anomalous cross-field diffusion (D_perp = 1.0 m^2/s + gradient pinch)
fix fcd cross_diffusion 100 plasma_data pd &
                    D_perp 0.1 #&
#                    #gradient_pinch 0.0
#                    #gradient_pinch 0.0



# 3) PMI surf data from incident plasma flux + analytic Eckstein sputtering.
# In this WEST case, D_on_W sputter is negligible; D+ still sets the
# background sheath via mass_amu=2.01, but only oxygen charge states
# drive W erosion. The new `target W projectiles O` keyword replaces the
# old `projectile_slots 2 9` in a way that doesn't depend on WEST's
# particular plasma.h5 slot ordering.
#
# Emission uses cpmiO column 1 as the flux source (`fix surface/emit/sputter`
# default flux_index=0), so col 1 MUST be the W erosion flux — expose
# only `erosion_flux` here to make that unambiguous.
compute cpmiO pmi/surf/data 1 plasma_data pd eckstein O_on_W &
                    target W projectiles O mass_amu 2.01410177811 static yes &
                    erosion_flux

# Diagnostic-only copy that exposes the richer per-species breakdown
# (D+ Bohm flux, angle, energy, per-charge-state sputter fluxes) for the
# pmi_diag.west_o.surf dump.
compute cpmiO_diag pmi/surf/data 1 plasma_data pd eckstein O_on_W &
                    target W projectiles O mass_amu 2.01410177811 static yes &
                    nflux_species all incident_angle_species all incident_energy_species all &
                    sputter_flux_species all erosion_flux

# 4) Per-particle weight infrastructure for weighted emission
fix pw particle/weight

# 5) Emit sputtered W from the oxygen-driven PMI source.
# cpmiO is stripped to a single column (sputter_flux_total), so the emit
# fix reads the correct W source rate and not the D+ Bohm flux.
fix femit surface/emit/sputter tungstenSource 1 cpmiO perspecies no normal yes &
                    nlaunch_total ${nlaunchTotalW} source_thresh ${sourceThreshW}

# 6) Dumps

# Particle state dump: commented -- not needed for density/source investigation,
# keeps the 64-rank run fast.
# dump dpart particle all ${Nwarm} output/state.west.o_sputter id type x y z vx vy vz
# dump_modify dpart first yes

# Surface-level PMI diagnostics -- from the richer cpmiO_diag compute.
# `all` is expanded at construction when fix plasma/data has not yet
# loaded its HDF5 (nion=0 fallback), so cpmiO_diag collapses to 4 cols:
#   col 1 : nflux   (slot 1 = D+)           [part/m^2/s]
#   col 2 : incident angle (slot 1)         [deg]
#   col 3 : incident energy (slot 1)        [eV]
#   col 4 : sputter_flux_total              [part/m^2/s]
dump dpmi surf all ${Nphase} output/pmi_diag.west_o.surf id c_cpmiO_diag[*]
dump_modify dpmi first yes

# Weighted density (correct physical density with per-particle weights)
compute cwden grid/weighted all species nrho_w

# --- Source / loss balance diagnostics -------------------------------------
# Per-surf erosion RATE [particles/s] in axisymmetric ring form
# (erosion_flux x 2*pi*R_mid*length). Emit uses cpmiO (erosion_flux);
# cpmiO_rate pre-multiplies by the ring area so we can reduce-sum it
# directly, no property/surf / variable dance needed.
compute cpmiO_rate pmi/surf/data 1 plasma_data pd eckstein O_on_W &
                    target W projectiles O mass_amu 2.01410177811 static yes &
                    erosion_rate
compute csrc   reduce sum c_cpmiO_rate

# Mean / max volume-weighted W0 density -- lets us watch convergence live.
compute cwmax  reduce max c_cwden[1]
compute cwmean reduce ave c_cwden[1]

timestep            ${dt}
stats               100
stats_style         step cpu np c_csrc c_cwmean c_cwmax

fix     fwdenA ave/grid all 1 ${Ndump} ${Ndump} c_cwden[*] ave one


#fix balance 500 1.1 rcb time
#fix mybal balance 500 1.1 rcb part
# Runtime adaptive refinement: split any cell holding > 500 particles.
# Refines monotonically (no coarsen). Capped by maxlevel + setup adapt_grid.
fix fadapt adapt 200 all refine particle 500 0 maxlevel 8 cells 2 2 1
fix fbal balance 100 1.05 rcb part

run                ${Nwarm}
#reset_timestep      0
# Keep the PMI source active during the production window.
# Uncomment the next line only if you want a pure source-free decay test.
#unfix femit

# Phase A grid dump: per-cell n(W0..W20+) PLUS the per-cell physical volume,
# dumped every Ndump steps so time-series snapshots stack in one file.
dump    dwdenA grid all ${Ndump} output/grid.dens.${tag}.west id xc yc vol f_fwdenA[*]

# One-shot particle dump at the end of the run, including pweight. Used to
# verify the per-macro weight distribution (hot-surface weighting artifacts
# would show up as a long tail at very large pweight).
dump    dpartW particle all 100 output/state.${tag}.west.final id type x y z vx vy vz #p_pweight
dump_modify dpartW first no

run     ${Nphase}
