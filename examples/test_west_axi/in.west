################################################################################
# WEST true-axisymmetric W transport (OpenEdge)
#
# Plasma + wall regenerated from SOLEDGE3X 3MW run via convert_s3x_plasma.py.
# Layout: true axi, x=Z axial, y=R radial (axis at y=0), z=phi wedge.
#
# Flow:
#   background -> B-field -> sheath -> compute pmi erosion -> emit sputtered W
#   W advected with thermal_force + cross_diffusion + Nanbu collisions
#   W wall reflection + O/D recycling via surface/pwi (reads processes.h5)
#   W ionization chain via volume/chem/adas (reads processes.h5)
################################################################################

seed                12345
dimension           2
# Axi slot map: x=Z (axial), y=R (radial, axis at y=0), z=phi (wedge).
boundary            o ao p
global              gridcut 0.0 comm/sort no
global              fnum 5e4

# R extent from 3MW wall: [1.83, 3.20]. Z extent: [-0.94, 0.80]. Pad both sides.
create_box          -1.00 0.85 0.0 3.25 -0.05 0.05
create_grid         200 150 1
balance_grid        rcb cell

# Species: W neutral through W20+. Main-ion plasma D+ is background only (via
# fix background); O sputter projectiles come from plasma.h5 ion slots too.
species input/plasma.species W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+
mixture             tungstenSource  W    frac 1.
mixture             tungstenSource  W+   frac 0.
mixture             tungstenSource  W2+  frac 0.
mixture             tungstenSource  W3+  frac 0.
mixture             tungstenSource  W4+  frac 0.
mixture             tungstenSource  W5+  frac 0.
mixture             tungstenSource  W6+  frac 0.
mixture             tungstenSource  W7+  frac 0.
mixture             tungstenSource  W8+  frac 0.
mixture             tungstenSource  W9+  frac 0.
mixture             tungstenSource  W10+ frac 0.

variable            TbindW equal 4.*11600.
variable            TwallK equal 773.15
variable            dt equal 5.0e-09
variable            nlaunchTotalW index 500 #10
variable            sourceThreshW equal 0.
variable            Nwarm  index 2 #2000
variable            Nphase index 1000000 #5000
variable            Ndump  index 10000 #10000
variable            tag    index A
mixture             tungstenSource temp ${TbindW}

# ---- Outer wall: diffuse + surface/pwi recycling/reflection ----------------
# `invert` matches the DIII-D pilot: converters currently walk CW in (Z,R),
# which gives outward normals; invert flips them to point into the fluid.
# (The "unified no-invert" note in CLAUDE.md is aspirational — the walk
# order has not actually been changed yet.)
read_surf           input/wall.surf invert group wall particle check
surf_collide        wallColl diffuse ${TbindW} 1.0
# surface/pwi reads D_on_W, O_on_W, W_on_W reflection tables directly from
# database/processes.h5:/surface/reflection/ via input/wall.recycle reactions.
surf_react          wallPWI surface/pwi input/wall.recycle twall ${TwallK}
surf_modify         wall collide wallColl react wallPWI

# ---- Inner core absorb boundary (psi_norm=0.90 contour) -------------------
# Generated by tools/converters/convert_s3x_plasma.py --core-out ...
# 0.90 is the converter default (avoids dipping near the X-point where the
# psi_norm=0.95 contour crosses the divertor wall). Any particle crossing
# this inner flux surface is deleted (vanishes), modelling loss into the
# confined-plasma region (not tracked here).
read_surf           input/core.surf invert group core particle check
# Diffuse re-emission at local core Ti ~ 130 eV (1.5e6 K) keeps W charge
# state but thermalizes its velocity, modelling impurities that cross
# psi_norm=0.90 into the confined plasma and return after orbiting on
# closed field lines. More physical than `vanish` (perfect sink), which
# truncates the higher-q cascade by absorbing W faster than it can be
# replenished.
surf_collide        coreColl diffuse 1.5e6 1.0
surf_modify         core collide coreColl react none

# ---- Static refinement near lower/upper divertors -------------------------
region              rdiv_lo block -1.00 -0.45 1.90 3.20 -INF INF
region              rdiv_up block  0.35  0.85 1.90 3.20 -INF INF
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_lo all iterate 5
adapt_grid          all refine surf wall 0.001 maxlevel 5 cells 2 2 1 &
                    region rdiv_up all iterate 5
balance_grid        rcb cell

# Per-cell radial weighting disabled: it shifts the absolute scale of the
# per-charge-state `reduce sum c_cwspec[*]` columns and introduces clone-
# event spikes in the time series. Re-enable for production statistics
# once the per-charge-state output uses domain-averaged densities.
# global              weight cell radius

# ---- Plasma background + B-field ------------------------------------------
fix                 pd background file input/plasma.h5 static yes
# pcache stores Te, ne, B per particle and is refreshed every Nevery
# steps. Without it, fixes hitting pd_->bfield_at() etc. do a 30k-tri
# mesh lookup per particle per step, which dominates wall time. With
# pcache_nevery=100, we re-evaluate the cache every 100 steps and the
# Boris pusher / transport fixes read the cached values in between.
global              pcache_nevery 100

# Charged-particle pusher: Boris with sheath spatial overlay.
compute             cgeom nearest_surf/grid all wall dist surfid nx ny nz
global              pusher mode boris plasma pd subcycles 5 &
                    sheath spatial geom cgeom mD_amu 2.0

# ---- W ionization/recombination chain (volume chemistry) ------------------
# volume/chem/adas reads rate coefficients from database/processes.h5
# /volume/rates/{scd,acd,ccd}/w and reaction list from processes.h5 too.
fix fchem volume/chem/adas 1 W auto

# ---- Braginskii thermal forces on impurity ions ---------------------------
# Reads mesh-level grad_te/grad_ti from plasma.h5 (converter writes
# mesh/grad_te_{r,z} and mesh/grad_ti_{r,z}).
fix ftf force/thermal 100 background pd &
                    ion_thermal yes &
                    elec_thermal yes

# ---- Nanbu Coulomb collisions against D+ background -----------------------
# Args after `background pd`: A_bg (atomic mass) Z_bg (charge state).
fix fnanbu coulomb/background 100 background pd 2.014 1.0

# ---- Anomalous cross-field diffusion (D_perp = 0.1 m^2/s, L-mode) ---------
# Style name is cross_field_diffusion (not force/cross_field).
fix fcd cross_field_diffusion 100 background pd D_perp 0.1

# ---- W erosion from O sputtering (analytic Eckstein, per-projectile) ------
# Element-aware API: `target W projectiles O` resolves to Eckstein entry
# O_on_W (and would pick up additional pairs automatically if projectiles
# listed more elements, e.g. `projectiles D,O`). Plasma ion slots that
# don't match a projectile element are silently excluded.
# mass_amu sets the main-ion background for sheath impact energy.
compute cpmiO surface/physical/sputter wall background pd &
                    target W projectiles O &
                    mass_amu 2.01410177811 static yes &
                    erosion_flux

# Per-particle weight: required by fix surface/emit/source for the
# weighted launch mode. Each sputtered W carries weight = local_flux *
# area * dt / nlaunch_per_face, so far-from-source cells stay statistically
# resolved.
fix pw particle/weight

# Emit sputtered W from the oxygen-driven PMI source.
fix femit surface/emit/source tungstenSource wall cpmiO perspecies no normal yes &
                    nlaunch_total ${nlaunchTotalW} source_thresh ${sourceThreshW}

# ---- Diagnostics ----------------------------------------------------------
# Per-charge-state density (nrho_w uses the per-particle weights from
# `fix pw particle/weight`, which the hot-surface sputter emission writes).
# grid/weighted syntax: <grid_group> <mixture> <keyword>. The built-in
# `all` mixture auto-assigns one group per species, so the output has
# one column per W charge state (21 cols total).
compute cwden grid/weighted all all nrho_w

# Total-W density: put every W charge state into a single mixture group
# so grid/weighted collapses them into one column (rather than 21).
# SPARTA mixture grammar: species first, THEN keywords -- `group wsum`
# attaches every species listed on the same command to one group.
mixture allW W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+ &
             group wsum
compute cwtot grid/weighted all allW nrho_w

compute cpmiO_rate surface/physical/sputter wall background pd &
                    target W projectiles O &
                    mass_amu 2.01410177811 static yes &
                    erosion_rate
compute csrc    reduce sum c_cpmiO_rate
# c_cwtot is a per-grid array with 1 column (single mixture group), so
# reduce needs the explicit [1] index to see it as a per-grid vector.
compute cwtmean reduce ave c_cwtot[1]
compute cwtmax  reduce max c_cwtot[1]

# Per-W-charge-state domain density (mirror of test_ionization_recombination).
# `mixture species` auto-creates one group per species, so the output has
# 11 columns ordered as the `species` command above:
#   c_cwspec[1]=W  [2]=W+  [3]=W2+  ...  [11]=W10+
# Each `reduce sum` collapses the per-cell array to a scalar; the 11 scalars
# go into stats_style so plot_charged_states.py-style scripts can parse them
# from log.openedge to track approach to coronal equilibrium.
compute cwspec  grid/weighted all species nrho_w
compute cw0     reduce sum c_cwspec[1]
compute cw1     reduce sum c_cwspec[2]
compute cw2     reduce sum c_cwspec[3]
compute cw3     reduce sum c_cwspec[4]
compute cw4     reduce sum c_cwspec[5]
compute cw5     reduce sum c_cwspec[6]
compute cw6     reduce sum c_cwspec[7]
compute cw7     reduce sum c_cwspec[8]
compute cw8     reduce sum c_cwspec[9]
compute cw9     reduce sum c_cwspec[10]
compute cw10    reduce sum c_cwspec[11]

timestep            ${dt}
stats               10
stats_style         step cpu np c_csrc c_cwtmean c_cwtmax &
                    c_cw0 c_cw1 c_cw2 c_cw3 c_cw4 c_cw5 &
                    c_cw6 c_cw7 c_cw8 c_cw9 c_cw10

# Time-averaged per-cell densities for the 2-D footprint plot at run end.
# Cols: [1] total W, [2] W neutral, [3] W+. The 2-D heatmaps (analysis/
# make_w_2d_plots.py) read this dump's last frame and plot all three.
fix     fwgrid ave/grid all 1 ${Ndump} ${Ndump} &
                    c_cwtot[1] c_cwspec[1] c_cwspec[2] ave one
fix     fadapt adapt 200 all refine particle 500 0 maxlevel 8 cells 2 2 1
fix     fbal balance 100 1.05 rcb part

run              ${Nwarm}

# Production window: dump grid density (total + W + W+) per cell.
dump    dwgrid grid all ${Ndump} output/grid.dens.${tag}.west &
                    id xc yc xlo ylo xhi yhi vol &
                    f_fwgrid[1] f_fwgrid[2] f_fwgrid[3]
#dump    dpart particle all ${Nphase} output/state.${tag}.west.final &
#                    id type x y z vx vy vz
#dump_modify dpart first no

run           ${Nphase}
