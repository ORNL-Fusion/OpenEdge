# coupled_test/ — track the lightweight workflow (run scripts, config.json,
# decks, README), exclude all heavy/generated/local data.

# Local-only notes and logs
RESULTS_PLAN.md
*.log
.claude/

# Staged ensemble runs + loop archives (regenerated by run_coupling/run_ensemble)
ensemble_runs/
loop_*/
step_*/
figures/
__pycache__/
*.ipynb

# OpenEdge generated inputs/outputs (the decks under full_runs/ stay tracked)
*.h5
**/output/
openedge/plasma/
openedge/runs/
openedge/restart.dat

# SOLPS-ITER run data — heavy; only solps/README.md is tracked
solps/*
!solps/README.md
sanity_*.log
config_sanity.json
run_sanity.sh
sanity.log
