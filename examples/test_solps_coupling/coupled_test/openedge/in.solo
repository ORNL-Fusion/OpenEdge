# Standalone runner for in.coupled — runs OpenEdge once, no SOLPS driver loop.
# Use this to sanity-check the deck (incl. the new Li sputter source)
# without the 70s SOLPS chunk.
#
# Setup (one-time):
#   plasma.h5 must already be in this directory. The coupling driver
#   regenerates it from b2fstate; for standalone you can either reuse
#   a previous coupling-driver output or copy from test_droplet:
#     cp ../../../test_droplet/plasma.h5 .
#
# Run:
#   mpirun -np 4 ~/buildOpenEdge/src/spa_mpi -in in.solo
#
# Output: case.outer (sparse trajectory dump for plotting), output/particles.txt
# (the per-step driver dump from in.coupled — kept so you can verify it works).

include in.coupled

# Sparser trajectory dump for plot_trajectories.py.
shell mkdir -p output
dump d_traj particle all 200 case.outer id type x y z vx vy vz v_pmass temp radius

# Per-surface erosion flux on the divertor — c_cpmiLi is a scalar (single
# keyword `erosion_flux` was given to the compute). 38 lines per frame
# (one per segment in the divertor group), each carrying the segment ID
# and the local atoms/m^2/s rate. plot_sputter_along_wall.py reads this
# alongside ../../input/wall.surf to plot vs arc-length along the strip.
dump d_sput surf divertor 1 sputter.dump id c_cpmiLi

# Combined per-surface dump of all 3 Li source channels (sputter, evap,
# adatom). Plot via plot_li_sources.py — overlays them on the outer leg.
dump d_srcs surf divertor 1 sources.dump id c_cpmiLi c_cevap c_cadat

# Halt early if every droplet evaporates AND no sputtered Li is left.
variable npart equal np
fix     halt_zero halt 200 v_npart <= 0

run 1 #0 000
