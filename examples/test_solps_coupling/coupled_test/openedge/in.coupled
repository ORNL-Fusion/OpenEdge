# OpenEdge LM divertor — droplet transport + Li atomic sources, coupled to SOLPS.
# 2D Cartesian: SPARTA x = R, y = Z (m).  Outer divertor only.

# ---------------- Tunable parameters ----------------
variable dt              equal 5.0e-06   # timestep [s]
variable Nrun            equal 20000     # total steps
variable Ndump           equal 2000      # dump cadence
variable fnum            equal 1.0e12    # physical particles per simulated particle

# LM strip (Smolentsev free-flowing film)
variable lm_h0           equal 5.0e-3    # film thickness [m]
variable lm_U0           equal 8.0       # inlet flow velocity [m/s]
variable lm_Bs           equal 5.0       # streamwise B [T]
variable lm_alpha        equal 43.0      # incidence angle [deg]
variable lm_width        equal 1.67      # strip width [m]
variable lm_Tin          equal 350.0     # inlet temperature [degC]
variable heatflux_scale  equal 2.0       # multiplier on plasma heat flux for evap

# Droplet emission (mist, R = 50 um)
variable v_drop_min      equal 0.1       # ejection speed min [m/s]
variable v_drop_max      equal 20.0      # ejection speed max [m/s]
variable T_drop          equal 773.15    # bulk droplet T [K]
variable rocket_eta      equal 0.5       # rocket-force asymmetry coefficient
variable epstein_pref    equal 2.0       # Epstein drag prefactor
variable emit_rate_s     equal 1000      # droplets per second
variable nevery_emit     equal floor(1.0/(v_emit_rate_s*v_dt))

# Li atomic sources
variable UbLi_eV         equal 1.65      # Li surface binding energy [eV]
variable cosN_Li         equal 1.5       # over-cosine angular exponent
variable nlaunch_Li      equal 10        # simulated particles per source per Nevery
variable nevery_Li       equal 10        # surface-emit cadence

variable mD_amu          equal 2.0       # D+ mass for OML droplet charging

# ---------------- Domain & grid ----------------
seed                12345
timestep            ${dt}
dimension           2
boundary            o o p
global              gridcut 0.0
global              fnum ${fnum}
create_box          2.0 6.0 -4.0 4.0 -0.05 0.05
create_grid         500 200 1
balance_grid        rcb cell

# ---------------- Species & mixtures ----------------
species ../../input/droplet.species mist
species ../../input/plasma.species  Li Li+ Li2+ Li3+
mixture DropletSource mist  frac 1.0 nrho 1
mixture LiSource     Li     frac 1.0
mixture LiSource     Li+    frac 0.0
mixture LiSource     Li2+   frac 0.0
mixture LiSource     Li3+   frac 0.0
mixture LiSource     temp ${T_drop}

# ---------------- Walls ----------------
read_surf           ../../input/wall.surf group wall particle check
surf_collide        wallColModel vanish
surf_modify         wall collide wallColModel

group               div_ol surf id <> 140 239

# Refine grid around the outer divertor strike point (~2.5 mm)
region rdiv_lo block 2.0 6.0 -4.0 -2.5 -0.05 0.05
adapt_grid all refine surf div_ol 0.001 maxlevel 3 cells 4 4 1 region rdiv_lo all iterate 3
balance_grid rcb cell

# ---------------- Plasma background ----------------
fix pd background file plasma.h5 static yes

# ---------------- LM strip (outer leg) ----------------
fix flm_ol surface/state/lm div_ol 1 solps_b2pl ../solps/v0_1/b2pl.exe.dir/ld_tg_o.dat &
           h0 ${lm_h0} U0 ${lm_U0} Bs ${lm_Bs} alpha ${lm_alpha} width ${lm_width} &
           Tin ${lm_Tin} static yes csv output/strip_ol.csv

# ---------------- Droplet pipeline ----------------
fix fdrop_ol droplet/emit DropletSource div_ol nevery ${nevery_emit} n 1 perspecies no normal no &
             vmin ${v_drop_min} vmax ${v_drop_max} angle cosine
fix fevap    droplet/evaporate 1 DropletSource background pd &
             heatflux/scale ${heatflux_scale} rocket_eta ${rocket_eta}
fix fdrag    droplet/drag 1 ${epstein_pref} 1 background pd gravity 0 -9.8 0 model epstein mixture DropletSource
fix fcharge  droplet/charge 1 background pd ion_mass_amu ${mD_amu} thermionic no mixture DropletSource

# Braginskii thermal force on Li ions (auto-skipped for charge==0)
fix fthermal force/thermal 1 background pd ion_thermal yes elec_thermal yes

fix fbal balance 2000 1.2 rcb part

# ---------------- Li atomic source-flux computes ----------------
compute cpmiLi surface/physical/sputter     div_ol background pd target Li projectiles D,Ne,Li static yes erosion_flux
compute cevap  surface/chemical/evaporation div_ol tsurf Tsurf_lm sticking 1.0
compute cadat  surface/chemical/adatom      div_ol tsurf Tsurf_lm dp_flux s_Gamma_D_lm

# ---------------- Li atomic emission ----------------
fix pw particle/weight
#fix femit_spu surface/emit/source LiSource div_ol cpmiLi perspecies no normal no &
#              nevery ${nevery_Li} nlaunch_total ${nlaunch_Li} model thompson ${UbLi_eV} cos_n ${cosN_Li}
#fix femit_evp surface/emit/source LiSource div_ol cevap  perspecies no normal no &
#              nevery ${nevery_Li} nlaunch_total ${nlaunch_Li} model thermal_tsurf Tsurf_lm
#fix femit_ada surface/emit/source LiSource div_ol cadat  perspecies no normal no &
#              nevery ${nevery_Li} nlaunch_total ${nlaunch_Li} model thermal_tsurf Tsurf_lm

# Li volumetric ionization / recombination (ADAS rates)
fix fchem volume/chem/adas 1 Li auto

# ---------------- Charged-particle pusher ----------------
global pusher plasma pd
global pusher mode boris
global pusher subcycles 5

# ---------------- Diagnostics ----------------
dump        d_part particle all ${Ndump} output/particles.txt id type x y z vx vy vz temp radius p_droplet_charge
dump_modify d_part format float "%.15e"

variable Nevery_grid  equal 100
variable Nrepeat_grid equal floor(v_Nrun/v_Nevery_grid)
compute     cmist grid/weighted all LiSource nrho_w
fix         favgmist ave/grid all ${Nevery_grid} ${Nrepeat_grid} ${Nrun} c_cmist[1] ave one
dump        dgridmist grid all ${Nrun} output/grid_density.txt id xc yc xlo ylo xhi yhi f_favgmist
dump_modify dgridmist format float "%.6e"

dump        d_surf surf div_ol ${Ndump} output/surf_fluxes.txt &
            id v1x v1y v2x v2y c_cpmiLi c_cevap c_cadat s_Tsurf_lm s_Gamma_D_lm
dump_modify d_surf format float "%.6e"

# ---------------- Run ----------------
#run 100
#unfix fdrop_ol

#variable npart equal np
variable npart equal npart
fix 31 halt 100 v_npart <= 0

stats ${Ndump}
run   ${Nrun}
