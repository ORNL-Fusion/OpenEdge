# OpenEdge droplet transport — coupled-mode template for openedge_solps_driver.py.
# Driver substitutes Ndump per chunk and appends `run <N_OE>`.

variable dt              equal 1e-05
variable Ndump           equal 1000
variable heatflux_scale  equal 2.0
variable temp_droplet    equal 773.15
variable temp_emit       equal 1.e20

variable Rho equal 534.0
variable rd2 equal 2.5e-3
variable md2 equal (4.0/3.0)*PI*${Rho}*${rd2}*${rd2}*${rd2}

seed                12345
timestep            ${dt}

dimension           2
boundary            o ao p
global              gridcut 0.0 comm/sort no
global              temp ${temp_emit}
create_box          -3.8 3.8 0 5.7 -0.05 0.05
create_grid         200 200 1
balance_grid        rcb cell

global              fnum 0.0000001

species ../../input/droplet.species drop_2
species ../../input/plasma.species  Li Li+ Li2+ Li3+
mixture DropletSource drop_2 frac 1.0 nrho 1
mixture LiSource     Li    frac 1.0
mixture LiSource     Li+   frac 0.0
mixture LiSource     Li2+  frac 0.0
mixture LiSource     Li3+  frac 0.0

variable            pmass particle mass

read_surf           ../../input/wall.surf invert group wall particle check
surf_collide        wallColModel diffuse ${temp_droplet} 1.0
surf_react          wallReact global 1. .0
surf_modify         wall collide wallColModel react wallReact

# Lower divertor: Li-coated tiles in wall.surf.
# Sergey's strip model is valid only for the lower divertor; upper-
# divertor surfs (would map to ld_tg_iu.dat / ld_tg_ou.dat) are not in
# this wall.surf yet, so no fix is registered for them.
group               divertor    surf id <> 103 150
group               div_il      surf id <> 103 116
group               div_ol      surf id <> 137 150

read_particles      ../../input/particle.source 1

# Plasma background from SOLPS (driver rewrites plasma.h5 each chunk).
fix    pd background file plasma.h5 static yes

# ---- Droplet transport --------------------------------------------------
fix fevap   droplet/evaporate 1 DropletSource background pd mass ${md2} radius ${rd2} temp ${temp_droplet} heatflux/scale ${heatflux_scale} rocket_eta 0.5
fix fdrag   droplet/drag 1 2.0 1 background pd gravity 0 -9.8 0 model epstein
fix fcharge droplet/charge 1 background pd ion_mass_amu 2.0 thermionic no

# ---- Physical sputtering: D -> Li at the lower divertor -----------------
# Li surface binding energy (Eckstein) = 1.65 eV; over-cosine n=1.5 for Sigmund-like
variable            UbLi_eV        equal 1.65
variable            cosN_Li        equal 1.5
variable            TwallK         equal 773.15
variable            nlaunchTotalSpu index 200
variable            nlaunchTotalEvp index 200
variable            nlaunchTotalAda index 200
variable            sourceThreshLi equal 0.0
# SPARTA requires nonzero mixture temp or vstream; the value below is
# only used by the legacy `model thermal` path. The thompson and
# thermal_tsurf samplers below override it.
mixture             LiSource temp ${TwallK}

compute cpmiLi surface/physical/sputter divertor background pd target Li projectiles D,Ne,Li static yes erosion_flux

# ---- Liquid-metal strips: one per divertor leg --------------------------
# Smolentsev's free-flowing-film MHD model is only valid for the LOWER
# divertor (gravity sets the flow direction). For each leg, we register a
# separate fix surface/state/lm that reads its own SOLPS ld_tg_*.dat and
# writes Tsurf_lm / h_lm / Gamma_D_lm into the SAME per-surf customs
# (SPARTA's add_custom is idempotent on name reuse — second caller gets the
# existing index). Surfs not in either leg group keep their default custom
# value (Tin, 0).
#
# Per-leg parameters (h0/U0/Bs/alpha/width) are intentionally identical
# here for the verification run; for production retune α and Bs to each
# leg's local incidence angle and field strength. Keep |Re|>1e4 and
# |Ha_s|>1e5 to stay inside the solver's validated envelope.
#
# Standalone verification on the outer leg matched SOLPS peak_power_w
# int_tot_ol to 0.35% and gave Tsurf peak ≈ 418 °C; SPARTA reproduces this
# within 0.1 % with `static yes`.
fix flm_ol surface/state/lm div_ol 100 solps_b2pl ../solps/v0_1/b2pl.exe.dir/ld_tg_o.dat h0 5e-3 U0 8.0 Bs 5.0 alpha 43.0 width 1.67 Tin 350 static yes
fix flm_il surface/state/lm div_il 100 solps_b2pl ../solps/v0_1/b2pl.exe.dir/ld_tg_i.dat h0 5e-3 U0 8.0 Bs 5.0 alpha 43.0 width 1.67 Tin 350 static yes

# ---- Per-particle weight needed by all weighted-launch emit fixes -------
fix pw  particle/weight

# ---- Surface chemistry computes ------------------------------------------
compute cevap surface/chemical/evaporation divertor tsurf Tsurf_lm sticking 1.0
compute cadat surface/chemical/adatom      divertor tsurf Tsurf_lm dp_flux s_Gamma_D_lm

# ---- Three emission sources, each with its own sampling model -----------
# Physical sputter: Thompson energy + over-cosine angular
fix femit_spu surface/emit/source LiSource divertor cpmiLi perspecies no normal yes nlaunch_total ${nlaunchTotalSpu} source_thresh ${sourceThreshLi} model thompson ${UbLi_eV} cos_n ${cosN_Li}

# Thermal evaporation: half-Maxwell flux at per-surf Tsurf_lm + cosine angular
fix femit_evp surface/emit/source LiSource divertor cevap  perspecies no normal yes nlaunch_total ${nlaunchTotalEvp} source_thresh ${sourceThreshLi} model thermal_tsurf Tsurf_lm

# Adatom desorption: same Knudsen-thermal sampling as evap, driven by Arrhenius flux
fix femit_ada surface/emit/source LiSource divertor cadat  perspecies no normal yes nlaunch_total ${nlaunchTotalAda} source_thresh ${sourceThreshLi} model thermal_tsurf Tsurf_lm

# ---- Li volumetric ionization / recombination / CX ----------------------
#fix fchem volume/chem/adas 1 Li auto

# ---- Charged-particle pusher --------------------------------------------
#global pusher plasma pd
#global pusher subcycles 5

# ---- Coupling output ----------------------------------------------------
dump d_part particle all 1 output/particles.txt id type x y z vx vy vz temp radius
dump_modify d_part format float "%.15e"

# Per-surf source diagnostics. One row per wall surf (group `all`), columns:
#   id, Z1, R1, Z2, R2 (axi: x=Z, y=R), erosion_flux, evap_flux,
#   adatom_flux, Tsurf_lm [°C], Gamma_D_lm [m^-2 s^-1].
# Surfs outside the LM groups (div_il / div_ol) keep custom defaults
# (Tsurf=Tin, Gamma_D=0, evap = Antoine value at Tin).
dump d_surf surf all 1 output/surf_fluxes.txt id v1x v1y v2x v2y c_cpmiLi c_cevap c_cadat s_Tsurf_lm s_Gamma_D_lm
dump_modify d_surf format float "%.6e"

stats ${Ndump}
run 1 #200
