################################################################################
# Particle weight test — STANDARD mode (fnum-based emission)
# Uses WEST axisymmetric geometry with PMI emission
# Run 500 steps, dump weighted + standard density
################################################################################

seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort yes

create_box          1.82 3.2 -1.0 1.0 -0.05 0.05
create_grid         200 200 1
balance_grid        rcb cell

global              fnum 1e6

species             ../test_west_axi/input/plasma.species W W+ W2+ W3+ W4+ W5+ W6+ W7+ W8+ W9+ W10+

mixture             tungstenSource  W    frac 1.
mixture             tungstenSource  W+   frac 0.
mixture             tungstenSource  W2+  frac 0.
mixture             tungstenSource  W3+  frac 0.
mixture             tungstenSource  W4+  frac 0.
mixture             tungstenSource  W5+  frac 0.
mixture             tungstenSource  W6+  frac 0.
mixture             tungstenSource  W7+  frac 0.
mixture             tungstenSource  W8+  frac 0.
mixture             tungstenSource  W9+  frac 0.
mixture             tungstenSource  W10+ frac 0.

variable            TbindW equal 4.0*11600.
variable            TwallK equal 773.15
mixture             tungstenSource temp ${TbindW}

read_surf           ../test_west_axi/input/wall.txt group 1 particle check
surf_collide        wallColModel vanish
surf_modify         1 collide wallColModel

# Mesh adaptation
region rdiv_lo block 2.0 3.2 -1.0 -0.35 -1 1
region rdiv_up block 2.0 3.2 0.35 1.0 -1 1
region rlim   block 1.82 2.35 -0.20 0.20 -1 1
adapt_grid all refine surf all 0.001 maxlevel 5 cells 2 2 1 region rdiv_lo all iterate 3
adapt_grid all refine surf all 0.001 maxlevel 5 cells 2 2 1 region rdiv_up all iterate 3
adapt_grid all refine surf all 0.001 maxlevel 5 cells 2 2 1 region rlim   all iterate 3
balance_grid rcb cell

# Plasma/B-field compute
compute cwest plasma/fields all file ../test_west_axi/input/plasma.h5 &
                    bx by bz epar temp_e dens_e temp_i dens_i parrflow grad_te_r grad_te_z

# PMI compute
compute cpmi pmi/surf/data 1 file ../test_west_axi/input/plasma.h5 ../../database/surface/O_on_W.h5 projectile_slots 2 9 mass_amu 16.0 sputter_flux_total

# Standard emission (fnum-based)
fix femit emit/surf/pmi tungstenSource 1 cpmi perspecies no normal yes

# Standard density
compute cden grid all species nrho
fix fden ave/grid all 1 100 500 c_cden[*] ave running
dump dden grid all 500 output/density_standard id xc yc f_fden[*]

# Particle dump
dump dpart particle all 500 output/state.standard id type x y z vx vy vz

timestep            1.0e-09
stats               50
stats_style         step cpu np
run                 500
