# kokkos_parity stage 4: fix population/control on the frozen restart state.
# Every (cell, species) bucket over Nmax=1 is thinned to one survivor whose
# pweight absorbs the bucket weight. Deterministic checks: particle count
# after thinning (CPU == GPU exactly) and per-cell weighted density
# (conserved, CPU == GPU).
variable            tag index cpu
read_restart        state.restart
seed                104729
global              move no
fix                 pd background file rfpie_input/plasma_he.h5 static yes bz 0.1
fix                 pw particle/weight
fix                 fpop population/control 1 1
compute             cgw grid/weighted all wDiag n_w nrho_w massrho_w
fix                 avg ave/grid all 1 1 1 c_cgw[*] ave one
dump                dg grid all 1 out_${tag}/pgrid.*.dump id f_avg[*]
dump_modify         dg format float %.12e
stats               1
stats_style         step np
timestep            2.0e-8
run                 2
