# Hybrid wall-handoff verification, Stage A (PLAN.md): He+ ensemble onto a
# flat absorbing target in a uniform tilted B. No sheath, no collisions.
#   -var pmode  hybrid|gca      (boris reference = hybrid + gswitch 1e30)
#   -var gswitch, knear, dt, nsteps, dfreq, tag, nens
# B = 1 T at 45 deg to the wall normal (x-z plane), via bcart.

seed                20260813
dimension           3
boundary            o o o
global              gridcut 0.0 comm/sort no
global              fnum 1

create_box          -0.03 0.03 -0.03 0.03 -0.002 0.06
create_grid         12 12 12
balance_grid        rcb part

species             input/he.species He+
mixture             ions He+ frac 1.0

# defaults first: every ${var} below must exist for a bare `-in in.wall`
variable pmode      index hybrid
variable gswitch    index 2.5
variable knear      index 2.5      # Boris shell = knear*rho_L; 0 = off
variable dt         index 5e-10
variable nsteps     index 12000
variable dfreq      index 20
variable subc       index 1        # Boris subcycles (shell replay at large dt)
variable tag        index ref
variable src        index source.n256
variable gcwall     index a0       # a0 = uniform phase; flux = A1 operator

read_surf           input/target.surf group target
group topface surf id <> 1 2      # active top plane (slab sides/bottom
                                  # would poison the plane-distance shell)
surf_collide        tvan vanish file output/impacts.${tag}.csv
surf_modify         target collide tvan

read_particles      input/${src} 0

# uniform plasma + uniform Cartesian tilted B (no file needed)
fix pd background constant static yes bcart 0.70710678 0.0 -0.70710678 &
                   ne 1.0e18 te 5.0 ti 5.0

compute cgeom nearest_surf/grid all topface dist surfid nx ny nz

global pusher plasma pd mode ${pmode} gca_switch ${gswitch} &
       gca_integrator rk4 subcycles ${subc} &
       bad_dt_check yes bad_dt_limit 0.5 &
       boris_near ${knear} rhoL gc_wall ${gcwall} &
       sheath off geom cgeom &
       switch_log output/switch.${tag}.csv

dump dpart particle all ${dfreq} output/traj.${tag} id type x y z vx vy vz &
     p_gca_x p_gca_y p_gca_z p_gca_vpar p_gca_mu &
     p_gca_mode p_gca_valid p_gca_chi
dump_modify dpart first yes

timestep            ${dt}
stats               2000
stats_style         step cpu np
run                 ${nsteps}
