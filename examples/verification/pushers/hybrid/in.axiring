# Stage D1 (PLAN.md): A1 in production geometry — 2D axisymmetric,
# He+ ensemble onto an annular ring target (active face at Z = 0,
# normal +Z), B = 1 T at 45 deg to the normal via cylindrical constants
# (bz/bt — served by every legacy accessor). No sheath, no collisions.
#   ref: -var pmode hybrid -var gswitch 1e30   (axi kick-drift Boris)
#   a0/a1: -var pmode gca -var gcwall a0|flux  (chord vs flux impact)

seed                20260813
dimension           2
boundary            o ao p
global              gridcut 0.0 comm/sort no
global              fnum 1

create_box          -0.005 0.06 0.0 0.3 -0.5 0.5
create_grid         26 30 1
balance_grid        rcb part

species             input/he.species He+
mixture             ions He+ frac 1.0

# defaults first: every ${var} below must exist for a bare `-in in.axiring`
variable pmode      index hybrid
variable gswitch    index 1e30
variable dt         index 5e-10
variable nsteps     index 12000
variable dfreq      index 20
variable subc       index 1
variable tag        index ref
variable gcwall     index a0       # a0 = chord impact; flux = A1 operator

read_surf           input/ring.surf group target
group topface surf id <> 1 1      # active annular face (Z = 0, normal +Z)
surf_collide        tvan vanish file output/impacts.${tag}.csv
surf_modify         target collide tvan

read_particles      input/source.axi256 0

fix pd background constant static yes bz -0.70710678 bt 0.70710678 &
                   ne 1.0e18 te 5.0 ti 5.0

compute cgeom nearest_surf/grid all topface dist surfid nx ny nz

global pusher plasma pd mode ${pmode} gca_switch ${gswitch} &
       gca_integrator rk4 subcycles ${subc} &
       bad_dt_check yes bad_dt_limit 0.5 &
       gc_wall ${gcwall} &
       sheath off geom cgeom &
       switch_log output/switch.${tag}.csv

dump dpart particle all ${dfreq} output/traj.${tag} id type x y z vx vy vz &
     p_gca_x p_gca_y p_gca_z p_gca_vpar p_gca_mu &
     p_gca_mode p_gca_valid p_gca_chi
dump_modify dpart first yes

timestep            ${dt}
stats               2000
stats_style         step cpu np
run                 ${nsteps}
