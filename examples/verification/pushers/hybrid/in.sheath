# Stage B1 (PLAN.md): sheath boundary barrier at alpha = 0 (B || n),
# where the parallel-only treatment is exact. He+ onto the flat target
# with an escape collector above; hybrid pusher, Boris shell at the wall.
#   -var shmode boundary|off   (off = baseline for the inbound E_n shift)
#   -var src / tag / nsteps / dfreq

seed                20260813
dimension           3
boundary            o o o
global              gridcut 0.0 comm/sort no
global              fnum 1

create_box          -0.03 0.03 -0.03 0.03 -0.002 0.06
create_grid         12 12 12
balance_grid        rcb part

species             input/he.species He+
mixture             ions He+ frac 1.0

variable shmode     index boundary
variable src        index source.b_in
variable tag        index b_in
variable dt         index 1e-8
variable nsteps     index 1200
variable dfreq      index 4
variable subc       index 20

read_surf           input/target.surf group target
group topface surf id <> 1 2
surf_collide        tvan vanish file output/impacts.${tag}.csv
surf_modify         target collide tvan

read_surf           input/escape.surf group collector
surf_collide        evan vanish file output/escapes.${tag}.csv
surf_modify         collector collide evan

read_particles      input/${src} 0

# B || n: uniform Cartesian field straight into the wall
fix pd background constant static yes bcart 0.0 0.0 -1.0 &
                   ne 1.0e18 te 5.0 ti 5.0

compute cgeom nearest_surf/grid all topface dist surfid nx ny nz

global pusher plasma pd mode hybrid gca_switch 2.5 &
       gca_integrator rk4 subcycles ${subc} &
       bad_dt_check yes bad_dt_limit 0.5 &
       boris_near 2.5 rhoL &
       sheath ${shmode} geom cgeom mD_amu 4 &
       switch_log output/switch.${tag}.csv

dump dpart particle all ${dfreq} output/traj.${tag} id type x y z vx vy vz &
     p_gca_x p_gca_y p_gca_z p_gca_vpar p_gca_mu &
     p_gca_mode p_gca_valid p_gca_chi
dump_modify dpart first yes

timestep            ${dt}
stats               2000
stats_style         step cpu np
run                 ${nsteps}
