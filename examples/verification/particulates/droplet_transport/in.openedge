# Lithium droplet transport; axisymmetric slots are x=Z, y=R, z=phi.

variable dt    equal 1e-05
variable time  equal 10
variable N     equal floor(${time}/${dt})
# 20 steps = 0.2 ms between trajectory points (3 particles, dump is cheap)
variable Ndump equal 20

variable temp_droplet equal 773.15

# Domain
seed                12345
timestep            ${dt}
dimension           2
boundary            o ao p
global              gridcut 0.0 comm/sort no
create_box          -3.8 3.8 0 5.7 -0.05 0.05
create_grid         40 30 1
balance_grid        rcb cell
global              weight cell radius
global fnum 0.0000001

# Species and geometry
species input/droplets.species drop_1 drop_2 drop_3
mixture drops_1 drop_1 frac 1.0
mixture drops_2 drop_2 frac 1.0
mixture drops_3 drop_3 frac 1.0

read_surf           input/wall.surf invert group surfID particle check
surf_collide        wallColModel  diffuse ${temp_droplet} 1.0
surf_react          wallReact global 1. .0
surf_modify         surfID collide wallColModel react wallReact

# Plasma and droplets
fix    pd background file input/plasma.h5 static yes

read_particles input/source 1

fix fevap_1 particulate/thermal 1 drops_1 background pd heating oml &
            ion_mass_amu 2.0 material Li rocket_eta 0.5
fix fevap_2 particulate/thermal 1 drops_2 background pd heating oml &
            ion_mass_amu 2.0 material Li rocket_eta 0.5
fix fevap_3 particulate/thermal 1 drops_3 background pd heating oml &
            ion_mass_amu 2.0 material Li rocket_eta 0.5

fix fdrag   particulate/drag 1 2.0 1 background pd gravity 0 -9.8 0 &
            model dustt2005 coulomb/self yes material Li
fix fcharge particulate/charge 1 background pd ion_mass_amu 2.0 thermionic no

global pusher plasma pd
global pusher subcycles 5

# Diagnostics and run
shell mkdir output
dump dtraj particle all ${Ndump} output/state.trj id type x y z vx vy vz temp radius

stats 1
run 1

variable npart equal np
variable Nd equal ${Ndump}*2
fix 31 halt ${Nd} v_npart <= 0

stats ${Ndump}
run ${N}
