# Toroidal periodic caps on a 10 deg wedge: W atoms stream toroidally and cross
# the caps ~50 times each.  With gridcut -1 nothing may be lost at the caps on
# any rank count (with gridcut 0.0 and a partition cut in y, a particle rotated
# to the far cap lands outside the ghost layer and is discarded).
#   -var gridcut -1|0.0    -var nsteps N

variable    gridcut  index -1
variable    nsteps   index 1000

shell       mkdir output
seed        4711
dimension   3
boundary    o o o
global      gridcut ${gridcut} comm/sort yes
global      fnum 1e10
timestep    1e-6

create_box  0.9 2.1 -0.2 0.2 -0.6 0.6
create_grid 6 16 6
balance_grid block 1 * 1      # y-slabs: every cap crossing lands on another rank's cells

species     input/w.species W
mixture     stream W frac 1.0 nrho 1e13 temp 300.0 vstream 0.0 1.0e4 0.0

read_surf   input/wedge.surf group wedge particle check
group       walls surf id 1:4
group       caps surf id 5:8
group       ends surf id 9:12
surf_collide bounce specular
surf_collide capPeriodic toroidal 10.0 -5.0
surf_modify walls collide bounce
surf_modify ends collide bounce
surf_modify caps collide capPeriodic

region      core block 1.3 1.7 -0.02 0.02 -0.2 0.2
create_particles stream n 180000 region core     # ~2000 land in the region (1.1 % of the box)

stats       100
stats_style step cpu np nscoll nexit
run         ${nsteps}
