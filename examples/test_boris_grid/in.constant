# Grid-centered Boris test with normalized tokamak field (Eq. 32-style)
# Bx = -B0*(2*R0*y + x*z)/(2*R^2)
# By =  B0*(2*R0*x - y*z)/(2*R^2)
# Bz =  B0*(R - R0)/(2*R)

seed                 1245
dimension            3
boundary             p p p
global               gridcut 0 comm/sort no

create_box           -2 2 -2 2 -2 2
create_grid          100 100 100
balance_grid         rcb part

species              plasma.species H+
mixture              species H+ frac 1.0
read_particles       source.single 0

# Equation (32), normalized with B0 = R0 = 1; sampled at GRID centers
variable B0 equal 1.0
variable R0 equal 1.0
variable eps equal 1e-6

compute cxyz property/grid all xc yc zc
variable R  grid "sqrt(c_cxyz[1]*c_cxyz[1] + c_cxyz[2]*c_cxyz[2] + v_eps*v_eps)"
variable Bx grid "-v_B0*(2.0*v_R0*c_cxyz[2] + c_cxyz[1]*c_cxyz[3])/(2.0*v_R*v_R)"
variable By grid " v_B0*(2.0*v_R0*c_cxyz[1] - c_cxyz[2]*c_cxyz[3])/(2.0*v_R*v_R)"
variable Bz grid " v_B0*(v_R - v_R0)/(2.0*v_R)"

fix bB bfield/grid Bx By Bz
global bfield grid bB 0
global efield none
global boris_subcycles 200
global boris_dump no
global boris_bad_dt_check yes
global boris_bad_dt_limit 0.1


shell mkdir -p output
variable dt         equal 5e-8
#variable numStep    equal 10000000
#variable dumpFreq1  equal floor(v_numStep/10000)


variable dumpFreq1 equal 1        # or 5/10 for debug
variable numStep   equal 400000   # shorter debug run first

dump dpart particle all ${dumpFreq1} output/state.constant id type x y z vx vy vz
dump_modify dpart first yes

timestep            ${dt}
stats               ${dumpFreq1}
stats_style         step cpu np
run                 ${numStep}
