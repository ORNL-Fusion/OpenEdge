unfix droplet_emission

fix 22 evap 1 LigamentSource mass ${md} radius ${rd} temp ${temp} heatflux/constant 50e6
fix 22 evap 1 LigamentSource mass 2.796017461694916e-10 radius ${rd} temp ${temp} heatflux/constant 50e6
fix 22 evap 1 LigamentSource mass 2.796017461694916e-10 radius 5e-05 temp ${temp} heatflux/constant 50e6
fix 22 evap 1 LigamentSource mass 2.796017461694916e-10 radius 5e-05 temp 773.15 heatflux/constant 50e6
compute cnear plasma/fields/file all surfID ../plasma.h5 ../bfield.h5 mindist surfid bx by bz temp_e dens_e temp_i dens_i parrflow
fix BC viscous 1 2.0 1 plasma c_cnear[5] c_cnear[6] c_cnear[9] c_cnear[10] bfield c_cnear[3] c_cnear[4] c_cnear[5] gravity 0 0 -9.8


fix 31 halt ${N1} v_npart <= 0
fix 31 halt 2 v_npart <= 0

timestep ${dt}
timestep 1e-05
stats ${N1}
stats 2
stats_style step cpu np

log log.openedge.case.outer.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle}
log log.openedge.case.outer.mist.site.${surfId}.vmag.${vmag}.angle.${angle}
log log.openedge.case.outer.mist.site.44.vmag.${vmag}.angle.${angle}
log log.openedge.case.outer.mist.site.44.vmag.0.1.angle.${angle}
log log.openedge.case.outer.mist.site.44.vmag.0.1.angle.2.0
