SPARTA-OPENEDGE (20 Jan 2025)
Running on 1 MPI task(s)

# set parameters
variable dt   equal 1e-05
variable time equal 1
variable N equal  floor(${time}/${dt})
variable N equal  floor(1/${dt})
variable N equal  floor(1/1e-05)
variable N1 equal floor($N/40000)
variable N1 equal floor(99999/40000)


variable temp equal 773.15 # Kelvin
variable           droplet index mist Instability Ligament
variable surfId    index 37 38 39 40 42 44 46 48 50
variable vmag      index 0.1 1.0 10.0
variable angle     index 2.0 45. 87.0
variable md        index 2.796017461694916e-10 3.495021827118645e-05 2.236813969355933e-03  # mist instability ligament
variable Rho       equal 534.0
variable rd        equal (3.0*${md}/(4.0*PI*${Rho}))^(1.0/3.0)
variable rd        equal (3.0*2.796017461694916e-10/(4.0*PI*${Rho}))^(1.0/3.0)
variable rd        equal (3.0*2.796017461694916e-10/(4.0*PI*534))^(1.0/3.0)

seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
create_box          2. 6 -4. 3.8 -0.05 0.05
Created orthogonal box = (2 -4 -0.05) to (6 3.8 0.05)
create_grid         100 100 1
Created 10000 child grid cells
  CPU time = 0.000857 secs
  create/ghost percent = 44.9242 55.0758
balance_grid        rcb  cell
Balance grid migrated 0 cells
  CPU time = 0.000611 secs
  reassign/sort/migrate/ghost percent = 20.6219 2.94599 10.311 66.1211

############################################------species in the plasma (current and future)-------#####################################
species droplet.species ${droplet} Li Li+ Li2+ Li3+
species droplet.species mist Li Li+ Li2+ Li3+


mixture             LigamentSource  ${droplet}  frac 1.0 nrho 1
mixture             LigamentSource  mist  frac 1.0 nrho 1
variable            pmass  particle mass

read_surf          wall.surf group surfID particle check
  156 lines
  2.43158 5.6 xlo xhi
  -3.77748 3.77748 ylo yhi
  0 0 zlo zhi
  0.0146051 min line length
  360 0 = cells overlapping surfs, overlap cells with unmarked corner pts
  4623 5017 360 = cells outside/inside/overlapping surfs
  360 = surf cells with 1,2,etc splits
  14.8969 14.8969 = cell-wise and global flow volume
  CPU time = 0.00147 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 14.5578 3.46939 4.62585 48.4354 28.9116 14.898 0
  surf2grid time = 0.000712 secs
  map/comm1/comm2/comm3/comm4/split percent = 29.2135 2.80899 32.7247 2.52809 6.17978 12.0787
surf_collide       wallColModel vanish
surf_modify        all collide wallColModel

read_surf          core.surf invert group surfID2 particle check
  296 lines
  2.8168 5.26754 xlo xhi
  -2.20288 2.19899 ylo yhi
  0 0 zlo zhi
  4.44089e-16 min line length
  594 0 = cells overlapping surfs, overlap cells with unmarked corner pts
WARNING: Surface check found 4 points nearly on lines (/Users/42d/OpenEdge_ORNL_GITHUB/src/surf.cpp:1752)
  1894 7512 594 = cells outside/inside/overlapping surfs
  594 = surf cells with 1,2,etc splits
  6.75111 6.75111 = cell-wise and global flow volume
  CPU time = 0.001495 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 17.3244 2.87625 3.94649 47.6923 28.1605 14.8495 0
  surf2grid time = 0.000713 secs
  map/comm1/comm2/comm3/comm4/split percent = 27.77 3.22581 34.3619 2.9453 5.8906 13.4642
surf_modify        surfID2 collide wallColModel


group            divertor_inner surf id ${surfId}
group            divertor_inner surf id 37
0 = initial surface count in group divertor_inner
1 = final surface count in group divertor_inner
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity ${vmag} incidentAngle ${angle}
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity 0.1 incidentAngle ${angle}
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity 0.1 incidentAngle 2.0

dump 10 particle all ${N1} case.outer.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.37.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.37.vmag.0.1.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.37.vmag.0.1.angle.2.0 id type x y z vx vy vz v_pmass temp radius

variable npart equal np

timestep ${dt}
timestep 1e-05
stats 1
stats_style step cpu np
run 1
