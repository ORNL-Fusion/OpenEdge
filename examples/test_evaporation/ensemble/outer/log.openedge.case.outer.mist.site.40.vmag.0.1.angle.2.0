surf_modify        surfID2 collide wallColModel


group            divertor_inner surf id ${surfId}
group            divertor_inner surf id 42
0 = initial surface count in group divertor_inner
1 = final surface count in group divertor_inner
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity ${vmag} incidentAngle ${angle}
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity 0.1 incidentAngle ${angle}
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity 0.1 incidentAngle 2.0

dump 10 particle all ${N1} case.outer.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.42.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.42.vmag.0.1.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.mist.site.42.vmag.0.1.angle.2.0 id type x y z vx vy vz v_pmass temp radius

variable npart equal np

timestep ${dt}
timestep 1e-05
stats 1
stats_style step cpu np
