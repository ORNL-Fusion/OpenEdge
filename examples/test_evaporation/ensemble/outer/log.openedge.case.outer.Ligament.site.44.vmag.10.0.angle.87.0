dump 10 particle all 2 case.outer.Ligament.site.46.vmag.10.0.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.Ligament.site.46.vmag.10.0.angle.87.0 id type x y z vx vy vz v_pmass temp radius

variable npart equal np

timestep ${dt}
timestep 1e-05
stats 1
stats_style step cpu np
