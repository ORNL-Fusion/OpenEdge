clear
Running on 1 MPI task(s)
next surfId
jump in.outer

# set parameters
variable dt   equal 1e-05
variable time equal 1
variable N equal  floor(${time}/${dt})
variable N equal  floor(1/${dt})
variable N equal  floor(1/1e-05)
variable N1 equal floor($N/40000)
variable N1 equal floor(99999/40000)


variable temp equal 773.15 # Kelvin
variable           droplet index mist Instability Ligament
variable surfId    index 37 38 39 40 42 44 46 48 50
variable vmag      index 0.1 1.0 10.0
variable angle     index 2.0 45. 87.0
variable md        index 2.796017461694916e-10 3.495021827118645e-05 2.236813969355933e-03  # mist instability ligament
variable Rho       equal 534.0
variable rd        equal (3.0*${md}/(4.0*PI*${Rho}))^(1.0/3.0)
variable rd        equal (3.0*2.236813969355933e-03/(4.0*PI*${Rho}))^(1.0/3.0)
variable rd        equal (3.0*2.236813969355933e-03/(4.0*PI*534))^(1.0/3.0)

seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
create_box          2. 6 -4. 3.8 -0.05 0.05
Created orthogonal box = (2 -4 -0.05) to (6 3.8 0.05)
create_grid         100 100 1
Created 10000 child grid cells
  CPU time = 0.000936 secs
  create/ghost percent = 51.8162 48.1838
balance_grid        rcb  cell
Balance grid migrated 0 cells
  CPU time = 0.000586 secs
  reassign/sort/migrate/ghost percent = 20.8191 1.53584 8.70307 68.942

############################################------species in the plasma (current and future)-------#####################################
species droplet.species ${droplet} Li Li+ Li2+ Li3+
species droplet.species Ligament Li Li+ Li2+ Li3+


mixture             LigamentSource  ${droplet}  frac 1.0 nrho 1
mixture             LigamentSource  Ligament  frac 1.0 nrho 1
variable            pmass  particle mass

read_surf          wall.surf group surfID particle check
