  6.75111 6.75111 = cell-wise and global flow volume
  CPU time = 0.001872 secs
  read/check/sort/surf2grid/ghost/inout/particle percent = 17.2009 2.13675 2.77778 54.9679 22.9167 11.9124 0
  surf2grid time = 0.001029 secs
  map/comm1/comm2/comm3/comm4/split percent = 23.6152 1.94363 24.2954 2.138 28.6686 8.94072
surf_modify        surfID2 collide wallColModel


group            divertor_inner surf id ${surfId}
group            divertor_inner surf id 44
0 = initial surface count in group divertor_inner
1 = final surface count in group divertor_inner
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity ${vmag} incidentAngle ${angle}
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity 10.0 incidentAngle ${angle}
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity 10.0 incidentAngle 87.0

dump 10 particle all ${N1} case.outer.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.Ligament.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.Ligament.site.44.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.Ligament.site.44.vmag.10.0.angle.${angle} id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 2 case.outer.Ligament.site.44.vmag.10.0.angle.87.0 id type x y z vx vy vz v_pmass temp radius

variable npart equal np

timestep ${dt}
timestep 1e-05
stats 1
stats_style step cpu np
run 1
