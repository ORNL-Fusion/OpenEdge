
# set parameters
variable dt   equal 1e-05
variable time equal 4
variable N equal  1 #floor(${time}/${dt})
variable N1 equal 1 #floor($N/1000)


variable temp equal 773.15 # Kelvin
variable           droplet index mist Instability Ligament
variable surfId    index 11 12 13 14 15 16 17
variable vmag      index 0.1 1.0 10.0
variable angle     index 2.0 45. 87.0
variable md        index 2.796017461694916e-10 3.495021827118645e-05 2.236813969355933e-03  # mist instability ligament
variable Rho       equal 534.0
variable rd        equal (3.0*${md}/(4.0*PI*${Rho}))^(1.0/3.0)

seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
create_box          2. 6 -4. 3.8 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb  cell

############################################------species in the plasma (current and future)-------#####################################
species droplet.species ${droplet} Li Li+ Li2+ Li3+


mixture             LigamentSource  ${droplet}  frac 1.0 nrho 1
variable            pmass  particle mass

read_surf          wall.surf group surfID particle check
surf_collide       wallColModel vanish
surf_modify        all collide wallColModel

read_surf          core.surf invert group surfID2 particle check
surf_modify        surfID2 collide wallColModel


group            divertor_inner surf id ${surfId}
fix              droplet_emission emit/droplet LigamentSource divertor_inner normal no n 1 perspecies no magVelocity ${vmag} incidentAngle ${angle}

dump 10 particle all ${N1} case.inner.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle} id type x y z vx vy vz v_pmass temp radius

timestep ${dt}
stats 1
stats_style step cpu np
run 1

unfix droplet_emission

fix 22 evaporation 1 LigamentSource mass ${md} radius ${rd} temp ${temp} heatflux/constant 50e6
compute cnear plasma/fields/file all ../plasma.h5 ../bfield.h5 bx by bz temp_e dens_e temp_i dens_i parrflow
fix BC viscous 1 2.0 1 plasma c_cnear[3] c_cnear[4] c_cnear[7] c_cnear[8] bfield c_cnear[1] c_cnear[2] c_cnear[3] gravity 0 0 -9.8

variable npart equal np
fix 31 halt ${N1} v_npart <= 0

timestep ${dt}
stats ${N1}
stats_style step cpu np

log log.openedge.case.inner.${droplet}.site.${surfId}.vmag.${vmag}.angle.${angle}

run $N


clear
next surfId
jump in.inner
clear
next vmag
next angle
next md
next droplet
jump in.inner
