# outer-group multi-droplet emission + tracking (thermal launch from global temp)

variable dt   equal 1e-05
variable time equal 100
variable N equal floor(${time}/${dt})
variable N1 equal floor($N/200000)

# droplet thermodynamic state (evaporation model)
variable temp_droplet    equal 773.15

# emission thermal temperature (controls initial thermal launch speed)
# NOTE: with md=3.495e-05 kg, reaching O(20 m/s) requires extremely large temp.
variable temp_emit equal .50e20

# one droplet class only
variable droplet index Instability

# requested droplet size proxy (same value used in species table as particle mass)
variable md      equal 3.495021827118645e-05
variable Rho     equal 534.0
variable rd      equal (3.0*${md}/(4.0*PI*${Rho}))^(1.0/3.0)

# emit a few particles at startup
variable nemit   equal 4

seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
global              temp ${temp_emit}
create_box          2. 6 -4. 3.8 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

species droplet.species ${droplet}
mixture             LigamentSource ${droplet} frac 1.0 nrho 1
variable            pmass particle mass

read_surf           wall.surf group surfID particle check
surf_collide        wallColModel vanish
surf_modify         all collide wallColModel

read_surf           core.surf invert group surfID2 particle check
surf_modify         surfID2 collide wallColModel

# divertor groups for regenerated wall.surf (switch emission target by changing fix line)
group            divertor_outer surf id <> 137 150
group               divertor_inner surf id <> 110 117

# no magVelocity/incidentAngle passed: thermal launch from global temp in fix_emit_droplet
fix                 droplet_emission_inner emit/droplet LigamentSource divertor_inner normal no n ${nemit} perspecies no
fix                 droplet_emission_outer emit/droplet LigamentSource divertor_outer normal no n ${nemit} perspecies no


#dump 10 particle all ${N1} case.outer id type x y z vx vy vz  v_pmass temp radius
dump 10 particle all 1  case.outer id type x y z vx vy vz  v_pmass temp radius

variable npart equal np

timestep            ${dt}
stats               1
stats_style         step cpu np
run                 1

unfix               droplet_emission_inner
unfix               droplet_emission_outer

fix 22 evaporation 1 LigamentSource mass ${md} radius ${rd} temp ${temp_droplet} heatflux/file ../input/heatflux.fix.h5
compute cnear plasma/fields all file ../input/plasma.h5 ../input/bfield.h5 bx by bz temp_e dens_e temp_i dens_i parrflow
fix BC viscous 1 2.0 1 plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] bfield c_cnear[1] c_cnear[3] c_cnear[2] gravity 0 -9.8 0

fix 31 halt ${N1} v_npart <= 0

timestep            ${dt}
stats               ${N1}
stats_style         step cpu np

run $N
