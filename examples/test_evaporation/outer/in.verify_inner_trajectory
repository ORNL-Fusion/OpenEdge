# Inner-divertor trajectory verification case
#
# Purpose:
# - Compare trajectory behavior across three physics modes using the same source particle(s).
# - Mode 1: kinematic baseline (no viscous, no evaporation).
# - Mode 2: viscous/plasma + gravity (no evaporation).
# - Mode 3: viscous/plasma + gravity + evaporation.
#
# Data layout:
# - Shared input files live in ../input/ (plasma.h5, bfield.h5, heatflux.fix.h5, core.surf, droplet.species).
# - This run directory keeps mode-specific run controls and outputs.

# Inner-divertor trajectory validation
# mode = 1: kinematic baseline (no viscous, no evaporation)
# mode = 2: forces only (viscous/plasma + gravity, no evaporation)
# mode = 3: full model (viscous/plasma + evaporation)

variable mode index 2 3

variable dt   equal 1e-06
variable time equal 1e-01 #5e-02
variable N    equal floor(${time}/${dt})

# write every step for short validation runs
variable Ndump equal 1

# droplet thermodynamic state
variable temp_droplet equal 773.15

# emission thermal temperature (sets initial thermal spread)
variable temp_emit equal .50e20

# species and initial droplet properties
variable droplet index Instability
variable md      equal  3.495021827118645e-10 #3.495021827118645e-09
variable Rho     equal 534.0
variable rd      equal (3.0*${md}/(4.0*PI*${Rho}))^(1.0/3.0)

# emit only from INNER group for this check
variable nemit   equal 4

seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
global              temp ${temp_emit}
create_box          2.0 6.0 -4.0 3.8 -0.05 0.05
create_grid         100 100 1
balance_grid        rcb cell

species             droplet.species ${droplet}
mixture             LigamentSource ${droplet} frac 1.0 nrho 1
variable            pmass particle mass

read_surf           wall.surf group surfID particle check
surf_collide        wallColModel specular
surf_modify         all collide wallColModel

read_surf           core.surf invert group surfID2 particle check
surf_modify         surfID2 collide wallColModel

# groups for regenerated wall.surf
group               divertor_outer surf id <> 137 150
group               divertor_inner surf id <> 110 117

# inner-only emission for trajectory verification
#fix                 droplet_emission_inner emit/droplet LigamentSource divertor_inner normal yes n ${nemit} perspecies no

read_particles source 1


# dump high cadence for short run
dump                dtraj particle all ${Ndump} case.inner.trajcheck.mode.${mode} id type x y z vx vy vz v_pmass temp radius


# mode 2 and 3: forces on
if "${mode} >= 2" then &
"compute cnear plasma/fields all file ../input/plasma.h5 ../input/bfield.h5 bx by bz temp_e dens_e temp_i dens_i parrflow"


if "${mode} >= 2" then &
"fix BC viscous 1 2.0 1   plasma c_cnear[4] c_cnear[6] c_cnear[7] c_cnear[8] bfield c_cnear[1] c_cnear[3] c_cnear[2] gravity 0 -9.8 0 mass ${md} radius ${rd} temp ${temp_droplet} diag yes diag/every 20000"

# mode 3: evaporation on
if "${mode} == 3" then &
 "fix fEvap evaporation 1 LigamentSource mass ${md} radius ${rd} temp ${temp_droplet} heatflux/file ../input/heatflux.fix.h5"

variable            npart equal np
#fix                 fhalt halt 10000 v_npart <= 0

# main validation run
timestep            ${dt}
stats               100
stats_style         step cpu np
run                 ${N}

clear
next mode
jump in.verify_inner_trajectory
