
seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
create_box          -500. 500 -500. 500.8 -0.05 0.05

create_grid         100 100 1
balance_grid        rcb  cell

############################################------species in the plasma (current and future)-------#####################################
species droplet.species drop_2


mixture             DropletSource  drop_2       frac 1.0 nrho 1
variable pmass  particle mass

#Load initial conditions
read_particles source.1 0

variable dt   equal 1e-05
variable time equal 2.5
variable N equal floor(${time}/${dt})
variable N1 equal floor($N/100)

variable min_dt equal 0.05
variable nevery equal 8.3 #${min_dt}/${dt}
variable temp equal 773.15 # Kelvin
variable rd equal 2.5e-3 # m
variable md equal 3.495021827118645e-05


# compute evap and emit if necessary
fix 22 evaporation 1 DropletSource mass ${md} radius ${rd} temp ${temp} heatflux/constant 0

# drag/gravity
variable te grid "10"
variable ni grid "1.5746e20"
variable ti grid "10"
variable vp grid "0"
variable Br grid "0"
variable Bt grid "0"
variable Bz grid "0"
fix fdrag drag 1 2.0 1 plasma te ti ni vp bfield Br Bt Bz gravity 0 -9.8 0 model epstein mass ${md} radius ${rd} temp ${temp}


# save data
dump 10 particle all ${N1} case.1 id type x y z vx vy vz v_pmass temp radius


timestep ${dt}
stats ${N1}
stats_style step cpu np

run $N
