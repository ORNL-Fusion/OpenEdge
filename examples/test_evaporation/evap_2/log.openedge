SPARTA-OPENEDGE (20 Jan 2025)
Running on 1 MPI task(s)

seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
create_box          -50. 50 -50. 50.8 -0.05 0.05
Created orthogonal box = (-50 -50 -0.05) to (50 50.8 0.05)

create_grid         100 100 1
Created 10000 child grid cells
  CPU time = 0.000871 secs
  create/ghost percent = 45.1206 54.8794
balance_grid        rcb  cell
Balance grid migrated 0 cells
  CPU time = 0.000587 secs
  reassign/sort/migrate/ghost percent = 21.4651 3.06644 10.2215 65.247

############################################------species in the plasma (current and future)-------#####################################
species droplet.species mist Li Li+ Li2+ Li3+


mixture             LigamentSource  mist        frac 1.0 nrho 1
variable pmass  particle mass

#Load initial conditions
read_particles source.1 0
Read 1 particles out of 1
  CPU time = 0.00038 secs

variable dt   equal 1e-05
variable time equal 2.
variable N equal floor(${time}/${dt})
variable N equal floor(2/${dt})
variable N equal floor(2/1e-05)
variable N1 equal floor($N/100)
variable N1 equal floor(199999/100)

variable min_dt equal 0.05
variable nevery equal 1.5 #${min_dt}/${dt}
variable temp equal 773.15 # Kelvin
variable rd equal 50e-6 # m
variable md equal 2.796017461694916e-10


# compute evap and emit if necessary
fix 22 evap 1 LigamentSource mass ${md} radius ${rd} temp ${temp} heatflux/constant 50e6
fix 22 evap 1 LigamentSource mass 2.79601746169492e-10 radius ${rd} temp ${temp} heatflux/constant 50e6
fix 22 evap 1 LigamentSource mass 2.79601746169492e-10 radius 5e-05 temp ${temp} heatflux/constant 50e6
fix 22 evap 1 LigamentSource mass 2.79601746169492e-10 radius 5e-05 temp 773.15 heatflux/constant 50e6

# viscous/gravity
variable te grid "10"
variable ni grid "1.5746e20"
variable ti grid "10"
variable vp grid "0"
variable Br grid "0"
variable Bt grid "0"
variable Bz grid "0"
fix BC viscous 1 2.0 1 plasma te ti ni vp bfield Br Bt Bz gravity 0 0 -9.8


# save data
dump 10 particle all ${N1} case.1 id type x y z vx vy vz v_pmass temp radius
dump 10 particle all 1999 case.1 id type x y z vx vy vz v_pmass temp radius


timestep ${dt}
timestep 1e-05
stats ${N1}
stats 1999
stats_style step cpu np

run $N
run 199999
