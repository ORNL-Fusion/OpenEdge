seed                12345
dimension           2
boundary            r r p
global              gridcut 0.0 comm/sort no
create_box          -2000. 2000 -2000. 2000.8 -0.05 0.05

create_grid         100 100 1
balance_grid        rcb  cell

############################################------species in the plasma (current and future)-------#####################################
species droplet.species drop_1

mixture             DropletSource  drop_1      frac 1.0 nrho 1
variable pmass  particle mass

# Load initial conditions
read_particles source.1 0

variable dt   equal 1e-05
variable time equal 3.5
variable N equal floor(${time}/${dt})
variable N1 equal 50

variable temp equal 773.15 # Kelvin
variable rd equal 1.5e-3 # m
variable md equal 7.549247146576273e-06

# compute evap and emit if necessary
fix 22 evaporation 1 DropletSource mass ${md} radius ${rd} temp ${temp} heatflux/constant 50e6

# viscous/gravity
variable te grid "10"
variable ni grid "1.5746e20"
variable ti grid "10"
variable vp grid "0"
variable Br grid "0"
variable Bt grid "0"
variable Bz grid "0"

# save data
dump 10 particle all ${N1} case.1 id type x y z vx vy vz v_pmass temp radius

timestep ${dt}
stats ${N1}
stats_style step cpu np

variable npart equal np
fix 31 halt 1 v_npart <= 0

run $N
