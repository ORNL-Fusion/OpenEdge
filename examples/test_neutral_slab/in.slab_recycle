################################################################################
# 1-D neutral slab — ionization + recycling at the wall at xhi=0.6.
#
# Same puff + plasma as in.slab_iz, but the xhi outflow is replaced by
# a reflecting surface (`surf_react surface/pwi` 100% reflection, Franck-
# Condon 3 eV, cosine angular). Profile shows the forward exp decay
# plus a reflected component piling up near the wall.
################################################################################

shell               mkdir output

seed                12345
dimension           2
boundary            o p p
global              gridcut 0.0 comm/sort no
global              fnum 1e11
timestep            5e-8

create_box          0.0 0.6 -0.01 0.01 -0.05 0.05
create_grid         600 1 1
balance_grid        rcb cell

species             input/neutral.species D D+
mixture             puff D frac 1.0 nrho 1e18 temp 350.0 &
                    vstream 1.695e4 0.0 0.0

# --- Reflecting wall at xhi ---
read_surf           input/slab.surf group wall particle check
surf_collide        wallColl diffuse 400.0 1.0
surf_react          wallPWI surface/pwi input/wall.exchange twall 400.0
surf_modify         wall collide wallColl react wallPWI

# --- Uniform plasma background via fix background (same as A1) ---
fix pd              background constant te 20.0 ne 1.0e19 ti 20.0
global              pusher plasma pd

# --- Mode A ionization (same as A1) ---
fix fchem volume/chem/adas 1 D input/neutral.reactions &
    mode neutral source_species D &
    units rate

# --- Puff from xlo face ---
fix fpuff emit/face puff xlo

# --- Diagnostics ---
fix pw particle/weight
compute cden grid/weighted all species nrho_w
fix    fden ave/grid all 1 2000 2000 c_cden[*] ave one
fix    frate ave/grid all 1 2000 2000 f_fchem[*] ave one

stats               500
stats_style         step cpu np nscoll nattempt ncoll
run                 1000

#dump d1 grid all 10000 output/slab_recycle.grid id xc yc &
#     f_fden[1] f_frate[1] f_frate[2] f_frate[3] f_frate[4]
#dump_modify d1 pad 6
#run                 0
