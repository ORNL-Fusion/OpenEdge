################################################################################
# 0-D D2 dissociation. Closed periodic box, no flow.
#
# 5000 D2 molecules at 350 K dissociate via electron impact (Janev H.2 2.2.5)
# in a hot Te = 15 eV background. <n_D2>(t) decays exponentially with
# tau_diss = 1/(n_e <sigma v>_diss); <n_D>(t) builds up to 2*n_D2(0) since
# each event spawns two atoms. Companion to the streaming slab in.slab_diss
# — the spatial decay there is the same physics played out vs distance.
################################################################################

shell               mkdir output

seed                12345
dimension           2
boundary            p p p
global              gridcut 0.0 comm/sort no
global              fnum 1e9
timestep            2e-8

create_box          0.0 0.01 0.0 0.01 -0.005 0.005
create_grid         1 1 1
balance_grid        rcb cell

species             input/neutral_diss.species D2 D D+

# Cold D2 reactant pool, no drift.
mixture             cold D2 frac 1.0 nrho 5e18 temp 350.0
create_particles    cold n 5000

# Hot electrons drive the Janev dissociation rate.
fix pd              background constant te 15.0 ne 1.0e19 ti 15.0
global              pusher plasma pd

# Reactions file lists only D2 -> D+D, but channel toggles are explicit
# so future edits to the reactions file can't sneak in new physics.
fix fchem volume/chem/adas 1 D input/neutral_diss.reactions &
    ionization no recombination no cx no &
    units rate

# Domain-averaged species densities for the time-domain plot.
# c_cden[1] = n_D2, c_cden[2] = n_D, c_cden[3] = n_D+ (mixture `species`).
fix pw              particle/weight
compute cden        grid/weighted all species nrho_w
compute Nd2         reduce ave c_cden[1]
compute Nd          reduce ave c_cden[2]

stats               100
stats_style         step cpu np c_Nd2 c_Nd
run                 30000
