################################################################################
# 1-D neutral slab — ionization channel only (Mode A: delete on ionization).
#
# Monoenergetic 3 eV D beam injected at x=0 into a uniform ionizing
# plasma (Te = 20 eV, ne = 1e19 m^-3). Expected: n_D(x) decays exponen-
# tially with λ_iz ≈ 128 mm.
#
# Geometry: 2-D slab, 0 <= x <= 0.6 m, |y| <= 0.01 m, thin z. x-outflow,
# y-periodic.
################################################################################

shell               mkdir output

seed                12345
dimension           2
boundary            o p p
global              gridcut 0.0 comm/sort no
global              fnum 1e11
timestep            5e-8

create_box          0.0 0.6 -0.01 0.01 -0.05 0.05
create_grid         600 1 1
balance_grid        rcb cell

# --- Species: D (neutral) and D+ (declared, never created in Mode A) ---
species             input/neutral.species D D+
mixture             puff D frac 1.0 nrho 1e18 temp 350.0 &
                    vstream 1.695e4 0.0 0.0

# --- Uniform plasma background via fix background ---
# Te/ne/Ti land in the per-particle pcache populated by update.cpp.
fix pd              background constant te 20.0 ne 1.0e19 ti 20.0
global              pusher plasma pd

# --- Ionization chemistry, Mode A (delete on ionization) ---
# units rate: per-step SI source rates [m^-3 s^-1], zeroed each Nevery.
fix fchem volume/chem/adas 1 D input/neutral.reactions &
    mode neutral source_species D &
    units rate

# --- Puff: inject monoenergetic D from the xlo face ---
fix fpuff emit/face puff xlo

# --- Diagnostics ---
# Per-species number density (column 1 = n_D). nrho_w + particle/weight
# reduces to plain nrho here (constant-weight emission) but keeps the
# API consistent with variable-weight decks.
fix pw particle/weight
compute cden grid/weighted all all nrho_w
fix    fden ave/grid all 1 2000 2000 c_cden[*] ave one

# Ionization source rate (fchem col 1 = count/rate).
fix    frate ave/grid all 1 2000 2000 f_fchem[*] ave one

stats               500
stats_style         step cpu np nscoll nattempt ncoll
run                 10000

# --- Dump steady-state snapshot at end of run ---
# cols: id xc yc n_D[m^-3] (+19 other chem cols, keep col 4 for n_D)
dump d1 grid all 10000 output/slab_iz.grid id xc yc &
     f_fden[1] f_frate[1] f_frate[2] f_frate[3] f_frate[4]
dump_modify d1 pad 6
run                 0
