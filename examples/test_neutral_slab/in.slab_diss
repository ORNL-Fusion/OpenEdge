################################################################################
# 1-D neutral slab — D2 dissociation only (Janev/HYDHEL H.2 2.2.5).
#
# Monoenergetic 3 eV D2 beam into a uniform plasma (Te = 15 eV,
# ne = 1e19 m^-3). No ionization, no CX. Expected: n_D2(x) decays
# exponentially with λ_diss ≈ 122 mm, and the per-cell dissociation
# source rate tracks ν_diss · n_D2(x).
################################################################################

shell               mkdir output

seed                12345
dimension           2
boundary            o p p
global              gridcut 0.0 comm/sort no
global              fnum 1e11
timestep            5e-8

create_box          0.0 0.6 -0.01 0.01 -0.05 0.05
create_grid         600 1 1
balance_grid        rcb cell

species             input/neutral_diss.species D2 D D+
# Puff: D2 monoenergetic at 3 eV. v_D2 = sqrt(2*3eV/m_D2) = 1.2e4 m/s.
mixture             puff D2 frac 1.0 nrho 1e18 temp 350.0 &
                    vstream 1.2e4 0.0 0.0

# --- Uniform plasma background via fix background ---
# Dissociation rate depends on Te and ne (via nu = ne * <sv>_diss).
# Janev polynomial uses Te; ne multiplied into lambda at runtime.
fix pd              background constant te 15.0 ne 1.0e19 ti 15.0
global              pusher plasma pd

# --- Dissociation only (fix volume/chem/adas) ---
fix fchem volume/chem/adas 1 D input/neutral_diss.reactions &
    mode neutral source_species D2 &
    units rate

fix fpuff emit/face puff xlo

# --- Diagnostics: per-species density + dissociation source rate ---
fix pw particle/weight
compute cden grid/weighted all species nrho_w
fix    fden ave/grid all 1 2000 2000 c_cden[*] ave one
fix    frate ave/grid all 1 2000 2000 f_fchem[*] ave one

stats               500
stats_style         step cpu np nscoll nattempt ncoll
run                 1000

# Dump: id xc yc n_D2 n_D n_D+ Qe (electron energy loss density [W/m^3])
# `output summary` gives 6 plasma-frame moments {Sp, Sm_x, Sm_y, Sm_z, Qe, Qi}.
# Dissociation is plasma-conservative (no Sp, Sm; Qi=0); only Qe is non-zero
# (4.478 eV bond energy per D2 -> 2D event).
#dump d1 grid all 20000 output/slab_diss.grid id xc yc &
#     f_fden[1] f_fden[2] f_fden[3] f_frate[5]
#dump_modify d1 pad 6
#run                 0
