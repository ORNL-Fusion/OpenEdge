################################################################################
# 1-D neutral slab — CX thermalization (with competing ionization).
#
# Monoenergetic 3 eV D beam enters a plasma with Te = 5 eV (ionization)
# and Ti = 50 eV (CX partner temperature). Each CX event resamples the
# neutral's velocity from a Maxwellian at Ti, so T_D(x) climbs from ~3 eV
# at the source toward Ti further in, while ionization provides a finite
# depletion length.
################################################################################

shell               mkdir output

seed                12345
dimension           2
boundary            o p p
global              gridcut 0.0 comm/sort no
global              fnum 1e11
timestep            2e-8

create_box          0.0 0.6 -0.01 0.01 -0.05 0.05
create_grid         600 1 1
balance_grid        rcb cell

species             input/neutral.species D D+
mixture             puff D frac 1.0 nrho 1e18 temp 350.0 &
                    vstream 1.695e4 0.0 0.0

# --- Uniform plasma background via fix plasma/data (populates pcache Ti) ---
# Need Ti in the per-particle plasma cache so fix volume/chem/adas CX resampler
# can draw product velocities from a Maxwellian at local Ti.
fix pd plasma/data file input/plasma_cx.h5 static yes
global              pusher plasma pd

# --- Ionization + CX, Mode A (ionization deletes; CX resamples v) ---
# No `plasma` keyword -> Te/ne/Ti pulled from the per-particle pcache.
fix fchem volume/chem/adas 1 D input/neutral_cx.reactions &
    mode neutral source_species D &
    units rate

# --- Puff from xlo face ---
fix fpuff emit/face puff xlo

# --- Diagnostics: per-species n and T on the 1D grid ---
# grid/weighted handles nrho_w (weight-aware density); grid handles temp
# (no weighted variant yet). Combined into one ave/grid so the column
# layout matches the old c_cmom: cols 1..Nsp = nrho_w, Nsp+1..2Nsp = temp.
fix pw particle/weight
compute cden  grid/weighted all all nrho_w
compute ctemp grid          all species temp
fix    fmom ave/grid all 1 4000 4000 c_cden[*] c_ctemp[*] ave one
fix    frate ave/grid all 1 4000 4000 f_fchem[*] ave one

stats               500
stats_style         step cpu np nscoll nattempt ncoll
run                 20000

# Dump: id xc yc n_D T_D ion-source-rate CX-source-rate
dump d1 grid all 20000 output/slab_cx.grid id xc yc &
     f_fmom[1] f_fmom[2] f_frate[1] f_frate[3]
dump_modify d1 pad 6
run                 0
