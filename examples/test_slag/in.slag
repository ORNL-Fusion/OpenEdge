# Slag test: boronized WEST PFU, 3D toroidal wedge (0.79 deg), background-
# driven erosion + conc-scaled emission. Plate is the only physical surface;
# source/ends/caps close the duct (watertight) and handle sink/periodicity.
# Geometry details: input/make_geometry.py.

seed                7893
dimension           3
global              gridcut 0.0 comm/sort no
boundary            o o o

create_box          1.90 2.52 -0.004 0.038 -0.80 -0.32
create_grid         60 6 50
balance_grid        rcb cell

global              fnum 5e9
species             input/slag.species W W+ W2+ W3+ B B+ B2+ B3+ B4+ B5+

mixture             wSource W frac 1.0
mixture             wSource W+ frac 0.
mixture             wSource W2+ frac 0.
mixture             wSource W3+ frac 0.
mixture             bSource B frac 1.0

read_surf           input/slag_wedge.surf group duct particle check
group               plate surf id 1:3360
group               source surf id 3361:6720
group               ends surf id 6721:6744
group               caps surf id 6745:7864

surf_collide        pcoll diffuse 300.0 1.0
surf_react          pwi surface/pwi input/slag_w.recycle twall 773.15 &
                    adens_surf adens adens_init B 4e14 rzone 1e14 &
                    adens_erosion cpmi 0 W adens_erosion cpmiB 0 B
surf_modify         plate collide pcoll react pwi

surf_collide        svanish vanish
surf_modify         source collide svanish
surf_modify         ends collide svanish

surf_collide        PERIODIC toroidal 0.79
surf_modify         caps collide PERIODIC

fix                 pd background file input/plasma_58245.h5 static yes

# W source: gross erosion of the plate by background D ions (sheath energy),
# emitted as neutral W with Thompson energies, weighted by local flux
compute             cpmi surface/physical/sputter plate background pd &
                    target W projectiles D,O &
                    mass_amu 2.01410177811 static yes erosion_flux
compute             cpmiB surface/physical/sputter plate background pd &
                    target B projectiles D,O &
                    mass_amu 2.01410177811 static yes erosion_flux
fix                 pw particle/weight
fix                 femit surface/emit/source wSource plate cpmi perspecies no &
                    nlaunch_total 10 model thompson 4.34 nevery 50 &
                    conc_scale adens_conc 1
fix                 femitB surface/emit/source bSource plate cpmiB perspecies no &
                    nlaunch_total 10 model thompson 5.73 nevery 50 &
                    conc_scale adens_conc 5

# W ionization/recombination in the background plasma (ADAS rates)
fix                 fchem volume/chem/adas 1 W auto
fix                 fchemB volume/chem/adas 1 B auto

include             in.forces

timestep            1e-9
stats               200
stats_style         step cpu np nscoll nsreact

# run 0 so surf_react init() creates the "adens" custom attribute,
# then the dump can reference s_adens columns
run                 0 post no

dump                dsig surf plate 50000 output/slag_adens.*.dump &
                    id s_adens[1] s_adens[2] s_adens[3] s_adens[4] s_adens[5] s_adens[6] s_adens[7] s_adens[8] s_adens[9] s_adens[10] c_cpmi c_cpmiB s_adens_conc[1] s_adens_conc[5]

# native VTK output: particles as points, grid cells as voxels, surfs as tris
#dump                dpvtk particle/vtk all 5000 output/slag.particle.*.vtu id type x y z
#dump                dgvtk grid/vtk all 5000 output/slag.grid.*.vtu id proc vol
dump                dsvtk surf/vtk plate 50000 output/slag.surf.*.vtu id s_adens_net s_adens_dep s_adens_ero s_adens_conc[1] s_adens_conc[5] c_cpmi c_cpmiB

#dump 10 particle all 1000 output/state id type x y z #vx vy vz

run                 200000
